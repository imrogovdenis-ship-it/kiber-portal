---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/blocks/HomeHero.astro';
import RobotCard from '../components/blocks/RobotCard.astro';
import CtaStrip from '../components/blocks/CtaStrip.astro';
import InternalLinks from '../components/content/InternalLinks.astro';
import { organizationJsonLd, websiteJsonLd } from '../lib/seo';
import { getRobotPages } from '../lib/robot-pages';
import type { RobotCardData } from '../../design-system/schemas/fixture.schema';

const featuredSlugs = ['arenda-unitree-g1', 'arenda-agibot-x2', 'arenda-xiaomi-cyberdog-2', 'arenda-bellabot'];
const categoryLabels: Record<string, string> = {
  humanoid: 'Робот-гуманоид',
  robot_dog: 'Робот-собака',
  service_robot: 'Робот-официант',
  media_robot: 'Робот для съёмки',
  coffee_robot: 'Робо-кофейня',
};

function getFeaturedHomeRobots(limit: number) {
  const robots = getRobotPages();
  const bySlug = new Map(robots.map((robot) => [robot.slug, robot]));

  return featuredSlugs
    .map((slug, index) => {
      const robot = bySlug.get(slug);
      if (!robot) return null;
      return {
        slug: robot.slug,
        href: robot.route,
        title: robot.identity.name,
        category: categoryLabels[robot.category] ?? 'Робот для мероприятий',
        price: robot.pricing.display,
        price_disclaimer: robot.pricing.disclaimer as RobotCardData['price_disclaimer'],
        description: robot.seo.description.slice(0, 132),
        badge: index === 0 ? 'Популярный выбор' : undefined,
        image: robot.media.hero,
        analytics: { event: 'robot_card_click' as const, placement: 'catalog' as const, position: index + 1 },
      };
    })
    .filter((robot): robot is NonNullable<typeof robot> => Boolean(robot))
    .slice(0, limit);
}

const homeRobots = getFeaturedHomeRobots(4);

const hero = {
  eyebrow: 'Роботы для мероприятий',
  title: 'Аренда роботов, которые держат внимание',
  lead: 'Выберите робота под событие: мы поможем согласовать сценарий, площадку, тайминг и безопасный следующий шаг.',
  primary: { href: '/#catalog', label: 'Смотреть каталог' },
  secondary: { href: '/lead/request/?robot=arenda-unitree-g1', label: 'Оставить заявку' },
  image: { src: '/images/home/home-header-robot-owner-20260830.webp', alt: 'Гуманоидный робот на тёмном фоне для мероприятий', position: '72% center' },
  stats: [],
  analytics: { event: 'contact_click' as const, block_id: 'home-hero' },
};

const cta = {
  title: 'Готовы проверить сценарий с роботом?',
  text: 'Выберите модель или напишите нам — подберём формат выхода, тайминг и площадку под ваше мероприятие.',
  primary: { href: '/lead/request/?robot=arenda-unitree-g1', label: 'Заполнить форму' },
  secondary: { href: '/contacts', label: 'Написать нам' },
  analytics: { event: 'contact_click' as const, block_id: 'vertical-slice-cta' },
};
---

<BaseLayout
  title="Аренда роботов для мероприятий — КИБЕР ПОРТАЛ"
  description="КИБЕР ПОРТАЛ: аренда роботов для мероприятий, карточки моделей, подбор сценария и заявка на обратный звонок."
  canonical="https://www.kiber-portal.ru/"
  jsonLd={[organizationJsonLd(), websiteJsonLd()]}
>
  <main class="vertical-slice container" id="main-content" tabindex="-1" data-kiber-task="KIBER-33">
    <HomeHero {...hero} />

    <section id="catalog" class="vertical-slice__section" aria-labelledby="pilot-robot-title" data-vertical-step="home-to-robot" data-primary-route="/robots/arenda-unitree-g1/">
      <div class="vertical-slice__section-copy">
        <p>Каталог роботов</p>
        <h2 id="pilot-robot-title">Популярные модели для мероприятий</h2>
        <p>Карточка полностью кликабельна: фото, название и описание ведут на страницу робота.</p>
      </div>
      <div class="vertical-slice__card-grid">
        {homeRobots.map((robot) => <RobotCard {...robot} hideDisclaimer={true} hideLink={true} imageLoading="eager" />)}
      </div>
    </section>

    <CtaStrip {...cta} />
    <InternalLinks route="/" label="Популярные направления" />
  </main>
</BaseLayout>

<style>
  .vertical-slice { display: grid; gap: clamp(2rem, 4vw, 3.5rem); padding-block: clamp(1.5rem, 3vw, 3rem); }
  .vertical-slice__section { display: grid; gap: clamp(1.25rem, 2.5vw, 2rem); }
  .vertical-slice__section-copy { display: grid; gap: var(--kp-card-gap); max-width: 48rem; }
  .vertical-slice__section-copy p, .vertical-slice__section-copy h2 { margin: 0; }
  .vertical-slice__section-copy > p:first-child { color: var(--kp-blue); font-weight: var(--kp-label-weight); letter-spacing: var(--kp-label-letter-spacing); text-transform: uppercase; }
  .vertical-slice__section-copy h2 { font-family: var(--kp-font-heading); font-size: var(--kp-heading-size); line-height: var(--kp-heading-line-height); }
  .vertical-slice__section-copy p:last-child { color: var(--kp-muted); line-height: var(--kp-body-line-height); }
  .vertical-slice__card-grid { display: grid; gap: clamp(1rem, 1.8vw, 1.5rem); width: 100%; }
  @media (min-width: 60rem) {
    .vertical-slice__card-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (min-width: 40rem) and (max-width: 59.9375rem) {
    .vertical-slice__card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
