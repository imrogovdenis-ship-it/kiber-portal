---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/blocks/HomeHero.astro';
import RobotCard from '../components/blocks/RobotCard.astro';
import CtaStrip from '../components/blocks/CtaStrip.astro';
import InternalLinks from '../components/content/InternalLinks.astro';
import { organizationJsonLd, websiteJsonLd } from '../lib/seo';

const hero = {
  eyebrow: 'Роботы для мероприятий',
  title: 'Аренда роботов, которые держат внимание',
  lead: 'Выберите робота под событие: мы поможем согласовать сценарий, площадку, тайминг и безопасный следующий шаг.',
  primary: { href: '/robots/arenda-unitree-g1/', label: 'Смотреть Unitree G1' },
  secondary: { href: '/lead/request/?robot=arenda-unitree-g1', label: 'Оставить заявку' },
  image: { src: '/images/kiber-45/arenda-unitree-g1.webp', alt: 'Робот-гуманоид Unitree G1 для мероприятия', position: 'center top' },
  stats: [
    { value: '24', label: 'робота в каталоге' },
    { value: '0', label: 'скрытых условий в заявке' },
  ],
  analytics: { event: 'contact_click', block_id: 'home-hero' },
};

const robot = {
  slug: 'arenda-unitree-g1',
  href: '/robots/arenda-unitree-g1/',
  title: 'Unitree G1',
  category: 'Робот-гуманоид',
  price: 'от 150 000 ₽',
  price_disclaimer: 'Не является публичной офертой',
  description: 'Карточка робота для мероприятий: условия аренды, сценарии, ориентир стоимости и переход к заявке.',
  badge: 'Популярный выбор',
  image: null,
  analytics: { event: 'robot_card_click', placement: 'catalog', position: 1 },
} as const;

const cta = {
  title: 'Готовы проверить сценарий с роботом?',
  text: 'Выберите робота, заполните короткий бриф и получите понятное подтверждение следующего шага.',
  primary: { href: '/lead/request/?robot=arenda-unitree-g1', label: 'Перейти к заявке' },
  secondary: { href: '/contacts', label: 'Связаться' },
  analytics: { event: 'contact_click', block_id: 'vertical-slice-cta' },
};
---

<BaseLayout
  title="Аренда роботов для мероприятий — КИБЕР ПОРТАЛ"
  description="КИБЕР ПОРТАЛ: аренда роботов для мероприятий, карточки моделей, подбор сценария и заявка на обратный звонок."
  canonical="https://www.kiber-portal.ru/"
  jsonLd={[organizationJsonLd(), websiteJsonLd()]}
>
  <main class="vertical-slice container" id="main-content" tabindex="-1" data-kiber-task="KIBER-33">
    <HomeHero {...hero} />

    <section id="catalog" class="vertical-slice__section" aria-labelledby="pilot-robot-title" data-vertical-step="home-to-robot">
      <div class="vertical-slice__section-copy">
        <p>Популярная модель</p>
        <h2 id="pilot-robot-title">Начинаем с Unitree G1</h2>
        <p>Карточка показывает формат аренды, ориентир стоимости, сценарии применения и переход к заявке.</p>
      </div>
      <div class="vertical-slice__card-grid">
        <RobotCard {...robot} />
      </div>
    </section>

    <CtaStrip {...cta} />
  <InternalLinks route="/" label="Популярные направления" />
  </main>
</BaseLayout>

<style>
  .vertical-slice { display: grid; gap: var(--kp-section-block); padding-block: var(--kp-section-block); }
  .vertical-slice__section { display: grid; gap: var(--kp-grid-gap); }
  .vertical-slice__section-copy { display: grid; gap: var(--kp-card-gap); max-width: 42rem; }
  .vertical-slice__section-copy p, .vertical-slice__section-copy h2 { margin: 0; }
  .vertical-slice__section-copy > p:first-child { color: var(--kp-blue); font-weight: var(--kp-label-weight); letter-spacing: var(--kp-label-letter-spacing); text-transform: uppercase; }
  .vertical-slice__section-copy h2 { font-family: var(--kp-font-heading); font-size: var(--kp-heading-size); line-height: var(--kp-heading-line-height); }
  .vertical-slice__section-copy p:last-child { color: var(--kp-muted); line-height: var(--kp-body-line-height); }
  .vertical-slice__card-grid { display: grid; max-width: 24rem; }
</style>
