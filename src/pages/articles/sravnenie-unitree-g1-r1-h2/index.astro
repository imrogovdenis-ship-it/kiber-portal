---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleBlocksTemplate from '../../../components/templates/ApprovedArticle6.astro';
import { type ArticleRobotCard } from '../../../lib/approved-article-6-types';
import { buildUnitreeG1R1H2Article } from '../../../lib/kiber94-article-unitree-g1-r1-h2-data';
import { blogPostingJsonLd, breadcrumbJsonLd, faqPageJsonLd } from '../../../lib/seo';
import { getRobotPageBySlug } from '../../../lib/robot-pages';

const slugs = ['arenda-unitree-r1', 'arenda-unitree-g1', 'arenda-unitree-h2'];
const otherSlugs = ['arenda-noetix-bumi', 'arenda-agibot-x2', 'arenda-robota-ardi', 'arenda-robota-sofiya'];
const galleryImageBySlug: Record<string, { src: string; alt: string }> = {
  'arenda-unitree-r1': {
    src: '/images/kiber-94-preview/batch1-humanoids/arenda-unitree-r1__tild6432-3865-4237-b665-626633613332__07.webp',
    alt: 'Робот-гуманоид Unitree R1 идёт по выставке перед группой посетителей',
  },
  'arenda-unitree-g1': {
    src: '/images/kiber-94-preview/batch2-robot-cards/arenda-unitree-g1__tild6333-3137-4465-b265-323436646539__06.webp',
    alt: 'Робот-гуманоид Unitree G1 пожимает руку посетителю на выставочном стенде НИЖФАРМ',
  },
  'arenda-unitree-h2': {
    src: '/images/kiber-94-preview/batch1-humanoids/arenda-unitree-h2__tild3338-3033-4761-b961-663635646131__06.webp',
    alt: 'Робот-гуманоид Unitree H2 представлен зрителям на выставочной площадке',
  },
};
const robotCards: ArticleRobotCard[] = [...slugs, ...otherSlugs]
  .map((slug) => getRobotPageBySlug(slug))
  .filter((robot): robot is NonNullable<typeof robot> => Boolean(robot))
  .map((robot, index) => ({
    slug: robot.slug,
    href: robot.route,
    title: robot.identity.name,
    category: 'Робот-гуманоид',
    price: robot.pricing.display,
    price_disclaimer: 'Не является публичной офертой',
    description: robot.seo.description,
    image: robot.media.hero,
    galleryImage: galleryImageBySlug[robot.slug] ?? robot.media.hero,
    analytics: { event: 'robot_card_click', placement: 'article', position: index + 1 },
  }));
const template = buildUnitreeG1R1H2Article(robotCards.filter((r) => slugs.includes(r.slug)), robotCards.filter((r) => otherSlugs.includes(r.slug)));
const heroImage = '/images/kiber-articles/unitree-g1-r1-h2-comparison-hero.webp';
---

<BaseLayout
  title={template.seo.title}
  description={template.seo.description}
  canonical={`https://www.kiber-portal.ru${template.seo.canonical}`}
  noindex={false}
  breadcrumbs={template.breadcrumbs}
  jsonLd={[
    blogPostingJsonLd({ title: template.seo.title, description: template.seo.description, url: template.seo.canonical, image: heroImage }),
    breadcrumbJsonLd(template.breadcrumbs),
    faqPageJsonLd({ items: template.faq.items }),
  ]}
>
  <main id="main-content" tabindex="-1">
    <ArticleBlocksTemplate {template} />
  </main>
</BaseLayout>
