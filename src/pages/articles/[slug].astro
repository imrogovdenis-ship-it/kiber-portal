---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleBlocksTemplate from '../../components/templates/ArticleBlocksTemplate.astro';
import { buildLaunchArticleTemplate, launchArticleSlugs } from '../../lib/kiber94-launch-articles-data';
import { type ArticleRobotCard } from '../../lib/kiber94-article-template-data';
import { breadcrumbJsonLd, collectionPageJsonLd, faqPageJsonLd } from '../../lib/seo';
import { getRobotPages } from '../../lib/robot-pages';

export function getStaticPaths() {
  return launchArticleSlugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const robotCards: ArticleRobotCard[] = getRobotPages().map((robot, index) => ({
  slug: robot.slug,
  href: robot.route,
  title: robot.identity.name,
  category: robot.category === 'humanoid' ? 'Робот-гуманоид' : 'Робот для мероприятия',
  price: robot.pricing.display,
  price_disclaimer: 'Не является публичной офертой',
  description: robot.seo.description,
  badge: index === 0 ? 'Каталог' : undefined,
  image: robot.media.hero,
  analytics: { event: 'robot_card_click', placement: 'article', position: index + 1 },
}));

const template = buildLaunchArticleTemplate(slug!, robotCards);
---

<BaseLayout
  title={template.seo.title}
  description={template.seo.description}
  canonical={`https://www.kiber-portal.ru${template.seo.canonical}`}
  noindex={false}
  breadcrumbs={template.breadcrumbs}
  image={template.hero.image.src}
  jsonLd={[
    collectionPageJsonLd({ title: template.seo.title, description: template.seo.description, url: template.seo.canonical }),
    breadcrumbJsonLd(template.breadcrumbs),
    faqPageJsonLd({ items: template.faq.items }),
  ]}
>
  <main id="main-content" tabindex="-1">
    <script type="application/json" data-block-id="seoIntent" data-ai-agent-readable="true" set:html={JSON.stringify({
      pageType: 'article_detail',
      pageIntent: 'informational_humanoid_robot_rental_support',
      primaryKeyword: template.seo.primaryKeyword,
      secondaryKeywords: template.seo.secondaryKeywords,
      relatedCompilation: '/roboty-gumanoidy/',
    })} />
    <ArticleBlocksTemplate {template} />
  </main>
</BaseLayout>
