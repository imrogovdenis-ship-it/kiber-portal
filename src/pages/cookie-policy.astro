---
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
  { href: '/', label: 'На главную' },
  { href: '/robots/arenda-unitree-g1/', label: 'Unitree G1' },
  { href: '/lead/request/?robot=arenda-unitree-g1', label: 'Перейти к заявке' },
];
---

<BaseLayout title='Политика cookie — КИБЕР ПОРТАЛ' description='Черновая страница политики cookie до юридического утверждения.' noindex={true}>
  <main class="content-page container" id="main-content" tabindex="-1" data-kiber-task="KIBER-20">
    <section class="content-page__hero" aria-labelledby="page-title">
      <p>КИБЕР ПОРТАЛ</p>
      <h1 id="page-title">Политика cookie</h1>
      <p>Юридически финальная cookie policy требует отдельного утверждения. До этого страница фиксирует маршрут и не подключает аналитику или новые cookie-провайдеры.</p>
    </section>
    <nav class="content-page__links" aria-label="Следующие шаги">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </main>
</BaseLayout>

<style>
  .content-page { display: grid; gap: var(--kp-section-block); padding-block: var(--kp-section-block); }
  .content-page__hero { display: grid; gap: var(--kp-card-gap); max-width: 48rem; }
  .content-page__hero p, .content-page__hero h1 { margin: 0; }
  .content-page__hero > p:first-child { color: var(--kp-blue); font-weight: var(--kp-label-weight); letter-spacing: var(--kp-label-letter-spacing); text-transform: uppercase; }
  .content-page__hero h1 { font-family: var(--kp-font-heading); font-size: var(--kp-display-size); line-height: var(--kp-display-line-height); }
  .content-page__hero > p:last-child { color: var(--kp-muted); line-height: var(--kp-body-line-height); }
  .content-page__links { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .content-page__links a { display: inline-flex; min-height: 2.75rem; align-items: center; border: 0.0625rem solid var(--kp-line); border-radius: 62.4375rem; padding: 0.75rem 1.1rem; color: var(--kp-blue); font-weight: var(--kp-heading-weight); text-decoration: none; }
</style>
