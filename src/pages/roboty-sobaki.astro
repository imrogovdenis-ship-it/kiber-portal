---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbJsonLd, collectionPageJsonLd, faqPageJsonLd } from '../lib/seo';
import CompilationTemplate from '../components/templates/CompilationTemplate.astro';
import { getRobotDogsPreviewCompilation } from '../lib/robot-dogs-preview-adapter';

const isRobotDogsPreview = import.meta.env.DEPLOY_ENV === 'preview';
const previewTemplate = getRobotDogsPreviewCompilation();
---

<BaseLayout
  title={previewTemplate.seo.title}
  description={previewTemplate.seo.description}
  canonical={`https://www.kiber-portal.ru${previewTemplate.seo.canonical}`}
  noindex={isRobotDogsPreview}
  breadcrumbs={previewTemplate.breadcrumbs}
  jsonLd={[
    collectionPageJsonLd({ title: previewTemplate.seo.title, description: previewTemplate.seo.description, url: previewTemplate.seo.canonical }),
    breadcrumbJsonLd(previewTemplate.breadcrumbs),
    faqPageJsonLd({ items: previewTemplate.faq.items }),
    { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: previewTemplate.catalog.robots.map((r, i) => ({ '@type': 'ListItem', position: i + 1, name: r.title, url: `https://www.kiber-portal.ru${r.href}` })) },
  ]}
>
  <main id="main-content" tabindex="-1" data-kiber-task="robot-dogs-preview" data-preview-only={isRobotDogsPreview ? 'true' : undefined}>
    <CompilationTemplate template={previewTemplate} />
  </main>
</BaseLayout>

<!-- Natural-ratio photos: scoped to this preview gallery, never scenario cards. -->
<style is:global>
  #main-content[data-kiber-task="robot-dogs-preview"] .humanoid-template__gallery-item {
    flex: 0 0 auto;
    width: fit-content;
    height: min(var(--humanoid-gallery-height), 85vw);
    aspect-ratio: auto;
    background: transparent;
  }
  #main-content[data-kiber-task="robot-dogs-preview"] .humanoid-template__gallery-item img {
    width: auto;
    height: 100%;
    max-width: none;
    object-fit: contain;
  }
</style>
