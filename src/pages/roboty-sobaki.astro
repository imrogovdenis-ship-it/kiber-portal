---
import BaseLayout from '../layouts/BaseLayout.astro';
import InternalLinks from '../components/content/InternalLinks.astro';
import { collectionPageJsonLd } from '../lib/seo';

---

<BaseLayout title='Роботы-собаки в аренду — КИБЕР ПОРТАЛ' description='Подборка роботов-собак для мероприятий, промоакций, технологичных демонстраций и интерактивных проходов по площадке.' noindex={false} jsonLd={collectionPageJsonLd({ title: 'Роботы-собаки в аренду — КИБЕР ПОРТАЛ', description: 'Подборка роботов-собак для мероприятий.', url: '/roboty-sobaki/' })}>
  <main class="content-page container" id="main-content" tabindex="-1" data-kiber-task="KIBER-20">
    <section class="content-page__hero" aria-labelledby="page-title">
      <p>КИБЕР ПОРТАЛ</p>
      <h1 id="page-title">Роботы-собаки</h1>
      <p>Роботы-собаки подходят для промо, демонстраций технологий, проходов по площадке и интерактивного контента.</p>
    </section>
    <InternalLinks route="/roboty-sobaki/" label="Следующие шаги" />
  </main>
</BaseLayout>

<style>
  .content-page { display: grid; gap: var(--kp-section-block); padding-block: var(--kp-section-block); }
  .content-page__hero { display: grid; gap: var(--kp-card-gap); max-width: 48rem; }
  .content-page__hero p, .content-page__hero h1 { margin: 0; }
  .content-page__hero > p:first-child { color: var(--kp-blue); font-weight: var(--kp-label-weight); letter-spacing: var(--kp-label-letter-spacing); text-transform: uppercase; }
  .content-page__hero h1 { font-family: var(--kp-font-heading); font-size: var(--kp-display-size); line-height: var(--kp-display-line-height); }
  .content-page__hero > p:last-child { color: var(--kp-muted); line-height: var(--kp-body-line-height); }
</style>
