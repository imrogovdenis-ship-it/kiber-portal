---
import BaseLayout from '../layouts/BaseLayout.astro';
import RobotCard from '../components/blocks/RobotCard.astro';
import InternalLinks from '../components/content/InternalLinks.astro';
import { collectionPageJsonLd } from '../lib/seo';
import { getRobotPages } from '../lib/robot-pages';

const robots = getRobotPages().filter((robot) => robot.category === 'robot_dog');
const featured = robots[0];
const cards = robots.map((robot, index) => ({
  slug: robot.slug,
  href: robot.route,
  title: robot.identity.name,
  category: 'Робот-собака',
  price: robot.pricing.display,
  price_disclaimer: 'Не является публичной офертой' as const,
  description: robot.seo.description,
  badge: index === 0 ? 'Робот-собака' : undefined,
  image: robot.media.hero,
  analytics: { event: 'robot_card_click' as const, placement: 'collection' as const, position: index + 1 },
}));
const heroImage = featured?.media.hero;
---

<BaseLayout
  title="Роботы-собаки в аренду — КИБЕР ПОРТАЛ"
  description="Подборка роботов-собак для событий, промо, демонстраций, выставок и технологичных презентаций."
  canonical="https://www.kiber-portal.ru/roboty-sobaki/"
  noindex={false}
  jsonLd={collectionPageJsonLd({ title: 'Роботы-собаки в аренду — КИБЕР ПОРТАЛ', description: 'Подборка роботов-собак для событий и промо.', url: '/roboty-sobaki/' })}
>
  <main class="category-page" id="main-content" tabindex="-1" data-kiber-task="KIBER-contact-lead-visual-pass3b" data-category="robot_dog">
    <section class="category-page__hero-card container" aria-labelledby="page-title">
      <div class="category-page__hero-copy">
        <p class="category-page__eyebrow">Роботы-собаки</p>
        <h1 id="page-title">Роботы-собаки для событий и промо</h1>
        <p class="category-page__lead">Технологичные роботы для проходов по площадке, демонстраций, фотоконтента и интерактива на стенде. Формат подбираем под событие, поток гостей и ограничения площадки.</p>
        <div class="category-page__actions">
          <a class="category-page__button category-page__button--primary" href="/lead/request/?scenario=robot-dog">Оставить заявку</a>
          <a class="category-page__button" href="/#catalog">Смотреть каталог</a>
        </div>
        <div class="category-page__stats" aria-label="Коротко о подборке">
          <div><strong>{cards.length}</strong><span>моделей в категории</span></div>
          <div><strong>0</strong><span>скрытых условий в заявке</span></div>
        </div>
      </div>
      <div class="category-page__media-card">
        {heroImage && <img src={heroImage.src} alt={heroImage.alt} loading="eager" decoding="async" />}
      </div>
    </section>

    <section class="category-page__grid-section container" aria-labelledby="category-robots-title">
      <div class="category-page__section-copy">
        <p>Подборка</p>
        <h2 id="category-robots-title">Роботы-собаки для проходов, demo и фотоконтента</h2>
        <p>Карточки используют утверждённые изображения и alt-тексты из media review; финальные условия подтверждаются менеджером.</p>
      </div>
      <div class="category-page__grid">
        {cards.map((card) => <RobotCard {...card} />)}
      </div>
    </section>

    <section class="category-page__notes container" aria-label="Как выбрать робота-собаку">
      <article><h2>Для промо</h2><p>Подходит короткий маршрут, команда сопровождения и сценарий, который собирает зрителей вокруг стенда.</p></article>
      <article><h2>Для площадки</h2><p>Проверяем покрытие пола, ширину проходов, безопасность гостей и точки остановки для фото.</p></article>
      <article><h2>Для контента</h2><p>Планируем эффектный выход, ракурсы, тайминг и действия робота под фото- и видеосъёмку.</p></article>
    </section>

    <section class="category-page__cta-strip container" aria-label="Следующий шаг">
      <div>
        <p>Подбор под событие</p>
        <h2>Обсудим маршрут и сценарий робота-собаки</h2>
      </div>
      <a class="category-page__button category-page__button--inverse" href="/lead/request/?scenario=robot-dog">Обсудить сценарий</a>
    </section>

    <div class="category-page__links container">
      <InternalLinks route="/roboty-sobaki/" label="Следующие шаги" />
    </div>
  </main>
</BaseLayout>

<style>
  .category-page {
    display: grid;
    gap: 4.5rem;
    padding-block: 7rem 4.5rem;
    background: var(--kp-reference-sky);
  }

  .category-page__hero-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(21rem, .82fr);
    gap: 0;
    overflow: hidden;
    border-radius: 1.75rem;
    background: var(--kp-reference-blue-deep);
    color: var(--kp-reference-white);
  }

  .category-page__hero-copy {
    display: grid;
    align-content: center;
    gap: 1.25rem;
    padding: clamp(2.25rem, 5vw, 5rem);
  }

  .category-page__eyebrow,
  .category-page__hero-copy h1,
  .category-page__lead,
  .category-page__section-copy p,
  .category-page__section-copy h2,
  .category-page__notes h2,
  .category-page__notes p,
  .category-page__cta-strip p,
  .category-page__cta-strip h2 {
    margin: 0;
  }

  .category-page__eyebrow,
  .category-page__section-copy > p:first-child,
  .category-page__cta-strip p {
    color: color-mix(in srgb, var(--kp-reference-white) 78%, transparent);
    font-size: var(--kp-reference-label-size);
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .category-page__section-copy > p:first-child {
    color: var(--kp-reference-blue);
  }

  .category-page__hero-copy h1 {
    max-width: 43rem;
    font-family: var(--kp-font-heading);
    font-size: clamp(3rem, 7vw, var(--kp-reference-display-xl));
    font-weight: 700;
    line-height: .96;
  }

  .category-page__lead {
    max-width: 43rem;
    color: color-mix(in srgb, var(--kp-reference-white) 84%, transparent);
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .category-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: .25rem;
  }

  .category-page__button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: .0625rem solid color-mix(in srgb, var(--kp-reference-white) 26%, transparent);
    border-radius: var(--kp-reference-button-radius);
    padding: .875rem 1.5rem;
    color: var(--kp-reference-white);
    font-family: var(--kp-font-heading);
    font-weight: 700;
    text-decoration: none;
  }

  .category-page__button--primary {
    border-color: var(--kp-reference-blue);
    background: var(--kp-reference-blue);
  }

  .category-page__button--inverse {
    border-color: var(--kp-reference-white);
    background: var(--kp-reference-white);
    color: var(--kp-reference-blue);
  }

  .category-page__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 10rem));
    gap: .75rem;
    margin-top: .5rem;
  }

  .category-page__stats div {
    display: grid;
    gap: .25rem;
    padding: 1rem;
    border: .0625rem solid color-mix(in srgb, var(--kp-reference-white) 18%, transparent);
    border-radius: 1rem;
  }

  .category-page__stats strong {
    font-family: var(--kp-font-heading);
    font-size: 1.75rem;
    line-height: 1;
  }

  .category-page__stats span {
    color: color-mix(in srgb, var(--kp-reference-white) 82%, transparent);
    font-size: .9rem;
    line-height: 1.35;
  }

  .category-page__media-card {
    display: grid;
    min-height: 36rem;
    place-items: end center;
    background: linear-gradient(90deg, color-mix(in srgb, var(--kp-reference-blue-deep) 20%, var(--kp-reference-white)), var(--kp-reference-white));
  }

  .category-page__media-card img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
  }

  .category-page__grid-section,
  .category-page__section-copy {
    display: grid;
    gap: var(--kp-reference-small-gap-xl);
  }

  .category-page__section-copy {
    max-width: 44rem;
    gap: .75rem;
  }

  .category-page__section-copy h2,
  .category-page__cta-strip h2 {
    font-family: var(--kp-font-heading);
    font-size: var(--kp-reference-heading-lg);
    line-height: 1;
  }

  .category-page__section-copy p:last-child,
  .category-page__notes p {
    color: var(--kp-reference-muted);
    line-height: 1.55;
  }

  .category-page__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--kp-reference-small-gap-lg);
  }

  .category-page__notes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--kp-reference-small-gap-md);
  }

  .category-page__notes article {
    display: grid;
    gap: .75rem;
    padding: 1.5rem;
    border: .0625rem solid color-mix(in srgb, var(--kp-reference-blue-deep) 10%, transparent);
    border-radius: 1.25rem;
    background: var(--kp-reference-white);
  }

  .category-page__notes h2 {
    font-family: var(--kp-font-heading);
    font-size: var(--kp-reference-title-s);
  }

  .category-page__cta-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kp-reference-small-gap-lg);
    border-radius: 1rem;
    padding: 2rem 1.5rem;
    background: var(--kp-reference-blue-deep);
    color: var(--kp-reference-white);
  }

  .category-page__cta-strip p {
    margin-bottom: .5rem;
  }

  @media (max-width: 74.9375rem) {
    .category-page__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 59.9375rem) {
    .category-page {
      gap: 3rem;
      padding-block: 1.5rem 3rem;
    }

    .category-page__hero-card,
    .category-page__notes,
    .category-page__cta-strip {
      grid-template-columns: 1fr;
    }

    .category-page__hero-card {
      display: grid;
    }

    .category-page__media-card {
      min-height: 20rem;
      order: -1;
    }

    .category-page__cta-strip {
      display: grid;
      align-items: start;
    }
  }

  @media (max-width: 39.9375rem) {
    .category-page__hero-copy,
    .category-page__notes article,
    .category-page__cta-strip {
      padding: 1.25rem;
    }

    .category-page__media-card {
      min-height: 16rem;
    }

    .category-page__grid,
    .category-page__actions,
    .category-page__stats {
      display: grid;
      grid-template-columns: 1fr;
    }

    .category-page__button {
      width: 100%;
    }
  }
</style>
