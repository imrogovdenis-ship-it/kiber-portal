---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbJsonLd, collectionPageJsonLd, faqPageJsonLd } from '../lib/seo';
import CompilationTemplate from '../components/templates/CompilationTemplate.astro';
import { getRobotDogsPreviewCompilation } from '../lib/robot-dogs-preview-adapter';

const isRobotDogsPreview = import.meta.env.DEPLOY_ENV === 'preview';
const previewTemplate = getRobotDogsPreviewCompilation();
---

<BaseLayout
  title={previewTemplate.seo.title}
  description={previewTemplate.seo.description}
  canonical={`https://www.kiber-portal.ru${previewTemplate.seo.canonical}`}
  noindex={isRobotDogsPreview}
  breadcrumbs={previewTemplate.breadcrumbs}
  jsonLd={[
    collectionPageJsonLd({ title: previewTemplate.seo.title, description: previewTemplate.seo.description, url: previewTemplate.seo.canonical }),
    breadcrumbJsonLd(previewTemplate.breadcrumbs),
    faqPageJsonLd({ items: previewTemplate.faq.items }),
    { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: previewTemplate.catalog.robots.map((r, i) => ({ '@type': 'ListItem', position: i + 1, name: r.title, url: `https://www.kiber-portal.ru${r.href}` })) },
  ]}
>
  <main id="main-content" tabindex="-1" data-kiber-task="robot-dogs-preview" data-preview-only={isRobotDogsPreview ? 'true' : undefined}>
    <CompilationTemplate template={previewTemplate} />
  </main>
</BaseLayout>

<!-- Natural-ratio photos: scoped to this preview gallery, never scenario cards. -->
<style is:global>
  #main-content[data-kiber-task="robot-dogs-preview"] .humanoid-template__gallery-item {
    flex: 0 0 auto;
    width: fit-content;
    height: min(var(--humanoid-gallery-height), 85vw);
    aspect-ratio: auto;
    background: transparent;
  }
  #main-content[data-kiber-task="robot-dogs-preview"] .humanoid-template__gallery-item img {
    width: auto;
    height: 100%;
    max-width: none;
    object-fit: contain;
  }

  /* Owner-approved D: only this collection's mobile scenario cards. */
  @media (max-width: 39.9375rem) {
    #main-content[data-kiber-task="robot-dogs-preview"] .humanoid-template__scenario-strip {
      display: flex; flex-direction: column; gap: 2.25rem;
      overflow: visible; scroll-snap-type: none; touch-action: pan-y pinch-zoom;
      padding: 0 1rem; width: 100%; box-sizing: border-box;
    }
    #main-content[data-kiber-task="robot-dogs-preview"] .humanoid-template__scenario-photo-card {
      width: 100%; max-width: 100%; min-width: 0; flex: 0 0 auto;
      scroll-snap-align: none; overflow: visible; background: transparent;
    }
    #main-content[data-kiber-task="robot-dogs-preview"] .humanoid-template__scenario-photo {
      height: auto; min-height: 0; width: 100%; max-width: 100%;
      aspect-ratio: auto; background: transparent; overflow: hidden; border-radius: 1rem;
    }
    #main-content[data-kiber-task="robot-dogs-preview"] .humanoid-template__scenario-photo img {
      display: block; width: 100%; height: auto; max-width: 100%;
      aspect-ratio: auto; object-fit: contain; touch-action: pan-y pinch-zoom;
    }
    #main-content[data-kiber-task="robot-dogs-preview"] .humanoid-template__scenario-caption {
      width: 100%; max-width: none; padding: 1rem 0 0;
    }
    #main-content[data-kiber-task="robot-dogs-preview"] .humanoid-template__scenario-caption h3 {
      font-size: 1.25rem; line-height: 1.25; margin: 0 0 .6rem;
    }
    #main-content[data-kiber-task="robot-dogs-preview"] .humanoid-template__scenario-caption p {
      font-size: 1rem; line-height: 1.55; margin: 0; max-height: none; overflow: visible;
    }
    #main-content[data-kiber-task="robot-dogs-preview"] .humanoid-template__scenario-head-row {
      display: none;
    }
  }
</style>
