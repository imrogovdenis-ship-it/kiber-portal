---
import BaseLayout from '../../layouts/BaseLayout.astro';

const robot = Astro.url.searchParams.get('robot') ?? 'arenda-unitree-g1';
const robotLabel = robot
  .replace(/^arenda-/, '')
  .split('-')
  .filter(Boolean)
  .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
  .join(' ');
---

<BaseLayout
  title="Заявка принята — КИБЕР ПОРТАЛ"
  description="Подтверждение заявки на подбор робота для мероприятия."
  canonical="https://www.kiber-portal.ru/lead/thanks/"
  noindex
  breadcrumbs={[
    { name: 'Главная', url: '/' },
    { name: 'Заявка принята', url: '/lead/thanks/' },
  ]}
>
  <main class="lead-thanks" id="main-content" tabindex="-1" data-kiber-task="KIBER-contact-lead-visual-pass3b" data-vertical-step="confirmation">
    <section class="lead-thanks__hero-card container" aria-labelledby="lead-thanks-title">
      <div class="lead-thanks__copy">
        <p class="lead-thanks__eyebrow">КИБЕР ПОРТАЛ</p>
        <h1 id="lead-thanks-title">Спасибо, бриф принят</h1>
        <p class="lead-thanks__lead">Мы сохранили запрос по модели <strong>{robotLabel}</strong> и подготовим следующий шаг: сценарий, площадку, тайминг и состав сопровождения.</p>
        <div class="lead-thanks__actions" aria-label="Навигация после заявки">
          <a class="lead-thanks__button lead-thanks__button--primary" href={`/robots/${robot}/`}>Вернуться к роботу</a>
          <a class="lead-thanks__button" href="/contacts">Контакты</a>
        </div>
      </div>

      <div class="lead-thanks__signal" aria-label="Что будет дальше">
        <div class="lead-thanks__mark" aria-hidden="true">✓</div>
        <p>Менеджер свяжется после подключения утверждённых каналов связи.</p>
      </div>
    </section>

    <section class="lead-thanks__steps container" aria-label="Что будет дальше">
      <article>
        <span>01</span>
        <h2>Сценарий</h2>
        <p>Уточняем роль робота: встреча гостей, стенд, презентация, шоу или фотозона.</p>
      </article>
      <article>
        <span>02</span>
        <h2>Площадка</h2>
        <p>Проверяем дату, город, логистику, питание, звук, безопасность и ограничения площадки.</p>
      </article>
      <article>
        <span>03</span>
        <h2>Смета</h2>
        <p>Собираем финальное предложение по времени аренды, программе и составу сопровождения.</p>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .lead-thanks {
    display: grid;
    gap: var(--kp-reference-small-gap-xl);
    padding-block: 7rem 4.5rem;
    background: var(--kp-reference-sky);
  }

  .lead-thanks__hero-card {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, .65fr);
    gap: clamp(1.5rem, 4vw, 3.25rem);
    align-items: stretch;
    overflow: hidden;
    border-radius: 1.75rem;
    background: var(--kp-reference-blue-deep);
    color: var(--kp-reference-white);
  }

  .lead-thanks__copy {
    display: grid;
    align-content: center;
    gap: 1.25rem;
    padding: clamp(2rem, 5vw, 5rem);
  }

  .lead-thanks__eyebrow,
  .lead-thanks__copy h1,
  .lead-thanks__lead,
  .lead-thanks__signal p,
  .lead-thanks__steps h2,
  .lead-thanks__steps p {
    margin: 0;
  }

  .lead-thanks__eyebrow {
    color: color-mix(in srgb, var(--kp-reference-white) 78%, transparent);
    font-size: var(--kp-reference-label-size);
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .lead-thanks__copy h1 {
    max-width: 40rem;
    font-family: var(--kp-font-heading);
    font-size: clamp(3rem, 7vw, var(--kp-reference-display-xl));
    font-weight: 700;
    line-height: .96;
  }

  .lead-thanks__lead,
  .lead-thanks__signal p {
    max-width: 42rem;
    color: color-mix(in srgb, var(--kp-reference-white) 84%, transparent);
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .lead-thanks__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: .5rem;
  }

  .lead-thanks__button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: .0625rem solid color-mix(in srgb, var(--kp-reference-white) 26%, transparent);
    border-radius: var(--kp-reference-button-radius);
    padding: .875rem 1.5rem;
    color: var(--kp-reference-white);
    font-family: var(--kp-font-heading);
    font-weight: 700;
    text-decoration: none;
  }

  .lead-thanks__button--primary {
    border-color: var(--kp-reference-blue);
    background: var(--kp-reference-blue);
  }

  .lead-thanks__signal {
    display: grid;
    align-content: end;
    gap: 1rem;
    min-height: 24rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    background:
      radial-gradient(circle at 55% 15%, color-mix(in srgb, var(--kp-reference-white) 94%, transparent) 0 4rem, transparent 4.25rem),
      linear-gradient(155deg, color-mix(in srgb, var(--kp-reference-white) 92%, transparent), color-mix(in srgb, var(--kp-reference-blue) 16%, var(--kp-reference-white)));
    color: var(--kp-reference-ink);
  }

  .lead-thanks__mark {
    display: grid;
    width: 5rem;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 50%;
    background: var(--kp-reference-blue);
    color: var(--kp-reference-white);
    font-family: var(--kp-font-heading);
    font-size: 2.5rem;
    font-weight: 700;
  }

  .lead-thanks__signal p {
    color: var(--kp-reference-ink);
    font-family: var(--kp-font-heading);
    font-size: var(--kp-reference-title-s);
    font-weight: 700;
    line-height: 1.2;
  }

  .lead-thanks__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--kp-reference-small-gap-md);
  }

  .lead-thanks__steps article {
    display: grid;
    gap: .75rem;
    padding: 1.5rem;
    border: .0625rem solid color-mix(in srgb, var(--kp-reference-blue-deep) 10%, transparent);
    border-radius: 1.25rem;
    background: var(--kp-reference-white);
  }

  .lead-thanks__steps span {
    color: var(--kp-reference-blue);
    font-family: var(--kp-font-heading);
    font-weight: 700;
  }

  .lead-thanks__steps h2 {
    font-family: var(--kp-font-heading);
    font-size: var(--kp-reference-title-s);
  }

  .lead-thanks__steps p {
    color: var(--kp-reference-muted);
    line-height: 1.55;
  }

  @media (max-width: 59.9375rem) {
    .lead-thanks {
      padding-block: 1.5rem 3rem;
    }

    .lead-thanks__hero-card,
    .lead-thanks__steps {
      grid-template-columns: 1fr;
    }

    .lead-thanks__signal {
      min-height: 14rem;
      order: -1;
    }
  }

  @media (max-width: 39.9375rem) {
    .lead-thanks__copy,
    .lead-thanks__signal,
    .lead-thanks__steps article {
      padding: 1.25rem;
    }

    .lead-thanks__actions {
      display: grid;
    }

    .lead-thanks__button {
      width: 100%;
    }
  }
</style>
