---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';
import { webPageJsonLd } from '../../lib/seo';

const robot = 'general';
const contactChannels = [
  {
    title: 'Написать в Telegram',
    text: 'Быстрый канал для брифа: город, дата, площадка, сценарий и желаемая модель.',
    href: siteConfig.telegram,
    cta: 'Открыть Telegram',
    event: 'messenger_click',
  },
  {
    title: 'Написать в WhatsApp',
    text: 'Удобно отправить короткое описание события и получить следующий шаг.',
    href: siteConfig.whatsapp,
    cta: 'Открыть WhatsApp',
    event: 'messenger_click',
  },
  {
    title: 'Написать в MAX',
    text: 'Дополнительный способ обсудить мероприятие с менеджером.',
    href: siteConfig.max,
    cta: 'Открыть MAX',
    event: 'messenger_click',
  },
];
---

<BaseLayout
  title="Заявка на подбор робота — КИБЕР ПОРТАЛ"
  description="Короткая заявка на подбор робота для мероприятия."
  canonical="https://www.kiber-portal.ru/lead/request/"
  noindex
  breadcrumbs={[
    { name: 'Главная', url: '/' },
    { name: 'Заявка', url: '/lead/request/' },
  ]}
  jsonLd={webPageJsonLd({ title: 'Заявка на подбор робота', description: 'Короткая заявка на подбор робота для мероприятия.', url: '/lead/request/' })}
>
  <main
    class="lead-request container"
    id="main-content"
    tabindex="-1"
    data-kiber-task="contact-lead-visual-pass2"
    data-rv="31"
  >
    <section class="lead-request__intro" aria-labelledby="lead-request-title">
      <p>Подбор робота</p>
      <h1 id="lead-request-title">Заявка на подбор робота</h1>
      <p>Оставьте заявку или напишите нам напрямую. Укажите город, дату, площадку и задачу — это поможет подобрать робота.</p>
    </section>

    <div class="lead-request__panel">
      <section class="lead-request__pending-form" aria-labelledby="lead-form-title">
        <h2 id="lead-form-title">Расскажите о мероприятии</h2>
        <p>В форме можно оставить имя и телефон для обратной связи.</p>
        <a href="#lead-form" data-lead-form-popup-trigger>Оставить заявку</a>
        <noscript><p>Для открытия формы нужен JavaScript. Вы можете связаться с нами напрямую по контактам ниже.</p></noscript>
      </section>

      <section class="lead-request__contacts" aria-labelledby="lead-working-contacts-title" data-vertical-step="lead-to-contacts">
        <p class="lead-request__eyebrow">Рабочие контакты</p>
        <h2 id="lead-working-contacts-title">Напишите нам напрямую</h2>
        <p>Укажите выбранного робота, город, дату, площадку и примерный сценарий — менеджер продолжит диалог в выбранном канале.</p>
        <div class="lead-request__contact-grid">
          {contactChannels.map((channel) => (
            <a
              class="lead-request__contact-card"
              href={channel.href}
              data-analytics-event={channel.event}
              data-analytics-source="lead_request"
              data-analytics-placement="working_contact_channel"
              data-analytics-slug={robot}
            >
              <strong>{channel.title}</strong>
              <span>{channel.text}</span>
              <em>{channel.cta}</em>
            </a>
          ))}
        </div>
        <p id="lead-request-status" class="lead-request__note" aria-live="polite">Если не получается открыть форму, воспользуйтесь удобным каналом связи выше.</p>
      </section>

      <aside class="lead-request__sidebar" aria-label="Подготовка заявки">
        <p>Подбор под задачу</p>
        <h2>Что сообщить менеджеру</h2>
        <p>Достаточно первых вводных — подробности обсудим вместе.</p>
        <ul>
          <li>город и дата мероприятия;</li>
          <li>площадка и желаемый формат участия робота;</li>
          <li>интересующая модель, если уже выбрали.</li>
        </ul>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .lead-request {
    display: grid;
    gap: var(--kp-reference-small-gap-xl);
    padding-block: var(--kp-reference-pad-y) calc(var(--kp-reference-pad-y) * 2);
  }

  .lead-request__intro {
    display: grid;
    max-width: 52rem;
    gap: var(--kp-reference-small-gap-md);
  }

  .lead-request__intro p,
  .lead-request__intro h1,
  .lead-request__note,
  .lead-request__contacts p,
  .lead-request__contacts h2,
  .lead-request__pending-form p,
  .lead-request__pending-form h2,
  .lead-request__sidebar p,
  .lead-request__sidebar h2,
  .lead-request__sidebar ul {
    margin: 0;
  }

  .lead-request__intro > p:first-child,
  .lead-request__eyebrow,
  .lead-request__sidebar > p:first-child {
    color: var(--kp-reference-blue);
    font-size: var(--kp-reference-label-size);
    font-weight: var(--kp-label-weight);
    letter-spacing: var(--kp-label-letter-spacing);
    text-transform: uppercase;
  }

  .lead-request__intro h1 {
    font-family: var(--kp-font-heading);
    font-size: clamp(2.25rem, 6vw, var(--kp-reference-display-l));
    line-height: var(--kp-display-line-height);
  }

  .lead-request__intro > p:last-child,
  .lead-request__note,
  .lead-request__contacts > p,
  .lead-request__contact-card span,
  .lead-request__sidebar p,
  .lead-request__sidebar li {
    color: var(--kp-reference-muted);
    line-height: var(--kp-body-line-height);
  }

  .lead-request__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(18rem, 0.82fr);
    gap: var(--kp-reference-small-gap-lg);
    align-items: stretch;
  }

  .lead-request__contacts,
  .lead-request__pending-form,
  .lead-request__sidebar {
    display: grid;
    gap: var(--kp-reference-small-gap-md);
    padding: clamp(1.25rem, 4vw, 2rem);
    border-radius: 1.75rem;
  }

  .lead-request__contacts,
  .lead-request__pending-form {
    border: 0.0625rem solid color-mix(in srgb, var(--kp-reference-blue) 14%, transparent);
    background: var(--kp-reference-white);
  }

  .lead-request__sidebar {
    align-content: start;
    background: var(--kp-reference-ink);
    color: var(--kp-reference-white);
  }

  .lead-request__contacts h2,
  .lead-request__pending-form h2,
  .lead-request__pending-form label,
  .lead-request__sidebar h2 {
    color: var(--kp-reference-ink);
    font-family: var(--kp-font-heading);
    font-size: var(--kp-reference-heading);
    line-height: 1.04;
  }

  .lead-request__sidebar h2 {
    color: var(--kp-reference-white);
  }

  .lead-request__sidebar ul {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.25rem;
  }

  .lead-request__contact-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.875rem;
  }

  .lead-request__pending-form form {
    display: grid;
    gap: 0.875rem;
  }

  .lead-request__pending-form label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.875rem;
    line-height: 1.3;
  }

  .lead-request__pending-form input:not([type='checkbox']),
  .lead-request__pending-form textarea {
    width: 100%;
    min-height: 2.75rem;
    box-sizing: border-box;
    border: 0.0625rem solid var(--kp-line);
    border-radius: 0.875rem;
    padding: 0.75rem 1rem;
    background: var(--kp-reference-sky);
    color: var(--kp-reference-ink);
    font: inherit;
  }

  .lead-request__pending-form textarea {
    resize: vertical;
  }

  .lead-request__approval {
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    color: var(--kp-reference-muted);
    font-family: var(--kp-font-body);
    font-weight: 400;
  }

  .lead-request__approval input {
    margin-top: 0.2rem;
    accent-color: var(--kp-reference-blue);
  }

  .lead-request__approval a {
    color: var(--kp-reference-blue);
  }

  .lead-request__pending-form button {
    min-height: 2.75rem;
    border: 0;
    border-radius: 62.4375rem;
    background: var(--kp-reference-blue);
    color: var(--kp-reference-white);
    font-weight: var(--kp-heading-weight);
  }

  .lead-request__contact-card {
    display: grid;
    gap: 0.55rem;
    min-height: 100%;
    padding: 1rem;
    border: 0.0625rem solid color-mix(in srgb, var(--kp-reference-blue-deep) 10%, transparent);
    border-radius: 1rem;
    background: var(--kp-reference-sky);
    color: var(--kp-reference-ink);
    text-decoration: none;
  }

  .lead-request__contact-card strong,
  .lead-request__contact-card em {
    font-style: normal;
  }

  .lead-request__contact-card em {
    color: var(--kp-reference-blue);
    font-weight: var(--kp-label-weight);
  }

  .lead-request__pending-form[hidden] {
    display: none;
  }

  @media (max-width: 59.9375rem) {
    .lead-request__panel,
    .lead-request__contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
