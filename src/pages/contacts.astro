---
import BaseLayout from '../layouts/BaseLayout.astro';
import InternalLinks from '../components/content/InternalLinks.astro';
import { contactPageJsonLd } from '../lib/seo';

const contactCards = [
  {
    title: 'Написать нам',
    text: 'Коротко опишите город, дату, площадку и какую роль должен взять робот.',
    href: '/lead/request/',
    cta: 'Заполнить заявку',
    state: 'static-safe form',
  },
  {
    title: 'Быстрый подбор',
    text: 'Подберём формат под выставку, форум, презентацию, ресторан, свадьбу или образовательное событие.',
    href: '/#catalog',
    cta: 'Смотреть роботов',
    state: '24 модели в каталоге',
  },
  {
    title: 'Каналы связи',
    text: 'Публичные мессенджеры и CRM-отправка подключаются после отдельного lead-routing решения.',
    href: '/lead/request/',
    cta: 'Оставить контакты безопасно',
    state: 'lead capability disabled',
  },
];
---

<BaseLayout
  title="Контакты — КИБЕР ПОРТАЛ"
  description="Контактная страница КИБЕР ПОРТАЛА для подбора робота."
  canonical="https://www.kiber-portal.ru/contacts/"
  noindex={false}
  jsonLd={contactPageJsonLd({ title: 'Контакты — КИБЕР ПОРТАЛ', description: 'Контактная страница КИБЕР ПОРТАЛА для подбора робота.', url: '/contacts/' })}
>
  <main class="contact-conversion container" id="main-content" tabindex="-1" data-kiber-task="contact-lead-visual-pass2" data-rv="30">
    <section class="contact-conversion__hero" aria-labelledby="page-title">
      <p>КИБЕР ПОРТАЛ</p>
      <h1 id="page-title">Контакты и заявка на робота</h1>
      <p>Опишите мероприятие в короткой заявке — команда подберёт подходящий сценарий, модель и безопасный формат работы на площадке.</p>
    </section>

    <section class="contact-conversion__grid" aria-label="Варианты связи">
      {contactCards.map((card) => (
        <article class="contact-conversion__card">
          <p class="contact-conversion__state">{card.state}</p>
          <h2>{card.title}</h2>
          <p>{card.text}</p>
          <a href={card.href} data-analytics-event="contact_click" data-analytics-source="contacts" data-analytics-placement="conversion_card" data-analytics-slug="global">{card.cta}</a>
        </article>
      ))}
    </section>

    <aside class="contact-conversion__notice" aria-label="Статус интеграций">
      <strong>Lead capability:</strong> routing remains disabled until owner approval. Production contacts, CRM, Telegram bot and email delivery are not enabled in this visual pass.
    </aside>

    <InternalLinks route="/contacts/" label="Следующие шаги" />
  </main>
</BaseLayout>

<style>
  .contact-conversion {
    display: grid;
    gap: var(--kp-reference-small-gap-xl);
    padding-block: var(--kp-reference-pad-y) calc(var(--kp-reference-pad-y) * 2);
  }

  .contact-conversion__hero {
    display: grid;
    max-width: 54rem;
    gap: var(--kp-reference-small-gap-md);
    padding: clamp(2rem, 5vw, 4.5rem);
    border-radius: 2rem;
    background: linear-gradient(135deg, var(--kp-reference-blue-deep), var(--kp-reference-blue));
    color: var(--kp-reference-white);
  }

  .contact-conversion__hero p,
  .contact-conversion__hero h1,
  .contact-conversion__card p,
  .contact-conversion__card h2,
  .contact-conversion__notice {
    margin: 0;
  }

  .contact-conversion__hero > p:first-child,
  .contact-conversion__state {
    font-size: var(--kp-reference-label-size);
    font-weight: var(--kp-label-weight);
    letter-spacing: var(--kp-label-letter-spacing);
    text-transform: uppercase;
  }

  .contact-conversion__hero h1 {
    font-family: var(--kp-font-heading);
    font-size: clamp(2.5rem, 7vw, var(--kp-reference-display-xl));
    line-height: var(--kp-display-line-height);
  }

  .contact-conversion__hero > p:last-child {
    max-width: 42rem;
    color: color-mix(in srgb, var(--kp-reference-white) 86%, transparent);
    font-size: 1.125rem;
    line-height: var(--kp-body-line-height);
  }

  .contact-conversion__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--kp-reference-small-gap-lg);
  }

  .contact-conversion__card {
    display: grid;
    align-content: start;
    gap: var(--kp-reference-small-gap-md);
    min-height: 100%;
    padding: 1.5rem;
    border: 0.0625rem solid color-mix(in srgb, var(--kp-reference-blue) 14%, transparent);
    border-radius: 1.75rem;
    background: var(--kp-reference-white);
  }

  .contact-conversion__state {
    color: var(--kp-reference-blue);
  }

  .contact-conversion__card h2 {
    font-family: var(--kp-font-heading);
    font-size: var(--kp-reference-title-s);
    line-height: 1.08;
  }

  .contact-conversion__card p:not(.contact-conversion__state),
  .contact-conversion__notice {
    color: var(--kp-reference-muted);
    line-height: var(--kp-body-line-height);
  }

  .contact-conversion__card a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    margin-top: auto;
    padding: 0.75rem 1.25rem;
    border-radius: var(--kp-reference-button-radius);
    background: var(--kp-reference-blue);
    color: var(--kp-reference-white);
    font-family: var(--kp-font-heading);
    font-weight: var(--kp-heading-weight);
    text-decoration: none;
  }

  .contact-conversion__notice {
    padding: 1.25rem 1.5rem;
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--kp-reference-blue) 8%, var(--kp-reference-white));
  }

  @media (max-width: 59.9375rem) {
    .contact-conversion__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
