---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import CompilationTemplate from '../../../../../components/templates/CompilationTemplate.astro';
import contentPackage from '../../../../../../data/content/compilation-humanoids.json';
import type { CompilationPageTemplateData } from '../../../../../lib/kiber94-compilation-template-data';
import { breadcrumbJsonLd, collectionPageJsonLd, faqPageJsonLd } from '../../../../../lib/seo';
const template = contentPackage.blocks as CompilationPageTemplateData;
const pageUrl = '/preview/kiber-94/compilation/roboty-gumanoidy/';
---

<BaseLayout
  title={template.seo.title}
  description={template.seo.description}
  canonical={`https://www.kiber-portal.ru${template.seo.canonical}`}
  noindex={true}
  breadcrumbs={template.breadcrumbs}
  jsonLd={[
    collectionPageJsonLd({ title: template.seo.title, description: template.seo.description, url: template.seo.canonical }),
    breadcrumbJsonLd(template.breadcrumbs),
    faqPageJsonLd({ items: template.faq.items }),
    { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: template.catalog.robots.map((r, i) => ({ '@type': 'ListItem', position: i + 1, name: r.title, url: `https://www.kiber-portal.ru${r.href}` })) },
  ]}
>
  <main id="main-content" tabindex="-1">
    <CompilationTemplate {template} />
  </main>
</BaseLayout>
