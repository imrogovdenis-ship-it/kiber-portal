---
import type { FaqData } from '../../../design-system/schemas/fixture.schema';
const { title, items } = Astro.props as FaqData;
---

<section class="faq" data-block-id="faq" data-review-id="07">
  <h2>{title}</h2>
  <div class="faq__list">
    {items.map((item) => (
      <details class="faq__item" open>
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .faq { display: grid; gap: var(--kp-grid-gap); padding-block: var(--kp-section-block); color: var(--kp-ink); }
  .faq h2 { margin: 0; font-family: var(--kp-font-heading); font-size: var(--kp-heading-size); line-height: var(--kp-heading-line-height); }
  .faq__list { display: grid; gap: var(--kp-card-gap); }
  .faq__item { border: 0.0625rem solid var(--kp-line); border-radius: 1.5rem; padding: var(--kp-content-padding); background: var(--kp-surface); }
  .faq__item summary { cursor: pointer; font-weight: var(--kp-heading-weight); }
  .faq__item summary:focus-visible { outline: 0.1875rem solid var(--kp-orange); outline-offset: 0.25rem; }
  .faq__item p { margin: var(--kp-card-gap) 0 0; color: var(--kp-muted); line-height: var(--kp-body-line-height); }
  @media (min-width: 60em) { .faq__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
