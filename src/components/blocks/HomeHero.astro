---
import type { HomeHeroData } from '../../../design-system/schemas/fixture.schema';

const { eyebrow, title, lead, primary, secondary, image, stats, analytics } = Astro.props as HomeHeroData;
---

<section class="home-hero" data-block-id="home-hero" data-review-id="02" data-rv="02">
  <div class="home-hero__card">
    <div class="home-hero__content">
      <p class="home-hero__eyebrow">{eyebrow}</p>
      <h1 class="home-hero__title">{title}</h1>
      <p class="home-hero__subtitle">{lead}</p>
      <div class="home-hero__actions">
        <a class="home-hero__button home-hero__button--primary" href={primary.href} data-analytics-event={analytics.event} data-analytics-block-id={analytics.block_id} data-analytics-source="home_hero" data-analytics-placement="primary_cta" data-analytics-slug="global">{primary.label}</a>
        {secondary && <a class="home-hero__button home-hero__button--secondary" href={secondary.href}>{secondary.label}</a>}
      </div>
      {stats?.length > 0 && (
        <dl class="home-hero__stats" aria-label="Кратко о каталоге">
          {stats.map((stat) => <div><dt>{stat.value}</dt><dd>{stat.label}</dd></div>)}
        </dl>
      )}
    </div>
    {image && (
      <div class="home-hero__image" aria-hidden={image.alt ? 'false' : 'true'}>
        <img src={image.src} alt={image.alt} width="640" height="640" loading="eager" decoding="async" style={`object-position:${image.position ?? 'center top'}`} />
      </div>
    )}
  </div>
</section>

<style>
  .home-hero {
    padding: clamp(1rem, 2vw, 1.75rem);
    background: var(--kp-reference-sky);
  }

  .home-hero__card {
    position: relative;
    display: flex;
    min-height: 34rem;
    overflow: hidden;
    align-items: center;
    border-radius: 1.5rem;
    background: var(--kp-reference-ink-dark);
  }

  .home-hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    width: min(100%, 50rem);
    gap: 1.25rem;
    padding: 3.5rem 0 3.5rem 3.75rem;
    color: var(--kp-reference-white);
  }

  .home-hero__eyebrow,
  .home-hero__title,
  .home-hero__subtitle,
  .home-hero__stats,
  .home-hero__stats dd {
    margin: 0;
  }

  .home-hero__eyebrow {
    color: color-mix(in srgb, var(--kp-reference-white) 78%, transparent);
    font-size: var(--kp-reference-label-size);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-hero__title {
    max-width: 14ch;
    color: var(--kp-reference-white);
    font-family: var(--kp-font-heading);
    font-size: clamp(2.5rem, 5vw, 5.25rem);
    font-weight: 700;
    line-height: 1;
  }

  .home-hero__subtitle {
    max-width: 40rem;
    color: color-mix(in srgb, var(--kp-reference-white) 85%, transparent);
    font-size: var(--kp-body-size);
    line-height: var(--kp-body-line-height);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .home-hero__button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--kp-reference-button-radius);
    padding: 0.875rem 2rem;
    font-family: var(--kp-font-heading);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
  }

  .home-hero__button--primary {
    background: var(--kp-reference-blue);
    color: var(--kp-reference-white);
  }

  .home-hero__button--secondary {
    background: var(--kp-reference-white);
    color: var(--kp-reference-blue);
  }

  .home-hero__button:focus-visible {
    outline: 0.1875rem solid var(--kp-reference-orange);
    outline-offset: 0.1875rem;
  }

  .home-hero__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 10rem));
    gap: 0.75rem;
  }

  .home-hero__stats div {
    border: 0.0625rem solid color-mix(in srgb, var(--kp-reference-white) 16%, transparent);
    border-radius: 1rem;
    padding: 0.875rem;
    background: color-mix(in srgb, var(--kp-reference-white) 8%, transparent);
  }

  .home-hero__stats dt {
    color: var(--kp-reference-white);
    font-family: var(--kp-font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
  }

  .home-hero__stats dd {
    margin-top: 0.35rem;
    color: color-mix(in srgb, var(--kp-reference-white) 76%, transparent);
    font-size: 0.875rem;
  }

  .home-hero__image {
    position: absolute;
    inset: 0 0 0 auto;
    width: 52%;
    z-index: 1;
  }

  .home-hero__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-hero__image::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--kp-reference-ink-dark) 0%, color-mix(in srgb, var(--kp-reference-ink-dark) 0%, transparent) 45%);
    content: "";
  }

  @media (max-width: 74.9375rem) {
    .home-hero__card { min-height: 33.75rem; }
    .home-hero__content { width: min(100%, 38rem); padding: 3.5rem; }
  }

  @media (max-width: 59.9375rem) {
    .home-hero__card {
      min-height: auto;
      flex-direction: column-reverse;
      align-items: stretch;
    }
    .home-hero__content {
      width: 100%;
      padding: 1.25rem 1rem 1rem;
    }
    .home-hero__title { max-width: none; }
    .home-hero__actions {
      flex-direction: column;
      align-items: flex-start;
    }
    .home-hero__button {
      width: auto;
      max-width: 100%;
      padding-inline: 1.25rem;
    }
    .home-hero__image {
      position: relative;
      width: 100%;
      height: calc((100vw - (2 * var(--kp-reference-pad-x))) * 0.5625);
      max-height: 26rem;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      background: var(--kp-reference-white);
    }
    .home-hero__image img {
      object-fit: contain;
      object-position: center center;
    }
    .home-hero__image::after { display: none; }
    .home-hero__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .home-hero__stats div {
      min-width: 0;
    }
    .home-hero__stats dt { font-size: 1.375rem; }
    .home-hero__stats dd {
      overflow-wrap: anywhere;
      font-size: 0.75rem;
    }
  }
</style>
