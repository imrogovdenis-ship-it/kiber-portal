---
import type { HomeHeroData } from '../../../design-system/schemas/fixture.schema';

const { eyebrow, title, lead, primary, secondary, image, stats, analytics } = Astro.props as HomeHeroData;
---

<section class="home-hero" data-block-id="home-hero" data-review-id="02" data-rv="02">
  <div class="home-hero__card">
    <div class="home-hero__content">
      <p class="home-hero__eyebrow">{eyebrow}</p>
      <h1 class="home-hero__title">{title}</h1>
      <p class="home-hero__subtitle">{lead}</p>
      <div class="home-hero__actions">
        <a class="home-hero__button home-hero__button--primary" href={primary.href} data-analytics-event={analytics.event} data-analytics-block-id={analytics.block_id} data-analytics-source="home_hero" data-analytics-placement="primary_cta" data-analytics-slug="global">{primary.label}</a>
        {secondary && <a class="home-hero__button home-hero__button--secondary" href={secondary.href}>{secondary.label}</a>}
      </div>
      {stats?.length > 0 && (
        <dl class="home-hero__stats" aria-label="Кратко о каталоге">
          {stats.map((stat) => <div><dt>{stat.value}</dt><dd>{stat.label}</dd></div>)}
        </dl>
      )}
    </div>
    {image && (
      <div class="home-hero__image" aria-hidden={image.alt ? 'false' : 'true'}>
        <img src={image.src} alt={image.alt} width="640" height="640" loading="eager" decoding="async" style={`object-position:${image.position ?? 'center top'}`} />
      </div>
    )}
  </div>
</section>

<style>
  .home-hero {
    padding: clamp(0.5rem, 1vw, 0.875rem) 0 0;
    background: var(--kp-reference-sky);
  }

  .home-hero__card {
    position: relative;
    display: flex;
    min-height: 39.6rem;
    overflow: hidden;
    align-items: center;
    border-radius: 1.5rem;
    background: var(--kp-reference-ink-dark);
  }

  .home-hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    width: min(100%, 50rem);
    gap: 1.25rem;
    padding: 3.15rem 0 3.15rem 3.75rem;
    color: var(--kp-reference-white);
  }

  .home-hero__eyebrow,
  .home-hero__title,
  .home-hero__subtitle,
  .home-hero__stats,
  .home-hero__stats dd {
    margin: 0;
  }

  .home-hero__eyebrow {
    color: color-mix(in srgb, var(--kp-reference-white) 78%, transparent);
    font-size: var(--kp-reference-label-size);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-hero__title {
    max-width: 14ch;
    color: var(--kp-reference-white);
    font-family: var(--kp-font-heading);
    font-size: clamp(2.5rem, 5vw, 5.25rem);
    font-weight: 700;
    line-height: 1;
  }

  .home-hero__subtitle {
    max-width: 40rem;
    color: color-mix(in srgb, var(--kp-reference-white) 85%, transparent);
    font-size: var(--kp-body-size);
    line-height: var(--kp-body-line-height);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .home-hero__button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--kp-reference-button-radius);
    padding: 0.875rem 2rem;
    font-family: var(--kp-font-heading);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
  }

  .home-hero__button--primary {
    background: var(--kp-reference-blue);
    color: var(--kp-reference-white);
  }

  .home-hero__button--secondary {
    background: var(--kp-reference-white);
    color: var(--kp-reference-blue);
  }

  .home-hero__button:focus-visible {
    outline: 0.1875rem solid var(--kp-reference-orange);
    outline-offset: 0.1875rem;
  }

  .home-hero__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 10rem));
    gap: 0.75rem;
  }

  .home-hero__stats div {
    border: 0.0625rem solid color-mix(in srgb, var(--kp-reference-white) 16%, transparent);
    border-radius: 1rem;
    padding: 0.875rem;
    background: color-mix(in srgb, var(--kp-reference-white) 8%, transparent);
  }

  .home-hero__stats dt {
    color: var(--kp-reference-white);
    font-family: var(--kp-font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
  }

  .home-hero__stats dd {
    margin-top: 0.35rem;
    color: color-mix(in srgb, var(--kp-reference-white) 76%, transparent);
    font-size: 0.875rem;
  }

  .home-hero__image {
    position: absolute;
    inset: 0 0 0 auto;
    width: 52%;
    z-index: 1;
  }

  .home-hero__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-hero__image::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--kp-reference-ink-dark) 0%, color-mix(in srgb, var(--kp-reference-ink-dark) 0%, transparent) 45%);
    content: "";
  }

  @media (max-width: 74.9375rem) {
    .home-hero__card { min-height: 36rem; }
    .home-hero__content { width: min(100%, 38rem); padding: 3.5rem; }
  }

  @media (max-width: 59.9375rem) {
    .home-hero__card {
      min-height: clamp(46rem, 155vw, 62rem);
      align-items: stretch;
      border-radius: 1.25rem;
    }
    .home-hero__content {
      display: grid;
      width: 100%;
      min-height: inherit;
      grid-template-rows: auto auto auto minmax(2rem, 1fr) auto;
      gap: 0.95rem;
      padding: clamp(3.4rem, 12vw, 4.9rem) clamp(1.5rem, 7vw, 2rem) clamp(1.8rem, 7vw, 2.45rem);
      align-content: start;
    }
    .home-hero__eyebrow {
      font-size: 0.72rem;
    }
    .home-hero__title {
      max-width: 11.5ch;
      font-size: clamp(2.75rem, 12vw, 3.75rem);
      line-height: 1.02;
    }
    .home-hero__subtitle {
      max-width: 28rem;
      font-size: clamp(1.05rem, 5.4vw, 1.45rem);
      line-height: 1.42;
    }
    .home-hero__actions {
      grid-row: 5;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(0.7rem, 4vw, 1.05rem);
      width: 100%;
      margin-top: 0;
      align-items: center;
    }
    .home-hero__button {
      width: 100%;
      min-width: 0;
      min-height: clamp(3.15rem, 13vw, 3.65rem);
      padding: 0.72rem 0.45rem;
      border-radius: 999rem;
      font-size: clamp(0.68rem, 3.25vw, 0.82rem);
      white-space: nowrap;
    }
    .home-hero__image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: var(--kp-reference-ink-dark);
    }
    .home-hero__image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 66% center !important;
    }
    .home-hero__image::after {
      display: block;
      background:
        linear-gradient(180deg, color-mix(in srgb, var(--kp-reference-ink-dark) 16%, transparent) 0%, transparent 42%, color-mix(in srgb, var(--kp-reference-ink-dark) 22%, transparent) 100%),
        linear-gradient(90deg, color-mix(in srgb, var(--kp-reference-ink-dark) 82%, transparent) 0%, color-mix(in srgb, var(--kp-reference-ink-dark) 48%, transparent) 48%, color-mix(in srgb, var(--kp-reference-ink-dark) 16%, transparent) 100%);
    }
    .home-hero__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .home-hero__stats div {
      min-width: 0;
    }
    .home-hero__stats dt { font-size: 1.375rem; }
    .home-hero__stats dd {
      overflow-wrap: anywhere;
      font-size: 0.75rem;
    }
  }
</style>
