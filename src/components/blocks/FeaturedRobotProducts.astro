---
import type { CompilationRobotCard } from '../../lib/kiber94-compilation-template-data';
interface Props { robots: CompilationRobotCard[]; descriptions: Record<string, string>; }
const { robots, descriptions } = Astro.props;
for (const robot of robots) if (!descriptions[robot.title]) throw new Error(`Missing approved featured copy for ${robot.title}`);
---
<!-- Extracted one-product presentation from the approved ArticleBlocksTemplate; data remains canonical. -->
<section id="featured-dogs" class="article-blocks__product container article-blocks" data-block-id="productCard" aria-label="Три модели роботов-собак">
  {robots.map((robot, index) => (
    <article class="article-blocks__featured-model" aria-labelledby={`featured-dog-${index}`}>
      <a class="article-blocks__featured-media" href={robot.href} aria-label={`Перейти на страницу ${robot.title}`}>
        {robot.image && <img src={robot.image.src} alt={robot.image.alt} loading="lazy" decoding="async" />}
      </a>
      <div class="article-blocks__featured-copy">
        <h3 id={`featured-dog-${index}`}>{robot.title}</h3>
        <p class="article-blocks__featured-category">{robot.category}</p>
        <p class="article-blocks__featured-price">{robot.price}</p>
        <p class="article-blocks__featured-description">{descriptions[robot.title]}</p>
        <a class="article-blocks__featured-button" href={robot.href}>Перейти на страницу</a>
      </div>
    </article>
  ))}
</section>
<style>
  .article-blocks { background: var(--kp-reference-sky); color: var(--kp-reference-ink); display: grid; overflow-x: clip; }
  .article-blocks h3, .article-blocks p { margin: 0; }
  .article-blocks h3 { font-family: var(--kp-font-heading); letter-spacing: -.03em; font-weight: 700; }
  .article-blocks__product { display: grid; gap: 1.5rem; row-gap: clamp(3rem, 5vw, 5rem); padding-block: clamp(3.25rem, 5.5vw, 5rem); scroll-margin-top: 6rem; }
  .article-blocks__featured-model { display: grid; grid-template-columns: minmax(18rem, .42fr) minmax(0, .58fr); gap: clamp(2rem, 4vw, 3.5rem); align-items: start; }
  .article-blocks__featured-media { position: relative; display: block; min-height: clamp(24rem, 34vw, 32rem); overflow: hidden; border-radius: 1.1rem; background: transparent; text-decoration: none; }
  .article-blocks__featured-media img { display: block; width: 100%; height: 100%; min-height: clamp(24rem, 34vw, 32rem); object-fit: cover; object-position: center; }
  .article-blocks__featured-copy { display: grid; gap: .95rem; padding-top: .45rem; }
  .article-blocks__featured-copy h3 { color: var(--kp-reference-ink); font-size: clamp(3rem, 5.5vw, 5rem); line-height: .95; }
  .article-blocks__featured-category { color: var(--kp-reference-muted); font-size: .95rem; line-height: 1.35; }
  .article-blocks__featured-price { color: var(--kp-reference-muted); font-family: var(--kp-font-heading); font-size: clamp(1.05rem, 1.5vw, 1.22rem); font-weight: 700; line-height: 1.2; }
  .article-blocks__featured-description { max-width: 48rem; color: var(--kp-reference-muted); font-size: clamp(.98rem, 1.1vw, 1.08rem); line-height: 1.58; }
  .article-blocks__featured-button { display: inline-flex; width: fit-content; min-height: 3.1rem; align-items: center; justify-content: center; border-radius: var(--kp-reference-button-radius); padding: .95rem 1.75rem; background: var(--kp-reference-blue); color: var(--kp-reference-white); font-family: var(--kp-font-heading); font-weight: 700; line-height: 1; text-decoration: none; }
  @media (max-width: 74.9375rem) { .article-blocks__featured-model { grid-template-columns: 1fr; } }
  @media (max-width: 39.9375rem) {
    .article-blocks__featured-media, .article-blocks__featured-media img { min-height: 20rem; }
    .article-blocks__featured-copy h3 { font-size: clamp(2.55rem, 13vw, 3.6rem); }
    .article-blocks__product { padding-block: 2.75rem; }
  }
</style>
