---
import type { HomeFinalCtaData } from '../../data/home-live';
const { title, description, primaryCta, secondaryCta, image } = Astro.props as HomeFinalCtaData;
---
<section class="home-final-cta" id="social" data-home-block="final-cta" aria-labelledby="home-final-cta-title">
  <div class="home-final-cta__copy">
    <h2 id="home-final-cta-title">{title}</h2>
    <p>{description}</p>
    <div class="home-final-cta__actions">
      <a class="home-final-cta__button home-final-cta__button--primary" href={primaryCta.href} data-analytics-event="contact_click" data-analytics-block-id="home-final-cta" data-analytics-source="home_final_cta" data-analytics-placement="primary_cta" data-analytics-slug="global">{primaryCta.label}</a>
      <a class="home-final-cta__button" href={secondaryCta.href}>{secondaryCta.label}</a>
    </div>
  </div>
  <div class="home-final-cta__image">
    <img src={image.src} alt={image.alt} width="240" height="240" loading="lazy" decoding="async" />
  </div>
</section>
<style>
  .home-final-cta { display: grid; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; padding: clamp(2rem, 5vw, 4rem); border-radius: 1.75rem; background: var(--kp-blue-deep); color: var(--kp-white); }
  .home-final-cta__copy { display: grid; gap: 1rem; }
  .home-final-cta h2, .home-final-cta p { margin: 0; }
  .home-final-cta h2 { font-family: var(--kp-font-heading); font-size: var(--kp-heading-size); font-weight: var(--kp-heading-weight); line-height: var(--kp-heading-line-height); letter-spacing: 0; }
  .home-final-cta p { max-width: 42rem; color: color-mix(in srgb, var(--kp-white) 86%, transparent); line-height: var(--kp-body-line-height); }
  .home-final-cta__actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1rem; }
  .home-final-cta__button { display: inline-flex; min-height: 2.75rem; align-items: center; justify-content: center; border: .0625rem solid var(--kp-white); border-radius: 62.4375rem; padding: .8rem 1.2rem; background: var(--kp-white); color: var(--kp-ink); font-weight: 700; text-decoration: none; }
  .home-final-cta__button--primary { background: var(--kp-white); color: var(--kp-ink); }
  .home-final-cta__image { display: grid; place-items: center; min-height: 10rem; border-radius: 0; background: transparent; }
  .home-final-cta__image img { width: min(13rem, 60vw); height: auto; object-fit: contain; }
  .home-final-cta__button:focus-visible { outline: .1875rem solid var(--kp-orange); outline-offset: .1875rem; }
  @media (min-width: 60rem) { .home-final-cta { grid-template-columns: minmax(0, .66fr) minmax(12rem, .34fr); } }
  @media (max-width: 39.9375rem) { .home-final-cta { padding: 1.35rem; } .home-final-cta__actions { display: grid; justify-items: start; } }
</style>
