---
interface Props {
  title: string;
  embedLink: string;
  playLink?: string;
  poster?: {
    src: string;
    alt: string;
  };
  caption?: string;
  aspectRatio?: string;
  clickToLoad?: boolean;
}

const { title, embedLink, playLink, poster, caption, aspectRatio = '16 / 9', clickToLoad = false } = Astro.props;
const isAllowedKinescopeEmbed = /^https:\/\/kinescope\.(io|com)\/embed\//.test(embedLink);

if (!isAllowedKinescopeEmbed) {
  throw new Error(`Unsupported Kinescope embed URL for ${title}`);
}
---

<figure class:list={["kp-kinescope-video", clickToLoad && "kp-kinescope-video--click"]} style={`--kp-video-aspect-ratio: ${aspectRatio};`}>
  <div class="kp-kinescope-video__frame">
    {poster?.src ? <img class="kp-kinescope-video__poster" src={poster.src} alt={poster.alt} loading="lazy" /> : null}
    <iframe
      src={clickToLoad ? undefined : embedLink}
      data-kinescope-src={clickToLoad ? embedLink : undefined}
      hidden={clickToLoad}
      title={title}
      loading="lazy"
      allow="autoplay; fullscreen; picture-in-picture; encrypted-media;"
      allowfullscreen
    ></iframe>
    {clickToLoad && <button class="kp-kinescope-video__play" type="button" data-kinescope-load="" aria-label={`Загрузить видео: ${title}`}>▶ Смотреть видео</button>}
  </div>
  {caption ? <figcaption>{caption}</figcaption> : null}
  {playLink ? <a class="kp-kinescope-video__fallback" href={playLink} target="_blank" rel="noopener">Смотреть видео</a> : null}
</figure>

<script is:inline src="/scripts/kinescope-video.js" defer></script>
<style>
  .kp-kinescope-video--click .kp-kinescope-video__poster { opacity: 1; }
  .kp-kinescope-video__play { position: absolute; inset: auto 1rem 1rem; z-index: 1; padding: .85rem 1rem; border: 0; border-radius: .75rem; background: var(--kp-blue); color: white; font: inherit; font-weight: 700; cursor: pointer; }
  .kp-kinescope-video__play:focus-visible { outline: .2rem solid white; outline-offset: .2rem; }
  .kp-kinescope-video__frame iframe[hidden] { display: none; }

  .kp-kinescope-video {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .kp-kinescope-video__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--kp-video-aspect-ratio, 16 / 9);
    border-radius: 1.5rem;
    background: var(--kp-ink-dark);
  }

  .kp-kinescope-video__frame iframe,
  .kp-kinescope-video__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .kp-kinescope-video__poster {
    object-fit: cover;
    opacity: 0;
    pointer-events: none;
  }

  .kp-kinescope-video figcaption {
    color: var(--kp-muted);
    font: 500 0.95rem/1.5 var(--kp-font-body, Montserrat, Arial, sans-serif);
  }

  .kp-kinescope-video__fallback {
    width: fit-content;
    color: var(--kp-blue);
    font-weight: 700;
  }
</style>
