---
import legal from '../../../data/legal/legal-documents.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { webPageJsonLd } from '../../lib/seo';

type LegalSlug = 'privacy-policy' | 'consent' | 'cookie-policy' | 'terms';

interface Props {
  slug: LegalSlug;
  description: string;
  notice: string;
}

const labels: Record<LegalSlug, string> = {
  'privacy-policy': 'Политика обработки персональных данных',
  consent: 'Согласие на обработку персональных данных',
  'cookie-policy': 'Политика cookie',
  terms: 'Пользовательское соглашение',
};

const { slug, description, notice } = Astro.props;
const document = legal.documents.find((entry) => entry.slug === slug);
if (!document) throw new Error(`Missing ${slug} legal document`);

const relatedLinks = (Object.keys(labels) as LegalSlug[])
  .filter((item) => item !== slug)
  .map((item) => ({ href: `/${item}/`, label: labels[item] }));
---

<BaseLayout
  title={`${document.title} — КИБЕР ПОРТАЛ`}
  description={description}
  noindex={true}
  jsonLd={webPageJsonLd({ title: document.title, description, url: `/${slug}/` })}
>
  <main class="legal-page container" id="main-content" tabindex="-1" data-kiber-task="KIBER-48" data-legal-source={document.sourceUrl}>
    <section class="legal-page__hero" aria-labelledby="page-title">
      <p>КИБЕР ПОРТАЛ</p>
      <h1 id="page-title">{document.title}</h1>
      <p>{notice}</p>
    </section>
    <article class="legal-page__body">
      {document.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </article>
    <nav class="legal-page__links" aria-label="Связанные юридические документы">
      {relatedLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </main>
</BaseLayout>

<style>
  .legal-page { display: grid; gap: 2rem; padding-block: var(--kp-section-block); }
  .legal-page__hero, .legal-page__body { display: grid; gap: var(--kp-card-gap); max-width: 56rem; }
  .legal-page__hero p, .legal-page__hero h1, .legal-page__body p { margin: 0; }
  .legal-page__hero > p:first-child { color: var(--kp-blue); font-weight: var(--kp-label-weight); letter-spacing: var(--kp-label-letter-spacing); text-transform: uppercase; }
  .legal-page__hero h1 { font-family: var(--kp-font-heading); font-size: var(--kp-display-size); line-height: var(--kp-display-line-height); }
  .legal-page__hero > p:last-child, .legal-page__body { color: var(--kp-muted); line-height: var(--kp-body-line-height); }
  .legal-page__body { padding: var(--kp-content-padding); border: 0.0625rem solid var(--kp-line); border-radius: 1.5rem; background: var(--kp-surface); }
  .legal-page__links { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .legal-page__links a { display: inline-flex; min-height: 2.75rem; align-items: center; border: 0.0625rem solid var(--kp-line); border-radius: 62.4375rem; padding: 0.75rem 1.1rem; color: var(--kp-blue); font-weight: var(--kp-heading-weight); text-decoration: none; }
</style>
