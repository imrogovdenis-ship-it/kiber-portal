---
const formAction = '/api/leads';
---

<div class="contact-lead-popup ym-hide-content" id="lead-form" data-lead-form-popup hidden>
  <div class="contact-lead-popup__backdrop" data-lead-form-popup-close></div>
  <section class="contact-lead-popup__panel" role="dialog" aria-modal="true" aria-labelledby="contact-lead-popup-title" aria-describedby="contact-lead-popup-description" tabindex="-1">
    <header class="contact-lead-popup__topline">
      <p>Связаться с нами</p>
      <button class="contact-lead-popup__close" type="button" data-lead-form-popup-close aria-label="Закрыть форму заявки">
        <span aria-hidden="true">×</span>
        <span>Закрыть</span>
      </button>
    </header>

    <div class="contact-lead-popup__copy">
      <h2 id="contact-lead-popup-title">Оставьте заявку</h2>
      <p id="contact-lead-popup-description">Наш менеджер свяжется с вами, уточнит задачу и предложит подходящего робота для мероприятия.</p>
    </div>

    <form class="ym-hide-content contact-lead-popup__form" method="post" action={formAction} data-lead-form-popup-form>
      <input type="hidden" name="source_page" value="/" data-lead-form-source-page />
      <input type="hidden" name="robot" value="general" data-lead-form-robot />
      <input type="text" name="website" autocomplete="off" tabindex="-1" aria-hidden="true" class="contact-lead-popup__honeypot" />

      <label>
        <span>Имя *</span>
        <input name="name" autocomplete="name" required placeholder="Иван" />
      </label>

      <label>
        <span>Телефон *</span>
        <input name="contact" autocomplete="tel" inputmode="tel" required placeholder="+7 (___) ___-__-__" />
      </label>

      <label>
        <span>Почта</span>
        <input name="email" autocomplete="email" type="email" placeholder="mail@example.ru" />
      </label>

      <label class="contact-lead-popup__approval">
        <input name="privacy_consent" type="checkbox" value="on" required />
        <span>
          Я даю <a href="/consent/" target="_blank" rel="noopener noreferrer">согласие на обработку персональных данных</a>, принимаю <a href="/privacy-policy/" target="_blank" rel="noopener noreferrer">Политику обработки персональных данных</a> и <a href="/terms/" target="_blank" rel="noopener noreferrer">Пользовательское соглашение</a>.
        </span>
      </label>

      <button type="submit" data-analytics-event="form_submit_intent" data-analytics-source="lead_popup" data-analytics-placement="lead_form" data-analytics-slug="global">Отправить</button>
      <p class="contact-lead-popup__status" data-lead-form-popup-status aria-live="polite"></p>
    </form>
  </section>
</div>
<script is:inline src="/scripts/contact-lead-form-popup.js" defer></script>

<style>
  .contact-lead-popup[hidden] { display: none; }
  .contact-lead-popup { position: fixed; inset: 0; z-index: 1001; display: grid; place-items: center; padding: clamp(1rem, 4vw, 3rem); }
  .contact-lead-popup__backdrop { position: absolute; inset: 0; background: color-mix(in srgb, var(--kp-ink) 72%, transparent); backdrop-filter: blur(.125rem); }
  .contact-lead-popup__panel { position: relative; z-index: 1; box-sizing: border-box; display: grid; width: min(31.5rem, calc(100vw - 2rem)); max-height: min(88vh, 45rem); overflow: auto; gap: clamp(.72rem, 1.7vw, 1.05rem); border-radius: clamp(1.15rem, 2.6vw, 1.8rem); padding: clamp(1rem, 2.7vw, 2.1rem); background: var(--kp-white); color: var(--kp-ink); box-shadow: 0 2rem 5rem color-mix(in srgb, var(--kp-ink) 32%, transparent); }
  .contact-lead-popup__topline { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .contact-lead-popup__topline p, .contact-lead-popup__copy h2, .contact-lead-popup__copy p, .contact-lead-popup__status { margin: 0; }
  .contact-lead-popup__topline p { color: var(--kp-blue); font-size: var(--kp-label-size); font-weight: var(--kp-label-weight); letter-spacing: var(--kp-label-letter-spacing); text-transform: uppercase; }
  .contact-lead-popup__close { display: inline-flex; min-height: 2.05rem; align-items: center; justify-content: center; gap: .46rem; border: .0625rem solid color-mix(in srgb, var(--kp-ink) 12%, transparent); border-radius: 62rem; padding: .38rem .82rem; background: var(--kp-surface); color: var(--kp-ink); font: inherit; font-weight: 700; cursor: pointer; }
  .contact-lead-popup__close span:first-child { font-size: 1.28rem; line-height: .8; }
  .contact-lead-popup__copy { display: grid; gap: .46rem; }
  .contact-lead-popup__copy h2 { font-family: var(--kp-font-heading); font-size: clamp(1.85rem, 4.5vw, 2.65rem); font-weight: var(--kp-heading-weight); line-height: 1; }
  .contact-lead-popup__copy p { color: var(--kp-muted); line-height: var(--kp-body-line-height); }
  .contact-lead-popup__form { display: grid; gap: .66rem; }
  .contact-lead-popup__form label { display: grid; gap: .35rem; color: var(--kp-muted); font-size: .84rem; font-weight: 600; line-height: 1.25; }
  .contact-lead-popup__form input:not([type='checkbox']):not(.contact-lead-popup__honeypot) { box-sizing: border-box; width: 100%; min-height: 2.88rem; border: .0625rem solid var(--kp-line); border-radius: .75rem; padding: .64rem .88rem; background: var(--kp-white); color: var(--kp-ink); font: inherit; }
  .contact-lead-popup__approval { grid-template-columns: auto minmax(0, 1fr); align-items: start; font-size: .72rem; font-weight: 400; }
  .contact-lead-popup__approval input { margin-top: .18rem; accent-color: var(--kp-blue); }
  .contact-lead-popup__approval a { color: var(--kp-blue); text-underline-offset: .16em; }
  .contact-lead-popup__form button[type='submit'] { min-height: 2.85rem; border: 0; border-radius: 62rem; background: var(--kp-blue); color: var(--kp-white); font: inherit; font-weight: 800; cursor: pointer; }
  .contact-lead-popup__form button[type='submit']:disabled { cursor: progress; opacity: .72; }
  .contact-lead-popup__status { min-height: 1.1rem; color: var(--kp-muted); font-size: .78rem; line-height: 1.35; }
  .contact-lead-popup__honeypot { position: absolute; inset-inline-start: -100vw; inset-block-start: 0; box-sizing: border-box; width: .0625rem; max-width: .0625rem; min-width: 0; min-height: .0625rem; height: .0625rem; padding: 0; border: 0; opacity: 0; pointer-events: none; }
  .contact-lead-popup__close:focus-visible, .contact-lead-popup__form input:focus-visible, .contact-lead-popup__form button:focus-visible { outline: .1875rem solid var(--kp-orange); outline-offset: .1875rem; }
  body.contact-lead-popup-open { overflow: hidden; }
  @media (max-width: 47.9375rem) {
    .contact-lead-popup { padding: .75rem; align-items: end; }
    .contact-lead-popup__panel { width: 100%; max-height: 86vh; padding: .86rem; border-radius: 1.35rem; gap: .7rem; }
    .contact-lead-popup__copy h2 { font-size: clamp(1.72rem, 8.2vw, 2.22rem); }
    .contact-lead-popup__form input:not([type='checkbox']):not(.contact-lead-popup__honeypot), .contact-lead-popup__form button[type='submit'] { min-height: 2.75rem; }
  }
</style>
