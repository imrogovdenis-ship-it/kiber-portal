---
import { siteConfig } from '../../config/site';
import type { FooterData } from '../../../design-system/schemas/fixture.schema';

interface Props extends Partial<FooterData> {}
const defaults = {
  logo_label: 'КИБЕР ПОРТАЛ',
  description: 'Аренда роботов для мероприятий в Москве и по всей России.',
  sections: [
    { title: 'Каталог', links: [{ href: '/#catalog', label: 'Все роботы' }, { href: '/roboty-gumanoidy', label: 'Гуманоиды' }, { href: '/roboty-sobaki', label: 'Роботы-собаки' }] },
    { title: 'Контент', links: [{ href: '/compilations', label: 'Подборки' }, { href: '/articles', label: 'Блог' }, { href: '/news', label: 'Новости' }] },
  ],
  messengers: [{ href: siteConfig.telegram, label: 'Telegram' }, { href: siteConfig.whatsapp, label: 'WhatsApp' }],
  legal_notice: `© ${new Date().getUTCFullYear()} КИБЕР ПОРТАЛ · Не является публичной офертой`,
  legal_links: [
    { href: '/privacy-policy', label: 'Политика обработки персональных данных' },
    { href: '/consent', label: 'Согласие на обработку персональных данных' },
    { href: '/cookie-policy', label: 'Политика cookie' },
    { href: '/terms', label: 'Пользовательское соглашение' },
  ],
};
const { logo_label = defaults.logo_label, description = defaults.description, sections = defaults.sections, phone = siteConfig.phone, email = siteConfig.email, messengers = defaults.messengers, legal_notice = defaults.legal_notice, legal_links = defaults.legal_links } = Astro.props;
const phoneHref = `tel:${phone.replace(/[^+\d]/g, '')}`;
---

<footer class="site-footer" data-block="33-footer" data-rv="33">
  <div class="container">
    <div class="site-footer__main">
      <div>
        <a class="site-footer__logo" href="/">{logo_label}</a>
        <p class="site-footer__description">{description}</p>
        <p class="site-footer__region">{siteConfig.region}</p>
      </div>
      {sections.map((section) => <div><h2 class="site-footer__title">{section.title}</h2><ul class="site-footer__nav-list">{section.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul></div>)}
      <div>
        <h2 class="site-footer__title">Контакты</h2>
        <a class="site-footer__phone" href={phoneHref} data-analytics-event="phone_click" data-analytics-source="footer" data-analytics-placement="contacts" data-analytics-slug="global">{phone}</a>
        <a class="site-footer__email" href={`mailto:${email}`} data-analytics-event="contact_click" data-analytics-source="footer" data-analytics-placement="email" data-analytics-slug="global">{email}</a>
        <p class="site-footer__address">{siteConfig.address}</p>
        <div class="site-footer__messengers">{messengers.map((link) => <a href={link.href} aria-label={link.label} data-analytics-event="messenger_click" data-analytics-source="footer" data-analytics-placement="messengers" data-analytics-slug={link.label.toLowerCase()}>{link.label.slice(0, 2).toUpperCase()}</a>)}</div>
      </div>
    </div>
    <div class="site-footer__requisites" aria-label="Реквизиты">
      <span>{siteConfig.legalName}</span>
      <span>ИНН {siteConfig.inn}</span>
      <span>ОГРНИП {siteConfig.ogrnip}</span>
    </div>
    <div class="site-footer__bottom"><div>{legal_notice}</div><div class="site-footer__legal-links">{legal_links.map((link) => <a href={link.href}>{link.label}</a>)}</div></div>
  </div>
</footer>
