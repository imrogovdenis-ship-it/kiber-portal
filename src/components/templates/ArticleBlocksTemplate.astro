---
import { reviewRobotPreviewHref } from '../../lib/review-links';
import HomeFinalCta from '../blocks/HomeFinalCta.astro';
import HomeFaqBlock from '../blocks/HomeFaqBlock.astro';
import HomeGoshaQuote from '../blocks/HomeGoshaQuote.astro';
import HomeImageCards from '../blocks/HomeImageCards.astro';
import RobotCard from '../blocks/RobotCard.astro';
import type { ArticleBlocksTemplateData } from '../../lib/kiber94-article-template-data';

const { template } = Astro.props as { template: ArticleBlocksTemplateData };
const content = template.articleContent;
const reviewRobotCards = template.robots.map((robot) => ({ ...robot, href: reviewRobotPreviewHref(robot.slug, robot.href) }));
const [g1] = reviewRobotCards;
const featuredRobot = content?.product?.featuredSlug ? reviewRobotCards.find((robot) => robot.slug === content.product?.featuredSlug) ?? g1 : g1;
const gallerySliderId = content?.gallery?.sliderId ?? 'robot-article-compilation-gallery';
const articleGalleryImages = content?.gallery?.images ?? reviewRobotCards
  .map((robot) => robot.galleryImage ?? robot.image)
  .filter((image): image is { src: string; alt: string } => Boolean(image))
  .map((image) => ({ src: image.src, alt: image.alt }));
---

<article class="article-blocks" data-kiber-task="KIBER-94" data-page-type="article_detail" data-template-status="owner_design_structure_meaning_approved">
  <section id="hero" class:list={["article-blocks__hero", template.hero.imageAlign === 'right' && "article-blocks__hero--image-right"]} data-block-id="hero" aria-labelledby="page-title">
    <div class="container article-blocks__hero-inner">
      <div class="article-blocks__hero-copy">
        <p class="article-blocks__eyebrow">{template.hero.eyebrow}</p>
        <h1 id="page-title">{template.seo.h1}</h1>
      </div>
      <img class="article-blocks__hero-image" src={template.hero.image.src} alt={template.hero.image.alt} loading="eager" decoding="async" />
      <p class="article-blocks__lead">{template.hero.lead}</p>
    </div>
  </section>

  {(content?.showInventory ?? true) && (
  <section class="article-blocks__toc container" data-block-id="blockInventory" aria-labelledby="inventory-title">
    <div class="article-blocks__section-head">
      <p class="article-blocks__eyebrow">Инвентарь блоков</p>
      <h2 id="inventory-title">Все варианты блоков, которые можно использовать в статьях</h2>
    </div>
    <div class="article-blocks__toc-grid">
      {template.blockVariants.map((block) => (
        <a href={`#${block.id}`} class={`article-blocks__toc-card article-blocks__toc-card--${block.required}`}>
          <span class="article-blocks__toc-label">{block.label}</span>
          <strong>{block.title}</strong>
          <b>{block.required === 'mandatory' ? 'Обязательный блок' : 'Опциональный блок'}</b>
          <em>{block.purpose}</em>
          {block.comment && <small>{block.comment}</small>}
        </a>
      ))}
    </div>
  </section>
  )}

  <section id="seoIntro" class="article-blocks__prose container" data-block-id="seoIntro" aria-labelledby="lead-title">
    <p class="article-blocks__eyebrow">{content?.seoIntro?.eyebrow ?? 'SEO / AI intro'}</p>
    <h2 id="lead-title">{content?.seoIntro?.title ?? 'Затравка статьи без ощущения SEO-простыни'}</h2>
    <div class="article-blocks__prose-copy">
      {(content?.seoIntro?.paragraphs ?? [template.aiSummary]).map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section id="plainText" class="article-blocks__plain-text container" data-block-id="plainText" aria-labelledby="plain-text-title">
    <h2 id="plain-text-title">{content?.plainText?.title ?? 'Как это выглядит на практике?'}</h2>
    <div class="article-blocks__plain-copy">
      {(content?.plainText?.paragraphs ?? [
        'Специалист КИБЕР ПОРТАЛ привозит робота-гуманоида в офис или на площадку праздника, настраивает программу под сценарий — короткое приветствие, поклон, вручение подарка или диплома от лица коллектива — и управляет роботом на протяжении всего выступления. Самостоятельно программировать ничего не нужно: от идеи до выхода робота на сцену обычно достаточно одного брифа с менеджером.',
        'Скажу честно, как и полагается роботу: это не подарок «из коробки», который вручают без подготовки. Гуманоиду нужна ровная площадка без высоких порогов и лестниц, розетка поблизости и присутствие оператора — самостоятельно, без специалиста КИБЕР ПОРТАЛ, робота не арендуют. А ещё на одном заряде он работает около двух часов: для короткого поздравления в начале мероприятия этого хватит с запасом, а для программы на весь день лучше сразу обсудить с менеджером запасной аккумулятор.',
      ]).map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section id="goshaQuote" class="article-blocks__gosha container" data-block-id="goshaQuote" aria-label="Кибер Гоша объясняет структуру статьи">
    <HomeGoshaQuote {...template.gosha} />
  </section>

  <section id="mediaMoment" class="article-blocks__media container" data-block-id="mediaMoment" aria-labelledby="media-title">
    <div class="article-blocks__section-head">
      <p class="article-blocks__eyebrow">{content?.mediaMoment?.eyebrow ?? 'Фото / видео момент'}</p>
      <h2 id="media-title">{content?.mediaMoment?.title ?? 'Вот как выглядит сам момент'}</h2>
      <span>{content?.mediaMoment?.description ?? 'Блок из сценарных статей: один сильный кадр или видео после объяснения, чтобы читатель увидел событие, а не только прочитал описание.'}</span>
    </div>
    <figure>
      <div class="article-blocks__media-frame">
        <img src={content?.mediaMoment?.image.src ?? 'https://static.tildacdn.com/tild3065-3664-4363-b561-616435326462/____.jpg'} alt={content?.mediaMoment?.image.alt ?? 'робот-гуманоид выходит поздравлять директора на мероприятии'} loading="lazy" decoding="async" />
      </div>
      <figcaption>{content?.mediaMoment?.caption ?? 'Гуманоид спокойно выходит к человеку, останавливается, кланяется и запускает тот самый момент, ради которого гости достают телефоны.'}</figcaption>
    </figure>
  </section>

  <section id="robotCardGallery" class="humanoid-template__gallery article-blocks__gallery" data-block-id="robotCardGallery" aria-labelledby="article-gallery-title">
    <div class="container humanoid-template__gallery-head article-blocks__gallery-head">
      <div class="humanoid-template__section-head article-blocks__section-head">
        <p class="humanoid-template__eyebrow article-blocks__eyebrow">{content?.gallery?.eyebrow ?? 'Галерея'}</p>
        <h2 id="article-gallery-title">{content?.gallery?.title ?? 'Галерея для статьи: показать робота до длинного текста'}</h2>
        <span>{content?.gallery?.description ?? 'Блок целиком взят со страницы «Подборка / роботы-гуманоиды»: здесь меняются только фотографии под конкретную статью.'}</span>
      </div>
      <div class="humanoid-template__gallery-nav" aria-label="Навигация по галерее статьи">
        <button class="humanoid-template__gallery-nav-button" type="button" data-slider-prev={`[data-drag-slider='${gallerySliderId}']`} aria-label="Предыдущие фото галереи">‹</button>
        <button class="humanoid-template__gallery-nav-button" type="button" data-slider-next={`[data-drag-slider='${gallerySliderId}']`} aria-label="Следующие фото галереи">›</button>
      </div>
    </div>
    <div class="humanoid-template__drag-gallery humanoid-template__gallery-strip" data-drag-slider={gallerySliderId} aria-label="Галерея шаблона статьи: горизонтальный слайдер как на подборке гуманоидов">
      {articleGalleryImages.map((image, index) => (
        <figure class="humanoid-template__gallery-item">
          <img src={image.src} alt={image.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
        </figure>
      ))}
    </div>
  </section>

  <section id="comparisonBlock" class="article-blocks__comparison container" data-block-id="comparisonBlock" aria-labelledby="comparison-title">
    <div class="article-blocks__section-head">
      <p class="article-blocks__eyebrow">{content?.comparison?.eyebrow ?? 'Сравнение'}</p>
      <h2 id="comparison-title">{content?.comparison?.title ?? 'Кому подходит Unitree G1, а кому — Agibot X2'}</h2>
      <span>{content?.comparison?.description ?? 'Разложили по сценариям, чтобы выбор между Unitree G1 и Agibot X2 занял пару минут, а не пару дней. Слева — типичная ситуация на мероприятии, справа — какой робот обычно закрывает её лучше: без универсальных рецептов, только конкретные комбинации задачи и решения.'}</span>
    </div>
    <div class="article-blocks__comparison-columns">
      {(content?.comparison?.columns ?? [
        { title: 'Выбирайте Unitree G1, если...', paragraphs: ['Вам нужен короткий, эффектный выход на сцену или узнаваемый «технологичный» гость на выставочном стенде — где-то на 15–30 минут внимания, а не на весь день диалогов. G1 хорошо смотрится в статичной демонстрации, на пресс-подходе, при открытии мероприятия или в качестве фотозоны рядом со стендом технологичного бренда.', 'Формат подходит B2B-презентациям, техническим конференциям и открытиям бизнес-центров, где важно произвести впечатление инженерной точностью, а не долгим разговором с каждым гостем.'] },
        { title: 'Выбирайте Agibot X2, если...', paragraphs: ['Вам важно, чтобы гости не просто сфотографировались, а пообщались с роботом: задали вопрос, получили ответ, увидели «эмоцию» на экране. X2 хорошо работает на детских и образовательных мероприятиях, в интерактивной фотозоне и на затяжных форматах вроде целого дня выставки.', 'Формат подходит семейным праздникам, научным шоу и стендам, где нужен не статичный экспонат, а «живой» персонаж, который вовлекает поток посетителей самостоятельно, пока команда бренда занята общением.'] },
      ]).map((column) => <article><h3>{column.title}</h3>{column.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</article>)}
    </div>
    {content?.comparison?.table && (
      <div class="article-blocks__comparison-table" role="region" aria-label="Таблица сравнения характеристик">
        <table>
          <thead><tr>{content.comparison.table.headers.map((header) => <th>{header}</th>)}</tr></thead>
          <tbody>{content.comparison.table.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
        </table>
        {content.comparison.table.note && <p>{content.comparison.table.note}</p>}
      </div>
    )}
  </section>

  <section id="obviousChoice" class="article-blocks__obvious container" data-block-id="obviousChoice" aria-labelledby="obvious-choice-title">
    <div class="article-blocks__section-head">
      <p class="article-blocks__eyebrow">{content?.obviousChoice?.eyebrow ?? 'Выбор'}</p>
      <h2 id="obvious-choice-title">{content?.obviousChoice?.title ?? 'Три сценария, где выбор очевиден'}</h2>
    </div>
    <div class="article-blocks__obvious-grid">
      {(content?.obviousChoice?.cards ?? [
        { number: '1', title: 'Выставочный стенд технологичного бренда', text: 'Здесь выигрывает Unitree G1: чёткая демонстрация и узнаваемый силуэт держат поток посетителей у стенда без долгих разговоров с каждым гостем выставки.' },
        { number: '2', title: 'Детский или образовательный праздник', text: 'Здесь выигрывает Agibot X2: диалог, мимика на дисплее и реакция на прикосновение вовлекают даже самых маленьких гостей мероприятия и их родителей.' },
        { number: '3', title: 'Корпоратив на весь день', text: 'Часто нужны оба формата сразу — короткий эффектный выход Unitree G1 утром и долгий интерактив Agibot X2 в течение всего дня программы.' },
      ]).map((card) => <article><span>{card.number}</span><h3>{card.title}</h3><p>{card.text}</p></article>)}
    </div>
  </section>

  <section id="numberedUseCases" class="article-blocks__numbered container" data-block-id="numberedUseCases" aria-labelledby="scenario-fit-title">
    <div class="article-blocks__section-head">
      <p class="article-blocks__eyebrow">{content?.numberedUseCases?.eyebrow ?? 'Форматы'}</p>
      <h2 id="scenario-fit-title">{content?.numberedUseCases?.title ?? 'Где робот раскрывается лучше всего'}</h2>
      <span>{content?.numberedUseCases?.description ?? 'Формат мероприятия почти не ограничивает робота — важнее задача, которую он закрывает. Вот четыре формата, где он работает особенно хорошо.'}</span>
    </div>
    <div class="article-blocks__numbered-grid">
      {(content?.numberedUseCases?.items ?? [
        { number: '1', title: 'Свадьба', text: 'Развозит напитки и канапе между гостями, попадает в кадр гостевых сторис и снимает часть нагрузки с официантов на банкете.' },
        { number: '2', title: 'Конференция и деловое мероприятие', text: 'Разносит кофе и воду на кофе-брейках, а рекламным экраном на корпусе параллельно продвигает бренд события.' },
        { number: '3', title: 'Фестиваль и городское событие', text: 'Работает на открытых фуд-кортах и в зонах отдыха, где нужно быстро обслужить поток гостей без очередей.' },
        { number: '4', title: 'Корпоратив', text: 'Развозит напитки и закуски по залу, оставляя официантам время на общение с гостями и VIP-зоной.' },
      ]).map((item) => <article><span>{item.number}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}
    </div>
  </section>


  {content?.extraGoshaQuoteAfterNumberedUseCases && (
  <section id="goshaQuoteAfterNumberedUseCases" class="article-blocks__gosha container" data-block-id="goshaQuoteAfterNumberedUseCases" aria-label="Кибер Гоша направляет к менеджеру">
    <HomeGoshaQuote {...template.gosha} text={content.extraGoshaQuoteAfterNumberedUseCases.text} />
  </section>
  )}

  <section id="checkpointList" class="article-blocks__checklist container" data-block-id="checkpointList" aria-labelledby="checklist-title">
    <div class="article-blocks__section-head article-blocks__section-head--wide">
      <p class="article-blocks__eyebrow">{content?.checklist?.eyebrow ?? 'Чек-лист'}</p>
      <h2 id="checklist-title">{content?.checklist?.title ?? 'Чтобы не гадать между двумя классными коллегами, я собрал короткий чек-лист:'}</h2>
      <span>{content?.checklist?.description ?? 'Пройдитесь по нему перед тем, как бронировать робота-гуманоида для своего мероприятия.'}</span>
    </div>
    <div class="article-blocks__checks">
      {(content?.checklist?.items ?? [
        { title: 'Формат внимания', text: 'Нужен короткий эффектный выход на сцену или долгий диалог с гостями весь день мероприятия?' },
        { title: 'Тип аудитории', text: 'Взрослая B2B-аудитория на деловой конференции или семейная публика с детьми на празднике?' },
        { title: 'Длительность программы', text: 'Разовый выход на 20–30 минут или присутствие робота-гуманоида на площадке несколько часов подряд?' },
        { title: 'Площадка', text: 'Ровный пол без порогов, свободное место для движения и розетка 220 В рядом — обязательны для обеих моделей.' },
      ]).map((item) => <article><span aria-hidden="true">✓</span><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}
    </div>
  </section>

  <section id="pairedEnumeration" class="article-blocks__paired-list container" data-block-id="pairedEnumeration" aria-labelledby="format-alternatives-title">
    <div class="article-blocks__section-head">
      <p class="article-blocks__eyebrow">{content?.pairedEnumeration?.eyebrow ?? 'Перечисление'}</p>
      <h2 id="format-alternatives-title">{content?.pairedEnumeration?.title ?? 'Что обычно делают в велком-зоне'}</h2>
      <span>{content?.pairedEnumeration?.description ?? 'Идея с роботом — не замена привычным форматам, а ещё один вариант в ряду уже знакомых.'}</span>
    </div>
    <div class="article-blocks__paired-rows">
      {(content?.pairedEnumeration?.items ?? [
        { title: 'Фотобудка', text: 'Гости фотографируются сами, часто с реквизитом и рамками с именами молодожёнов.' },
        { title: 'Книга или альбом пожеланий', text: 'Гости пишут поздравления, которые молодожёны читают уже после свадьбы.' },
        { title: 'Авторские коктейли и кэнди-бар', text: 'Именной напиток или сладкий стол, который запоминается вкусом, а не действием.' },
        { title: 'Игровое зонирование', text: 'Например, поиск своего стола по игровому принципу вместо обычной рассадки.' },
      ]).map((item) => <article><h3>{item.title}</h3><p>{item.text}</p></article>)}
    </div>
  </section>

  <section id="productCard" class="article-blocks__product container" data-block-id="productCard" aria-labelledby="product-title">
    <div class="article-blocks__section-head">
      <p class="article-blocks__eyebrow">{content?.product?.eyebrow ?? 'Одна рекомендованная модель'}</p>
      <h2 id="product-title">{content?.product?.title ?? 'Когда статья рекомендует конкретного робота'}</h2>
    </div>
    {featuredRobot && (
      <article class="article-blocks__featured-model" aria-labelledby="featured-model-title">
        <a class="article-blocks__featured-media" href={featuredRobot.href} aria-label={`Перейти на страницу ${featuredRobot.title}`}>
          {featuredRobot.image && <img src={featuredRobot.image.src} alt={featuredRobot.image.alt} loading="lazy" decoding="async" />}
        </a>
        <div class="article-blocks__featured-copy">
          <h3 id="featured-model-title">{featuredRobot.title.replace(/^Аренда\s+/i, '')}</h3>
          <p class="article-blocks__featured-category">{featuredRobot.category}</p>
          <p class="article-blocks__featured-price">{featuredRobot.price}</p>
          <p class="article-blocks__featured-description">{featuredRobot.description}</p>
          <a class="article-blocks__featured-button" href={featuredRobot.href}>Перейти на страницу</a>
        </div>
      </article>
    )}
  </section>

  <section id="faq" class="article-blocks__faq container" data-block-id="faq" aria-label="FAQ статьи">
    <HomeFaqBlock title={template.faq.title} items={template.faq.items} />
  </section>

  <section id="cta2" class="article-blocks__cta container" data-block-id="cta2" aria-label="Связаться с КИБЕР ПОРТАЛ">
    <HomeFinalCta {...template.finalCta} variant="robot-card-final" />
  </section>

  <section id="catalogBlock" class="vertical-slice__section vertical-slice__section--catalog container" data-block-id="catalogBlock" aria-labelledby="catalog-title">
    <div class="vertical-slice__section-copy">
      <p>{content?.catalog?.eyebrow ?? 'Каталог роботов'}</p>
      <h2 id="catalog-title">{content?.catalog?.title ?? 'Роботы, которые подходят к теме статьи'}</h2>
      <p>{content?.catalog?.description ?? 'Карточки ведут на модели, которые логично продолжить смотреть после разбора: гуманоиды для сцены, интерактива и вау-эффекта на мероприятии.'}</p>
    </div>
    <div class="vertical-slice__card-grid">
      {reviewRobotCards.slice(0, 4).map((robot) => <RobotCard {...{ ...robot, analytics: { ...robot.analytics, placement: 'related' as const } }} hideDisclaimer={true} hideLink={true} imageLoading="eager" />)}
    </div>
  </section>

  <section id="relatedArticles" class="article-blocks__related container" data-block-id="relatedArticles" aria-label="Тематические статьи">
    <HomeImageCards id="article-template-related" eyebrow={content?.relatedArticles?.eyebrow ?? "Блог Кибер Гоши"} title={content?.relatedArticles?.title ?? "Тематические статьи по аренде роботов"} description={content?.relatedArticles?.description ?? "Блок перелинковки между уже подготовленными и будущими статьями Блога Кибер Гоши."} cards={template.relatedArticles.cards} variant="article" />
  </section>

  <section id="relatedCompilations" class="article-blocks__compilations container" data-block-id="relatedCompilations" aria-label="Подборки по теме статьи">
    <HomeImageCards id="article-template-compilations" eyebrow={content?.relatedCompilations?.eyebrow ?? "Подборки"} title={content?.relatedCompilations?.title ?? "Тематические подборки роботов для аренды"} description={content?.relatedCompilations?.description ?? "Переходы в подборки добавляются там, где они действительно помогают выбрать класс робота или сценарий мероприятия."} cards={template.relatedCompilations.cards} />
  </section>
</article>

<script is:inline src="/scripts/robot-card-gallery.js" defer></script>

<style>
  .article-blocks { display: grid; gap: 0; overflow-x: clip; background: var(--kp-reference-sky); color: var(--kp-reference-ink); }
  .article-blocks section { scroll-margin-top: 6rem; }
  .article-blocks__hero { padding: clamp(4.75rem, 7vw, 7rem) 0 clamp(3.25rem, 5vw, 5rem); background: var(--kp-ink-dark); color: var(--kp-reference-white); }
  .article-blocks__hero-inner { display: grid; grid-template-columns: minmax(0, .9fr) minmax(20rem, .72fr); column-gap: clamp(2rem, 5vw, 5rem); row-gap: clamp(1.4rem, 3vw, 2.4rem); align-items: start; }
  .article-blocks__hero-copy { display: grid; gap: 1rem; }
