---
import type { RobotCardTemplateData } from '../../lib/page-type-templates';

const { template } = Astro.props as { template: RobotCardTemplateData };
const gallery = template.robot.gallery.length > 0 ? template.robot.gallery : [];
const heroImage = gallery[0];
const galleryRest = gallery.slice(1, 5);
const descriptionBlocks = template.bodyBlocks.filter((block) => block.text);
const capabilityItems = template.robot.capabilities.slice(0, 6);
const scenarioItems = template.robot.scenarios.slice(0, 6);
---

<article class="page-template page-template--robot" data-kiber-task="KIBER-94" data-page-type="robot_card">
  <section class="template-hero" data-block-id="hero">
    <div class="template-hero__copy">
      <p class="template-eyebrow">{template.robot.manufacturer ?? 'КИБЕР ПОРТАЛ'} / {template.robot.model ?? template.robot.name}</p>
      <h1>{template.seo.h1}</h1>
      <p class="template-hero__lead">{template.hero.text}</p>
      <p class="template-ai-summary" data-block-id="modelIntro">{template.aiSummary}</p>
      <div class="template-hero__actions">
        <a class="template-button template-button--primary" href={template.cta.href}>{template.cta.label}</a>
        <a class="template-button" href="#robot-card-pricing">Стоимость</a>
      </div>
    </div>
    {heroImage && (
      <figure class="template-hero__media">
        <img src={heroImage.src} alt={heroImage.alt} width="720" height="720" loading="eager" decoding="async" />
      </figure>
    )}
  </section>

  <section class="template-gallery" data-block-id="gallery" aria-label="Галерея">
    {galleryRest.map((image) => <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />)}
  </section>

  <section class="template-section template-section--description" data-block-id="description">
    {descriptionBlocks.map((block) => <article><h2>{block.title}</h2><p>{block.text}</p></article>)}
  </section>

  <section class="template-section" data-block-id="capabilities">
    <div class="template-section__header">
      <p class="template-eyebrow">Возможности</p>
      <h2>Что умеет робот</h2>
    </div>
    <div class="template-facts-grid">
      {capabilityItems.map((item) => <article><span aria-hidden="true">✓</span><p>{item.title ?? item.text}</p></article>)}
    </div>
  </section>

  <section class="template-section" data-block-id="scenarios">
    <div class="template-section__header">
      <p class="template-eyebrow">Сценарии</p>
      <h2>Куда подойдёт</h2>
    </div>
    <ul class="template-checklist">
      {scenarioItems.map((item) => <li>{item.title ?? item.text}</li>)}
    </ul>
  </section>

  <section class="template-section template-section--action" data-block-id="robotInAction">
    <div>
      <p class="template-eyebrow">Робот в действии</p>
      <h2>Демо-блок для фото и видео</h2>
    </div>
    <p>Здесь будет проверенный медиа-сценарий: видео, серия фото или короткое описание выступления после подтверждения прав и источников.</p>
  </section>

  <section class="template-section template-section--pricing" id="robot-card-pricing" data-block-id="pricing">
    <div>
      <p class="template-eyebrow">Стоимость</p>
      <h2>{template.robot.priceDisplay}</h2>
    </div>
    <p>Итоговая смета зависит от даты, города, площадки, длительности и сценария. Цена в preview не является публичной офертой.</p>
  </section>

  <section class="template-gosha" data-block-id="goshaCta">
    <div class="template-gosha__inner">
      <div>
        <p class="template-eyebrow">Кибер Гоша подсказывает</p>
        <h2>Проверим сценарий перед сметой</h2>
      </div>
      <p>{template.cta.note ?? 'Менеджер уточнит площадку, дату, программу и ограничения перед финальной сметой.'}</p>
      <a class="template-button template-button--light" href={template.cta.href}>{template.cta.label}</a>
    </div>
  </section>

  <section class="template-section template-section--faq" data-block-id="faq">
    <div class="template-section__header">
      <p class="template-eyebrow">FAQ</p>
      <h2>Вопросы и ответы</h2>
    </div>
    <div class="template-faq-list">
      {template.faq.map((item) => <details open><summary>{item.question}</summary><p>{item.answer}</p></details>)}
    </div>
  </section>
</article>

<style>
  .page-template--robot {
    display: grid;
    gap: clamp(3rem, 6vw, 5.5rem);
    padding-block: clamp(2rem, 4vw, 3rem) 4.5rem;
    background: var(--kp-reference-sky);
  }

  .template-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, .92fr);
    gap: clamp(1.5rem, 4vw, 3.25rem);
    align-items: center;
  }

  .template-hero__copy,
  .template-section,
  .template-section__header,
  .template-section--description article,
  .template-section--action,
  .template-section--pricing,
  .template-gosha__inner {
    display: grid;
    gap: 1rem;
  }

  .template-eyebrow,
  .template-hero h1,
  .template-hero__lead,
  .template-ai-summary,
  .template-section h2,
  .template-section p,
  .template-section ul,
  .template-gosha h2,
  .template-gosha p,
  .template-hero__media {
    margin: 0;
  }

  .template-eyebrow {
    color: var(--kp-reference-blue);
    font-size: var(--kp-reference-label-size);
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .template-hero h1 {
    max-width: 58rem;
    color: var(--kp-reference-ink);
    font-family: var(--kp-font-heading);
    font-size: clamp(2.65rem, 6vw, var(--kp-reference-display-xl));
    font-weight: 700;
    line-height: .98;
  }

  .template-hero__lead {
    max-width: 42rem;
    color: var(--kp-reference-muted);
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.55;
  }

  .template-ai-summary {
    max-width: 42rem;
    border-left: .25rem solid var(--kp-reference-blue);
    padding-left: 1rem;
    color: var(--kp-reference-muted);
    font-size: .98rem;
    line-height: 1.6;
  }

  .template-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: .25rem;
  }

  .template-button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: .0625rem solid color-mix(in srgb, var(--kp-reference-blue-deep) 18%, transparent);
    border-radius: var(--kp-reference-button-radius);
    padding: .875rem 1.5rem;
    color: var(--kp-reference-blue);
    font-family: var(--kp-font-heading);
    font-size: .875rem;
    font-weight: 700;
    text-decoration: none;
  }

  .template-button--primary {
    border-color: var(--kp-reference-blue);
    background: var(--kp-reference-blue);
    color: var(--kp-reference-white);
  }

  .template-button--light {
    border-color: var(--kp-reference-white);
    background: var(--kp-reference-white);
    color: var(--kp-reference-blue);
  }

  .template-hero__media {
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: 1.5rem;
    background: var(--kp-reference-white);
  }

  .template-hero__media img,
  .template-gallery img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .template-gallery {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(.75rem, 1.4vw, 1.25rem);
  }

  .template-gallery img {
    aspect-ratio: 1;
    border-radius: 1rem;
    background: var(--kp-reference-white);
  }

  .template-section--description,
  .template-facts-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .template-section--description article,
  .template-facts-grid article,
  .template-faq-list details {
    border: .0625rem solid color-mix(in srgb, var(--kp-reference-blue-deep) 10%, transparent);
    border-radius: 1.5rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    background: var(--kp-reference-white);
  }

  .template-section h2,
  .template-gosha h2 {
    color: var(--kp-reference-ink);
    font-family: var(--kp-font-heading);
    font-size: clamp(2rem, 4vw, var(--kp-reference-heading-lg));
    font-weight: 700;
    line-height: 1;
  }

  .template-section p,
  .template-section li,
  .template-gosha p,
  .template-faq-list p {
    color: var(--kp-reference-muted);
    line-height: 1.65;
  }

  .template-facts-grid article {
    align-content: start;
    grid-template-columns: auto 1fr;
  }

  .template-facts-grid span {
    display: grid;
    width: 1.75rem;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 50%;
    background: var(--kp-reference-blue);
    color: var(--kp-reference-white);
    font-weight: 700;
  }

  .template-checklist {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .75rem 1rem;
    padding: 0;
    list-style: none;
  }

  .template-checklist li {
    border-radius: 999rem;
    padding: .8rem 1rem;
    background: var(--kp-reference-white);
  }

  .template-section--action,
  .template-section--pricing,
  .template-gosha__inner {
    border-radius: 1.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .template-section--action {
    background: var(--kp-reference-white);
  }

  .template-section--pricing,
  .template-gosha__inner {
    background: var(--kp-reference-blue-deep);
    color: var(--kp-reference-white);
  }

  .template-section--pricing .template-eyebrow,
  .template-gosha .template-eyebrow,
  .template-section--pricing h2,
  .template-gosha h2,
  .template-section--pricing p,
  .template-gosha p {
    color: var(--kp-reference-white);
  }

  .template-section--pricing h2 {
    font-size: clamp(2.4rem, 5vw, var(--kp-reference-display-m));
  }

  .template-section--pricing p,
  .template-gosha p {
    color: color-mix(in srgb, var(--kp-reference-white) 84%, transparent);
  }

  .template-faq-list {
    display: grid;
    gap: 1rem;
  }

  .template-faq-list summary {
    color: var(--kp-reference-ink);
    cursor: pointer;
    font-family: var(--kp-font-heading);
    font-weight: 700;
  }

  @media (max-width: 59.9375rem) {
    .page-template--robot {
      gap: 3rem;
      padding-block: 1.5rem 3rem;
    }

    .template-hero,
    .template-section--description,
    .template-facts-grid,
    .template-checklist {
      grid-template-columns: 1fr;
    }

    .template-hero__media {
      order: -1;
    }

    .template-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 39.9375rem) {
    .template-hero h1 {
      font-size: clamp(2.35rem, 12vw, 3.5rem);
    }

    .template-hero__actions {
      display: grid;
      justify-items: start;
    }

    .template-button {
      width: auto;
      max-width: 100%;
      padding-inline: 1.25rem;
    }
  }
</style>
