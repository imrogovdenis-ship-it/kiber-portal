---
import type { RobotCardTemplateData } from '../../lib/page-type-templates';
import RobotCard from '../blocks/RobotCard.astro';
import HomeGoshaQuote from '../blocks/HomeGoshaQuote.astro';
import HomeImageCards from '../blocks/HomeImageCards.astro';
import HomeFaqBlock from '../blocks/HomeFaqBlock.astro';
import HomeFinalCta from '../blocks/HomeFinalCta.astro';
import { getRobotPages } from '../../lib/robot-pages';
import { homeArticles, homeFinalCta, homeGosha } from '../../data/home-live';
import type { RobotCardData } from '../../../design-system/schemas/fixture.schema';

const { template } = Astro.props as { template: RobotCardTemplateData };
const gallery = template.robot.gallery.length > 0 ? template.robot.gallery : [];
const heroImage = gallery[0];
const primaryGallery = (gallery.length > 1 ? gallery.slice(1, 6) : gallery).slice(0, 5);
const actionGallery = (gallery.length > 3 ? gallery.slice(3, 8) : gallery.slice(1, 6).length > 0 ? gallery.slice(1, 6) : gallery).slice(0, 5);
const descriptionBlocks = template.bodyBlocks.filter((block) => block.text);
const introText = descriptionBlocks[0]?.text;
const capabilityItems = template.robot.capabilities.slice(0, 6);
const scenarioItems = template.robot.scenarios.slice(0, 6);

const categoryLabels: Record<string, string> = {
  humanoid: 'Робот-гуманоид',
  robot_dog: 'Робот-собака',
  service_robot: 'Робот-официант',
  media_robot: 'Робот для съёмки',
  coffee_robot: 'Робо-кофейня',
};
const robotTypeAccusativeByCategory: Record<string, string> = {
  humanoid: 'робота-гуманоида',
  robot_dog: 'робота-собаку',
  service_robot: 'робота-официанта',
  media_robot: 'робота для съёмки',
  coffee_robot: 'робо-кофейню',
};
const robotTypeAccusative = robotTypeAccusativeByCategory[template.robot.category ?? ''] ?? 'робота';
const heroTitle = `Аренда ${robotTypeAccusative} ${template.robot.name}`;
const quickCtaTitle = `Арендуйте ${robotTypeAccusative} ${template.robot.name} для мероприятия`;
const leadHref = `/lead/request/?robot=${template.seo.canonical.split('/').filter(Boolean).at(-1) ?? template.robot.name}&source=kiber94-preview`;

const featuredSlugs = ['arenda-unitree-g1', 'arenda-agibot-x2', 'arenda-xiaomi-cyberdog-2', 'arenda-bellabot'];
const relatedRobots = getRobotPages()
  .filter((robot) => featuredSlugs.includes(robot.slug))
  .sort((a, b) => {
    const categoryBias = Number(b.category === template.robot.category) - Number(a.category === template.robot.category);
    if (categoryBias !== 0) return categoryBias;
    return featuredSlugs.indexOf(a.slug) - featuredSlugs.indexOf(b.slug);
  })
  .slice(0, 4)
  .map((robot, index) => ({
    slug: robot.slug,
    href: robot.route,
    title: robot.identity.name,
    category: categoryLabels[robot.category] ?? 'Робот для мероприятий',
    price: robot.pricing.display,
    price_disclaimer: robot.pricing.disclaimer as RobotCardData['price_disclaimer'],
    description: robot.seo.description.slice(0, 132),
    badge: robot.identity.name === template.robot.name ? 'Сейчас смотрим' : (index === 0 ? 'Похожая модель' : undefined),
    image: robot.media.hero,
    analytics: { event: 'robot_card_click' as const, placement: 'catalog' as const, position: index + 1 },
  }));

const priceStatusLabel = template.robot.priceStatus === 'request'
  ? 'стоимость подтверждает менеджер'
  : 'стоимость требует ручной проверки';
const serviceFacts = [
  { label: 'Модель', value: template.robot.model ?? template.robot.name },
  { label: 'Тип робота', value: robotTypeAccusative.replace('робота-', '').replace('робота ', '') },
  { label: 'Формат', value: 'аренда робота для мероприятия' },
  { label: 'Сервис', value: 'оператор, настройка и сценарий под площадку' },
  { label: 'География', value: 'Москва и выездные мероприятия по РФ после согласования' },
  { label: 'Цена', value: `${template.robot.priceDisplay}; ${priceStatusLabel}` },
];
const hiddenMachineFacts = {
  pageType: 'robot_card',
  robot: template.robot.name,
  category: template.robot.category,
  price: template.robot.priceDisplay,
  priceStatus: template.robot.priceStatus,
  facts: serviceFacts,
};
const includedService = [
  'подберём сценарий использования робота под событие и аудиторию',
  'привезём робота, подготовим площадку и проверим технические ограничения',
  'оператор КИБЕР ПОРТАЛА сопровождает программу на мероприятии',
  'заранее согласуем длительность, выходы робота, паузы и подзарядку',
];
const orderFlow = [
  'Вы пишете нам и называете робота, дату, город и формат мероприятия.',
  'Менеджер уточняет площадку, аудиторию, сценарий, тайминг и ограничения.',
  'Мы подтверждаем доступность, считаем стоимость и предлагаем безопасный формат.',
  'В день события привозим, настраиваем и сопровождаем робота на площадке.',
];

const aiSummary = template.aiSummary;
const robotQuickCta = {
  ...homeFinalCta,
  title: quickCtaTitle,
  description: '',
  primaryCta: { label: 'Написать нам', href: '/contacts/' },
  secondaryCta: { label: 'Оставить заявку', href: leadHref },
};
const robotFinalCta = {
  ...homeFinalCta,
  title: 'Остались вопросы?',
  description: `Кибер Гоша и команда КИБЕР ПОРТАЛ помогут понять, подойдёт ли ${template.robot.name} под вашу площадку, аудиторию и тайминг.`,
  primaryCta: { label: 'Написать нам', href: '/contacts/' },
  secondaryCta: { label: 'Оставить заявку', href: leadHref },
};
const robotGosha = {
  ...homeGosha,
  text: `— Я бы сказал, что ${template.robot.name} — это не «человек в костюме», а костюм будущего, который сам пришёл знакомиться с гостями.\n\nЕсли хотите понять, подойдёт ли он под вашу площадку, напишите менеджеру: команда КИБЕР ПОРТАЛ проверит дату, сценарий, тайминг, логистику и рассчитает стоимость без роботических сюрпризов.`
};
const robotFaq = {
  title: 'Вопросы и ответы (FAQ)',
  items: template.faq.map(({ question, answer }) => ({ question, answer })),
};
const robotArticles = {
  ...homeArticles,
  title: `Блог Кибер Гоши про ${template.robot.name} и роботов для событий`,
  description: `Подбираем материалы о сценариях, аренде и подготовке мероприятий, где ${template.robot.name} или похожие роботы помогают сделать шоу, промо-зону и фотоконтент заметнее.`,
  cards: homeArticles.cards.slice(0, homeArticles.cards.length >= 6 ? 6 : 3),
};
const robotCatalogTitle = 'Вас также могут заинтересовать';
const robotCatalogDescription = 'Роботов из этого списка чаще всего заказывают для выставок, корпоративов, промо-акций, свадеб и детских праздников. Все модели — из собственного парка КИБЕР ПОРТАЛ, с доставкой и настройкой под ваш сценарий.';
---

<article class="page-template page-template--robot" data-kiber-task="KIBER-94" data-page-type="robot_card">
  <section class="template-live-hero template-live-hero--dark" data-block-id="hero" aria-labelledby="robot-card-hero-title">
    <div class="template-live-hero__content">
      <p class="template-live-hero__eyebrow">КИБЕР ПОРТАЛ · аренда роботов</p>
      <h1 id="robot-card-hero-title">{heroTitle}</h1>
      <p>{template.robot.priceDisplay}</p>
      <div class="template-live-hero__actions">
        <a class="template-hero-button template-hero-button--primary" href="/contacts/">Написать нам</a>
        <a class="template-hero-button template-hero-button--light" href={leadHref}>Оставить заявку</a>
      </div>
    </div>
    {heroImage && (
      <figure class="template-live-hero__media">
        <img src={heroImage.src} alt={heroImage.alt} loading="eager" decoding="async" />
      </figure>
    )}
  </section>

  <section class="template-ai-summary" data-block-id="aiSummary" aria-label="Краткое описание страницы для гостей, поисковиков и AI-агентов">
    <p><strong>{aiSummary}</strong></p>
  </section>

  <section id="robot-card-gallery" class="template-live-gallery" data-block-id="gallery" aria-labelledby="robot-card-gallery-title">
    <div class="template-section-copy template-section-copy--gallery">
      <p>Галерея</p>
      <h2 id="robot-card-gallery-title">Посмотрите, как выглядит {template.robot.name}</h2>
    </div>
    <div class="template-drag-gallery template-live-gallery__strip" data-drag-slider="robot-gallery" aria-label={`Галерея ${template.robot.name}: горизонтальный слайдер`}>
      {primaryGallery.map((image, index) => (
        <figure class="template-live-gallery__item">
          <img src={image.src} alt={image.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
          <figcaption>{index + 1} из {primaryGallery.length}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="template-live-intro" data-block-id="description" aria-labelledby="robot-card-text-title">
    <h2 id="robot-card-text-title">{template.robot.name} на мероприятии</h2>
    {introText && <p>{introText}</p>}
  </section>

  <section class="template-section" data-block-id="capabilities" aria-labelledby="robot-card-capabilities-title">
    <p class="template-section__number">01 — ключевые возможности</p>
    <h2 id="robot-card-capabilities-title">{`Что умеет ${template.robot.name}`}</h2>
    <p class="template-section__lead">Возможности показываем как продающие сценарные преимущества, но без неподтверждённых обещаний: факты идут из текущей карточки робота.</p>
    <div class="template-feature-grid">
      {capabilityItems.map((item, index) => (
        <article>
          {gallery[index % Math.max(gallery.length, 1)] && <img src={gallery[index % gallery.length].src} alt="" loading="lazy" decoding="async" />}
          <h3>{item.title ?? item.text}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="template-section" data-block-id="scenarios" aria-labelledby="robot-card-scenarios-title">
    <p class="template-section__number">02 — сценарии использования</p>
    <h2 id="robot-card-scenarios-title">{`Где ${template.robot.name} произведёт «вау-эффект»?`}</h2>
    <p class="template-section__lead">Сценарии помогают посетителю быстро понять, подойдёт ли робот под его событие, а AI-агенту — связать модель с реальными event-задачами.</p>
    <div class="template-scenario-grid">
      {scenarioItems.map((item) => <article><h3>{item.title ?? item.text}</h3><p>{item.text}</p></article>)}
    </div>
  </section>

  <section class="template-section template-action-gallery" data-block-id="robotInAction" aria-labelledby="robot-card-action-title">
    <div class="template-section-copy template-section-copy--gallery">
      <p>03 — робот в действии</p>
      <h2 id="robot-card-action-title">Покажите гостям движение, общение и фото-контент</h2>
    </div>
    <div class="template-drag-gallery template-action-gallery__strip" data-drag-slider="robot-action-gallery" aria-label={`${template.robot.name} в действии: горизонтальный слайдер`}>
      {actionGallery.map((image, index) => (
        <figure>
          <img src={image.src} alt={image.alt} loading="lazy" decoding="async" draggable="false" />
          <figcaption>{index + 1} / {actionGallery.length}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="template-reused-block" data-block-id="goshaCta">
    <HomeGoshaQuote {...robotGosha} />
  </section>

  <section class="template-reused-block template-reused-block--cta template-reused-block--quick-cta" id="robot-card-pricing" data-block-id="pricing">
    <HomeFinalCta {...robotQuickCta} />
  </section>

  <section id="robot-card-included" class="template-section template-included-service" data-block-id="includedService" aria-labelledby="robot-card-included-title">
    <div class="template-section-copy">
      <p class="template-section__number">04 — что входит</p>
      <h2 id="robot-card-included-title">Не просто робот, а готовый event-сервис</h2>
      <span>Клиенту не нужно самостоятельно программировать или запускать робота: задача КИБЕР ПОРТАЛА — превратить модель в понятный сценарий для события.</span>
    </div>
    <ul class="template-check-list template-check-list--cards">
      {includedService.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <script is:inline type="application/json" data-block-id="hiddenMachineFacts" set:html={JSON.stringify(hiddenMachineFacts)} />

  <section class="template-section template-order-flow" data-block-id="orderFlow" aria-labelledby="robot-card-order-flow-title">
    <div class="template-section-copy">
      <p class="template-section__number">05 — как заказать</p>
      <h2 id="robot-card-order-flow-title">Что произойдёт после заявки</h2>
      <span>Показываем прозрачный процесс, чтобы убрать тревогу перед обращением и объяснить, почему финальная стоимость подтверждается менеджером.</span>
    </div>
    <ol class="template-order-list template-order-list--wide">
      {orderFlow.map((item) => <li>{item}</li>)}
    </ol>
  </section>

  <section class="template-reused-block" data-block-id="faq">
    <HomeFaqBlock {...robotFaq} />
  </section>

  <section class="template-reused-block template-reused-block--cta" data-block-id="finalQuestionsCta">
    <HomeFinalCta {...robotFinalCta} />
  </section>

  <section class="template-reused-block" data-block-id="articles">
    <HomeImageCards id="articles" eyebrow="Блог Кибер Гоши" variant="article" {...robotArticles} />
  </section>

  <section id="robot-card-related-catalog" class="template-related-catalog" aria-labelledby="robot-card-related-catalog-title" data-block-id="relatedCatalog">
    <div class="template-section-copy">
      <p>Каталог роботов</p>
      <h2 id="robot-card-related-catalog-title">{robotCatalogTitle}</h2>
      <span>{robotCatalogDescription}</span>
    </div>
    <div class="template-related-catalog__grid">
      {relatedRobots.map((robot) => <RobotCard {...robot} hideDisclaimer={true} hideLink={true} imageLoading="eager" />)}
    </div>
  </section>
</article>

<script>
  document.querySelectorAll<HTMLElement>('[data-drag-slider^="robot-"]').forEach((slider) => {
    let isDown = false;
    let startX = 0;
    let startScroll = 0;
    let moved = 0;

    slider.querySelectorAll('a, img').forEach((item) => {
      item.setAttribute('draggable', 'false');
      item.addEventListener('dragstart', (event) => event.preventDefault());
    });

    const pageX = (event: MouseEvent | TouchEvent) => ('touches' in event ? (event.touches[0]?.pageX ?? startX) : event.pageX);

    const start = (event: MouseEvent | TouchEvent) => {
      if ('button' in event && event.button !== 0) return;
      isDown = true;
      moved = 0;
      startX = pageX(event);
      startScroll = slider.scrollLeft;
      slider.classList.add('is-dragging');
      event.preventDefault();
    };

    const move = (event: MouseEvent | TouchEvent) => {
      if (!isDown) return;
      const dx = pageX(event) - startX;
      moved = Math.max(moved, Math.abs(dx));
      slider.scrollLeft = startScroll - dx;
      event.preventDefault();
    };

    const stop = () => {
      if (!isDown) return;
      isDown = false;
      slider.classList.remove('is-dragging');
    };

    slider.addEventListener('mousedown', start);
    window.addEventListener('mousemove', move, { passive: false });
    window.addEventListener('mouseup', stop);
    slider.addEventListener('touchstart', start, { passive: false });
    window.addEventListener('touchmove', move, { passive: false });
    window.addEventListener('touchend', stop);
    slider.addEventListener('click', (event) => {
      if (moved > 5) {
        event.preventDefault();
        event.stopPropagation();
        moved = 0;
      }
    }, true);
  });
</script>

<style>
  .page-template--robot {
    display: grid;
    gap: clamp(3.5rem, 6vw, 6rem);
    padding-block: clamp(1.25rem, 2.4vw, 2rem) 4.5rem;
    background: var(--kp-reference-sky);
  }

  .template-live-hero {
    display: grid;
    --robot-card-hero-title-scale: .9;
    --robot-card-hero-media-height: 95%;
    --robot-card-hero-media-bleed: clamp(2.6rem, 3.2vw, 3.2rem);
    --robot-card-hero-block-inset: clamp(1rem, 1.6vw, 1.45rem);
    --robot-card-hero-inline-inset: clamp(1.5rem, 3.2vw, 3.35rem);
    --robot-card-hero-media-edge-inset: calc(var(--robot-card-hero-block-inset) * .65);
    grid-template-columns: minmax(0, .84fr) minmax(27rem, .96fr);
    gap: var(--robot-card-hero-inline-inset);
    align-items: stretch;
    overflow: hidden;
    border-radius: 1.625rem;
    padding: var(--robot-card-hero-block-inset) var(--robot-card-hero-media-edge-inset) var(--robot-card-hero-block-inset) var(--robot-card-hero-inline-inset);
    background: var(--kp-reference-ink-dark);
    box-shadow: none;
    color: var(--kp-reference-white);
  }

  .template-live-hero--dark {
    background: linear-gradient(135deg, var(--kp-reference-ink-dark) 0%, color-mix(in srgb, var(--kp-reference-ink-dark) 82%, var(--kp-reference-white)) 100%);
  }

  .template-live-hero__content {
    display: grid;
    justify-items: start;
    align-content: center;
    gap: 1.35rem;
    max-width: 46rem;
    text-align: left;
  }

  .template-live-hero__media {
    display: grid;
    align-self: center;
    height: calc(var(--robot-card-hero-media-height) + var(--robot-card-hero-media-bleed));
    min-height: 0;
    place-items: center;
    margin: 0;
    overflow: hidden;
    border-radius: 1.45rem;
    background: var(--kp-reference-white);
  }

  .template-live-hero__media img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: clamp(24rem, 38vw, 34rem);
    aspect-ratio: 1 / 1;
    object-fit: contain;
    object-position: center;
  }

  .template-live-hero__eyebrow,
  .template-live-hero h1,
  .template-live-hero p,
  .template-live-intro h2,
  .template-live-intro p,
  .template-ai-summary p,
  .template-section h2,
  .template-section h3,
  .template-section p,
  .template-section__number,
  .template-section-copy p,
  .template-section-copy h2,
  .template-section-copy span,
  .template-check-list,
  .template-order-list {
    margin: 0;
  }

  .template-live-hero h1 {
    color: var(--kp-reference-white);
    font-family: var(--kp-font-heading);
    font-size: clamp(calc(2.9rem * var(--robot-card-hero-title-scale)), calc(6.1vw * var(--robot-card-hero-title-scale)), calc(4.65rem * var(--robot-card-hero-title-scale)));
    font-weight: 700;
    line-height: .98;
  }

  .template-live-hero p:not(.template-live-hero__eyebrow) {
    max-width: 38rem;
    color: color-mix(in srgb, var(--kp-reference-white) 90%, transparent);
    font-family: var(--kp-font-heading);
    font-size: clamp(1.35rem, 2.1vw, 1.85rem);
    font-weight: 700;
    line-height: 1.15;
  }

  .template-live-hero__eyebrow,
  .template-section__number,
  .template-section-copy p:first-child {
    color: var(--kp-reference-blue);
    font-size: var(--kp-reference-label-size);
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .template-live-hero__eyebrow {
    color: var(--kp-reference-white);
  }

  .template-live-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: flex-start;
  }

  .template-hero-button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: .0625rem solid transparent;
    border-radius: 999rem;
    padding: .875rem 1.65rem;
    font-family: var(--kp-font-heading);
    font-size: .875rem;
    font-weight: 700;
    text-decoration: none;
  }

  .template-hero-button--primary {
    background: var(--kp-reference-white);
    color: var(--kp-reference-blue);
  }

  .template-hero-button--light {
    border-color: var(--kp-reference-blue);
    background: var(--kp-reference-blue);
    color: var(--kp-reference-white);
  }

  .template-live-intro,
  .template-section,
  .template-live-gallery,
  .template-related-catalog,
  .template-reused-block,
  .template-ai-summary {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  .template-ai-summary,
  .template-live-intro {
    max-width: 72rem;
  }

  .template-ai-summary {
    gap: .65rem;
    border-radius: 1.15rem;
    padding: .35rem 0;
    background: transparent;
    color: var(--kp-reference-ink);
  }

  .template-ai-summary p {
    margin: 0;
    color: var(--kp-reference-ink);
    font-size: clamp(1.18rem, 1.65vw, 1.38rem);
    font-weight: 700;
    line-height: 1.45;
  }

  .template-ai-summary strong {
    font: inherit;
  }

  .template-drag-gallery {
    display: flex;
    gap: clamp(.85rem, 1.5vw, 1.15rem);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    cursor: grab;
    user-select: none;
    touch-action: pan-y;
