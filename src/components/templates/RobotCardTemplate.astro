---
import type { RobotCardTemplateData } from '../../lib/page-type-templates';
import RobotCard from '../blocks/RobotCard.astro';
import HomeGoshaQuote from '../blocks/HomeGoshaQuote.astro';
import HomeImageCards from '../blocks/HomeImageCards.astro';
import HomeFaqBlock from '../blocks/HomeFaqBlock.astro';
import HomeFinalCta from '../blocks/HomeFinalCta.astro';
import { getRobotPages } from '../../lib/robot-pages';
import { homeArticles, homeFinalCta, homeGosha } from '../../data/home-live';
import type { RobotCardData } from '../../../design-system/schemas/fixture.schema';

const { template } = Astro.props as { template: RobotCardTemplateData };
const gallery = template.robot.gallery.length > 0 ? template.robot.gallery : [];
const heroImage = gallery[0];
const descriptionBlocks = template.bodyBlocks.filter((block) => block.text);
const introTitle = template.robot.name;
const introText = descriptionBlocks[0]?.text ?? template.hero.text;
const followupText = descriptionBlocks[1]?.text;
const capabilityItems = template.robot.capabilities.slice(0, 6);
const scenarioItems = template.robot.scenarios.slice(0, 6);

const categoryLabels: Record<string, string> = {
  humanoid: 'Робот-гуманоид',
  robot_dog: 'Робот-собака',
  service_robot: 'Робот-официант',
  media_robot: 'Робот для съёмки',
  coffee_robot: 'Робо-кофейня',
};
const featuredSlugs = ['arenda-unitree-g1', 'arenda-agibot-x2', 'arenda-xiaomi-cyberdog-2', 'arenda-bellabot'];
const relatedRobots = getRobotPages()
  .filter((robot) => featuredSlugs.includes(robot.slug))
  .sort((a, b) => featuredSlugs.indexOf(a.slug) - featuredSlugs.indexOf(b.slug))
  .slice(0, 4)
  .map((robot, index) => ({
    slug: robot.slug,
    href: robot.route,
    title: robot.identity.name,
    category: categoryLabels[robot.category] ?? 'Робот для мероприятий',
    price: robot.pricing.display,
    price_disclaimer: robot.pricing.disclaimer as RobotCardData['price_disclaimer'],
    description: robot.seo.description.slice(0, 132),
    badge: robot.identity.name === template.robot.name ? 'Сейчас смотрим' : (index === 0 ? 'Популярный выбор' : undefined),
    image: robot.media.hero,
    analytics: { event: 'robot_card_click' as const, placement: 'catalog' as const, position: index + 1 },
  }));

const robotFinalCta = {
  ...homeFinalCta,
  title: `Арендуйте ${template.robot.name} для мероприятия`,
  description: `${template.robot.priceDisplay}. ${template.cta.note ?? homeFinalCta.description}`,
  primaryCta: { label: 'Написать нам', href: '/contacts/' },
  secondaryCta: { label: 'Смотреть каталог', href: '#robot-card-related-catalog' },
};

const robotGosha = {
  ...homeGosha,
  text: `— Подскажу честно, как робот человеку.\n\n${template.cta.note ?? 'Менеджеры КИБЕР ПОРТАЛ подберут сценарий, рассчитают стоимость и обсудят все детали площадки заранее.'}`,
};

const robotFaq = {
  title: 'Вопросы и ответы (FAQ)',
  items: template.faq.map(({ question, answer }) => ({ question, answer })),
};
---

<article class="page-template page-template--robot" data-kiber-task="KIBER-94" data-page-type="robot_card">
  <section class="template-live-hero" data-block-id="hero" style={heroImage ? `--template-hero-image: url('${heroImage.src}')` : undefined}>
    <div class="template-live-hero__scrim" aria-hidden="true"></div>
    <div class="template-live-hero__content">
      <h1>{template.seo.h1}</h1>
      <div class="template-live-hero__actions">
        <a class="template-hero-button template-hero-button--primary" href="/contacts/">Написать нам</a>
        <a class="template-hero-button template-hero-button--light" href="#robot-card-pricing">Стоимость</a>
      </div>
    </div>
  </section>

  <section class="template-live-intro" data-block-id="description" aria-labelledby="robot-card-intro-title">
    <h2 id="robot-card-intro-title">{introTitle}</h2>
    <p class="template-live-intro__lead" data-block-id="modelIntro">— {template.hero.text}</p>
    {introText && <p>{introText}</p>}
    {followupText && <p>{followupText}</p>}
  </section>

  <section class="template-live-gallery" data-block-id="gallery" aria-label="Галерея">
    {heroImage && <img src={heroImage.src} alt={heroImage.alt} loading="lazy" decoding="async" />}
    <div class="template-live-gallery__arrows" aria-hidden="true"><span>‹</span><span>›</span></div>
  </section>

  <section class="template-section" data-block-id="capabilities" aria-labelledby="robot-card-capabilities-title">
    <p class="template-section__number">01 — ключевые возможности</p>
    <h2 id="robot-card-capabilities-title">{`Что умеет ${template.robot.name}`}</h2>
    <p class="template-section__lead">Если коротко, робот закрывает ключевые сценарии мероприятия. Подробнее — в шести пунктах ниже.</p>
    <div class="template-feature-grid">
      {capabilityItems.map((item) => (
        <article>
          {heroImage && <img src={heroImage.src} alt="" loading="lazy" decoding="async" />}
          <h3>{item.title ?? item.text}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="template-section" data-block-id="scenarios" aria-labelledby="robot-card-scenarios-title">
    <p class="template-section__number">02 — сценарии использования</p>
    <h2 id="robot-card-scenarios-title">{`Где ${template.robot.name} произведёт «вау-эффект»?`}</h2>
    <p class="template-section__lead">Каждый сценарий адаптируется под задачу заказчика — от короткого приветствия гостей до полноценного шоу с несколькими выходами робота в течение дня.</p>
    <div class="template-scenario-grid">
      {scenarioItems.map((item) => <article><h3>{item.title ?? item.text}</h3><p>{item.text}</p></article>)}
    </div>
  </section>

  <section class="template-reused-block template-reused-block--cta" id="robot-card-pricing" data-block-id="pricing">
    <HomeFinalCta {...robotFinalCta} />
  </section>

  <section class="template-reused-block" data-block-id="robotInAction">
    <div data-block-id="goshaCta">
      <HomeGoshaQuote {...robotGosha} />
    </div>
  </section>

  <section id="robot-card-related-catalog" class="template-related-catalog" aria-labelledby="robot-card-related-catalog-title" data-block-id="relatedCatalog">
    <div class="template-section-copy">
      <p>Каталог роботов</p>
      <h2 id="robot-card-related-catalog-title">Популярные модели для мероприятий</h2>
      <p>Этот блок переиспользует готовые карточки каталога с главной страницы.</p>
    </div>
    <div class="template-related-catalog__grid">
      {relatedRobots.map((robot) => <RobotCard {...robot} hideDisclaimer={true} hideLink={true} imageLoading="eager" />)}
    </div>
  </section>

  <section class="template-reused-block" data-block-id="faq">
    <HomeFaqBlock {...robotFaq} />
  </section>

  <HomeImageCards id="articles" eyebrow="Блог Кибер Гоши" variant="article" {...homeArticles} />
</article>

<style>
  .page-template--robot {
    display: grid;
    gap: clamp(3.5rem, 6vw, 6rem);
    padding-block: clamp(1.25rem, 2.4vw, 2rem) 4.5rem;
    background: var(--kp-reference-sky);
  }

  .template-live-hero {
    position: relative;
    display: grid;
    min-height: clamp(24rem, 40vw, 30rem);
    place-items: center;
    overflow: hidden;
    border-radius: 1.625rem;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--kp-reference-ink) 80%, transparent), color-mix(in srgb, var(--kp-reference-ink) 38%, transparent)),
      var(--template-hero-image, none),
      var(--kp-reference-blue-deep);
    background-position: center;
    background-size: cover;
    box-shadow: none;
    color: var(--kp-reference-white);
    isolation: isolate;
  }

  .template-live-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(circle at 50% 22%, transparent 0 22%, color-mix(in srgb, var(--kp-reference-ink) 18%, transparent) 58%);
  }

  .template-live-hero__content {
    display: grid;
    justify-items: center;
    gap: 2rem;
    max-width: 54rem;
    padding: clamp(2rem, 5vw, 4rem);
    text-align: center;
  }

  .template-live-hero h1,
  .template-live-intro h2,
  .template-live-intro p,
  .template-section h2,
  .template-section h3,
  .template-section p,
  .template-section__number,
  .template-section-copy p,
  .template-section-copy h2 {
    margin: 0;
  }

  .template-live-hero h1 {
    color: var(--kp-reference-white);
    font-family: var(--kp-font-heading);
    font-size: clamp(3rem, 6.6vw, 4.75rem);
    font-weight: 700;
    line-height: .98;
  }

  .template-live-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: center;
  }

  .template-hero-button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: .0625rem solid transparent;
    border-radius: 999rem;
    padding: .875rem 1.65rem;
    font-family: var(--kp-font-heading);
    font-size: .875rem;
    font-weight: 700;
    text-decoration: none;
  }

  .template-hero-button--primary {
    background: var(--kp-reference-blue);
    color: var(--kp-reference-white);
  }

  .template-hero-button--light {
    background: var(--kp-reference-white);
    color: var(--kp-reference-ink);
  }

  .template-live-intro,
  .template-section,
  .template-live-gallery,
  .template-related-catalog,
  .template-reused-block {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  .template-live-gallery {
    min-height: 3rem;
    align-items: end;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .template-live-gallery img {
    width: 100%;
    height: .0625rem;
    object-fit: cover;
    opacity: .28;
  }

  .template-live-gallery__arrows {
    display: flex;
    gap: .5rem;
  }

  .template-live-gallery__arrows span {
    display: grid;
    width: 2rem;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 50%;
    background: var(--kp-reference-blue);
    color: var(--kp-reference-white);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .template-live-intro {
    max-width: 70rem;
  }

  .template-live-intro h2,
  .template-section h2,
  .template-section-copy h2 {
    color: var(--kp-reference-ink);
    font-family: var(--kp-font-heading);
    font-size: clamp(2.4rem, 5vw, var(--kp-reference-heading-lg));
    font-weight: 700;
    line-height: 1;
  }

  .template-live-intro p,
  .template-section__lead,
  .template-feature-grid p,
  .template-scenario-grid p,
  .template-section-copy p:last-child {
    color: var(--kp-reference-muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .template-live-intro__lead {
    max-width: 49rem;
    color: var(--kp-reference-ink) !important;
    font-size: clamp(1.2rem, 2vw, 1.45rem) !important;
    font-weight: 700;
    line-height: 1.45 !important;
  }

  .template-section__number,
  .template-section-copy p:first-child {
    color: var(--kp-reference-blue);
    font-size: var(--kp-reference-label-size);
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .template-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
  }

  .template-feature-grid article,
  .template-scenario-grid article {
    display: grid;
    align-content: start;
    gap: 1rem;
    min-width: 0;
  }

  .template-feature-grid img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: .45rem;
    background: var(--kp-reference-white);
    object-fit: cover;
    object-position: center top;
  }

  .template-feature-grid h3,
  .template-scenario-grid h3 {
    color: var(--kp-reference-ink);
    font-family: var(--kp-font-heading);
    font-size: clamp(1.45rem, 2.6vw, 2rem);
    font-weight: 700;
    line-height: 1.05;
  }

  .template-scenario-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2.5rem, 4vw, 4rem) clamp(1.5rem, 4vw, 4rem);
  }

  .template-section-copy {
    display: grid;
    gap: .55rem;
    max-width: 48rem;
    margin-left: var(--kp-home-large-offset, clamp(1.5rem, 7vw, 8rem));
  }

  .template-related-catalog__grid {
    display: grid;
    gap: clamp(1rem, 1.8vw, 1.5rem);
    width: 100%;
  }

  @media (min-width: 60rem) {
    .template-related-catalog__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 40rem) and (max-width: 59.9375rem) {
    .template-related-catalog__grid,
    .template-feature-grid,
    .template-scenario-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 39.9375rem) {
    .page-template--robot {
      gap: 3.25rem;
      padding-block: 1rem 3.5rem;
    }

    .template-live-hero {
      min-height: 24rem;
      border-radius: 1.25rem;
    }

    .template-live-hero h1 {
      font-size: clamp(2.45rem, 11vw, 3.5rem);
    }

    .template-live-hero__actions,
    .template-feature-grid,
    .template-scenario-grid,
    .template-related-catalog__grid {
      grid-template-columns: 1fr;
    }

    .template-live-hero__actions {
      display: grid;
      justify-items: center;
    }

    .template-section-copy {
      margin-left: 0;
    }
  }
</style>
