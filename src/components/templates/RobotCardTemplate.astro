---
import { robotImageDimensions } from '../../lib/robot-image-dimensions';
import { reviewRobotPreviewHref } from '../../lib/review-links';
import type { RobotCardTemplateData } from '../../lib/page-type-templates';
import RobotCard from '../blocks/RobotCard.astro';
import HomeGoshaQuote from '../blocks/HomeGoshaQuote.astro';
import HomeImageCards from '../blocks/HomeImageCards.astro';
import HomeFaqBlock from '../blocks/HomeFaqBlock.astro';
import HomeFinalCta from '../blocks/HomeFinalCta.astro';
import { getRobotPages } from '../../lib/robot-pages';
import approvedHumanoidArticles from '../../../data/content/launch-articles.json';
import { homeArticles, homeFinalCta, homeGosha, homeRobotCardFinalCta } from '../../data/home-live';
import capabilityImageRegistry from '../../../data/models/robot-capability-images.source.json';
import type { RobotCardData } from '../../../design-system/schemas/fixture.schema';

const { template } = Astro.props as { template: RobotCardTemplateData };
const robotSlug = template.seo.canonical.split('/').filter(Boolean).at(-1) ?? template.robot.name;
const isHumanoidPair = ['arenda-unitree-g1', 'arenda-agibot-x2'].includes(robotSlug);
const isContentPilot = ['arenda-roboshashki', 'arenda-senserobot'].includes(robotSlug);
const gallery = template.robot.gallery.length > 0 ? template.robot.gallery : [];
const heroImage = gallery[0];
const curatedGalleryPhotoCount = Math.max(0, gallery.length - 1);
const curatedGallerySplitIndex = 1 + Math.ceil(curatedGalleryPhotoCount / 2);
const hasCuratedSplitGallery = curatedGalleryPhotoCount >= 6;
const primaryGallery = hasCuratedSplitGallery ? gallery.slice(1, curatedGallerySplitIndex) : (gallery.length > 1 ? gallery.slice(1, 6) : gallery).slice(0, 5);
const actionGallery = hasCuratedSplitGallery ? gallery.slice(curatedGallerySplitIndex) : (gallery.length > 3 ? gallery.slice(3, 8) : gallery.slice(1, 6).length > 0 ? gallery.slice(1, 6) : gallery).slice(0, 5);
const capabilitiesLead = template.bodyBlocks.find((block) => block.id === 'capabilitiesLead')?.text ?? 'Возможности показываем как продающие сценарные преимущества, но без неподтверждённых обещаний: факты идут из текущей карточки робота.';
const scenariosLead = template.bodyBlocks.find((block) => block.id === 'scenariosLead')?.text ?? 'Сценарии помогают посетителю быстро понять, подойдёт ли робот под его событие, а AI-агенту — связать модель с реальными event-задачами.';
const capabilityItems = template.robot.capabilities.slice(0, 6);
const scenarioItems = template.robot.scenarios.slice(0, 6);

const categoryLabels: Record<string, string> = {
  humanoid: 'Робот-гуманоид',
  robot_dog: 'Робот-собака',
  service_robot: 'Робот-официант',
  media_robot: 'Робот для съёмки',
  coffee_robot: 'Робо-кофейня',
};
const robotTypeAccusativeByCategory: Record<string, string> = {
  humanoid: 'робота-гуманоида',
  robot_dog: 'робота-собаку',
  service_robot: 'робота-официанта',
  media_robot: 'робота для съёмки',
  coffee_robot: 'робо-кофейню',
};
const robotTypeAccusative = robotTypeAccusativeByCategory[template.robot.category ?? ''] ?? 'робота';
const ownerDisplayNameBySlug: Record<string, string> = {
  'arenda-kettybot': 'KettyBot',
  'arenda-robot-barmen': 'робот-бармен «Робобар»',
  'arenda-robo-kofeyni': 'Robo-Кофейня',
  'arenda-mini-robo-kofeyni': 'мини Robo-Кофейня',
  'arenda-glambot': 'GlamBot',
  'arenda-sketchbot': 'Sketchbot',
  'arenda-robota-hudozhnika-a4': 'робот-художник A4',
};
const ownerQuickCtaTitleBySlug: Record<string, string> = {
  'arenda-kettybot': `Арендуйте робота-официанта KettyBot для мероприятия ${template.robot.priceDisplay}`,
  'arenda-robot-barmen': `Арендуйте робота-бармена «Робобар» для мероприятия ${template.robot.priceDisplay}`,
  'arenda-robo-kofeyni': `Арендуйте Robo-Кофейню для мероприятия ${template.robot.priceDisplay}`,
  'arenda-mini-robo-kofeyni': `Арендуйте мини Robo-Кофейню для мероприятия ${template.robot.priceDisplay}`,
  'arenda-glambot': `Арендуйте GlamBot для мероприятия ${template.robot.priceDisplay}`,
  'arenda-sketchbot': `Арендуйте Sketchbot для мероприятия ${template.robot.priceDisplay}`,
  'arenda-robota-hudozhnika-a4': `Арендуйте робота-художника A4 для мероприятия ${template.robot.priceDisplay}`,
};
const heroTitle = `Аренда ${robotTypeAccusative} ${template.robot.name}`;
const robotDisplayName = ownerDisplayNameBySlug[robotSlug] ?? template.robot.name;
const displayHeroTitle = template.seo.h1;
const quickCtaTitle = `Арендуйте ${robotTypeAccusative} ${template.robot.name} для мероприятия ${template.robot.priceDisplay}`;
const displayQuickCtaTitle = ownerQuickCtaTitleBySlug[robotSlug] ?? quickCtaTitle;
const quickCtaNoWrap = template.robot.priceDisplay;
const leadHref = `/lead/request/?robot=${robotSlug}&source=kiber94-preview`;
const capabilityImages = capabilityImageRegistry.robots.find((robot) => robot.slug === robotSlug)?.images ?? [];

const relatedSlugsByRobotSlug: Record<string, string[]> = {
  'arenda-unitree-g1': ['arenda-agibot-x2', 'arenda-unitree-r1', 'arenda-unitree-h2', 'arenda-promobot-v4'],
  'arenda-agibot-x2': ['arenda-unitree-g1', 'arenda-unitree-r1', 'arenda-unitree-h2', 'arenda-promobot-v4'],
  'arenda-robot-barmen': ['arenda-robo-kofeyni', 'arenda-mini-robo-kofeyni', 'arenda-kettybot', 'arenda-promobot-v4'],
  'arenda-robo-kofeyni': ['arenda-mini-robo-kofeyni', 'arenda-robot-barmen', 'arenda-kettybot', 'arenda-promobot-v4'],
  'arenda-mini-robo-kofeyni': ['arenda-robo-kofeyni', 'arenda-robot-barmen', 'arenda-kettybot', 'arenda-promobot-v4'],
  'arenda-glambot': ['arenda-sketchbot', 'arenda-robota-hudozhnika-a4', 'arenda-robot-barmen', 'arenda-promobot-v4'],
  'arenda-sketchbot': ['arenda-robota-hudozhnika-a4', 'arenda-glambot', 'arenda-robot-barmen', 'arenda-promobot-v4'],
  'arenda-robota-hudozhnika-a4': ['arenda-sketchbot', 'arenda-glambot', 'arenda-robot-barmen', 'arenda-promobot-v4'],
  'arenda-inchbot-l1-w-edu': ['arenda-xiaomi-cyberdog-2', 'arenda-unitree-go2', 'arenda-promobot-v4', 'arenda-kettybot'],
  'arenda-klipmeiker': ['arenda-glambot', 'arenda-sketchbot', 'arenda-robota-hudozhnika-a4', 'arenda-promobot-v4'],
  'arenda-roboshashki': ['arenda-senserobot', 'arenda-promobot-v4', 'arenda-sketchbot', 'arenda-robota-hudozhnika-a4'],
  'arenda-senserobot': ['arenda-roboshashki', 'arenda-promobot-v4', 'arenda-sketchbot', 'arenda-robota-hudozhnika-a4'],
  'arenda-uv-box': ['arenda-klipmeiker', 'arenda-glambot', 'arenda-promobot-v4', 'arenda-kettybot'],
};
const fallbackFeaturedSlugs = ['arenda-unitree-g1', 'arenda-agibot-x2', 'arenda-xiaomi-cyberdog-2', 'arenda-bellabot'];
const featuredSlugs = relatedSlugsByRobotSlug[robotSlug] ?? fallbackFeaturedSlugs;
const relatedRobotDescriptionBySlug: Record<string, string> = {
  'arenda-robot-barmen': 'Роботизированный бар для welcome-зоны, вечеринки или стенда: меню, напитки, оператор и расчёт потока гостей.',
  'arenda-robo-kofeyni': 'Полноформатная робо-кофейня для стенда, форума или бренд-зоны, где кофе-пауза должна работать как интерактив.',
  'arenda-mini-robo-kofeyni': 'Компактная кофейная робот-зона для небольшого стенда, офиса или камерной презентации без крупной застройки.',
  'arenda-glambot': 'Роботизированная видеозона для slow-motion роликов, красной дорожки, премии, показа или брендового события.',
  'arenda-sketchbot': 'Портретный робот для творческой зоны: фото гостя превращается в рисунок и персональный сувенир.',
  'arenda-robota-hudozhnika-a4': 'Робот-художник для бумажных портретов A4: больше внимания к детализации, очереди и выдаче готовых работ.',
  'arenda-kettybot': 'Робот-официант с подносами и экраном для маршрутов подачи, промо и сервисных зон на мероприятии.',
  'arenda-promobot-v4': 'Промо-робот с экраном и речевым сценарием для стойки регистрации, стенда или брендированной зоны.',
  'arenda-xiaomi-cyberdog-2': 'Робот-собака для динамичного показа движения, фото-точки и технологичной зоны с оператором.',
  'arenda-unitree-go2': 'Четвероногий робот для демонстраций, проходов по зоне и спокойного общения с гостями под контролем оператора.',
  'arenda-inchbot-l1-w-edu': 'Образовательная робот-собака для STEM-показа, детской зоны и технологичного стенда.',
  'arenda-klipmeiker': 'Роботизированная камера для коротких event-роликов, бренд-зоны и управляемой съёмочной точки.',
  'arenda-roboshashki': 'Игровой робот с шашками для спокойного турнира, семейной зоны или демонстрации манипулятора.',
  'arenda-senserobot': 'Робот-шахматист для интеллектуальной игровой зоны, клуба, школы или технологичной выставки.',
  'arenda-uv-box': 'Интерактивная витрина с сенсорным экраном для презентации продукта, retail-зоны или шоурума.',
};
const relatedRobots = getRobotPages()
  .filter((robot) => featuredSlugs.includes(robot.slug))
  .sort((a, b) => {
    const categoryBias = Number(b.category === template.robot.category) - Number(a.category === template.robot.category);
    if (categoryBias !== 0) return categoryBias;
    return featuredSlugs.indexOf(a.slug) - featuredSlugs.indexOf(b.slug);
  })
  .slice(0, 4)
  .map((robot, index) => {
    const relatedName = ownerDisplayNameBySlug[robot.slug] ?? robot.identity.name;
    return {
      slug: robot.slug,
      href: reviewRobotPreviewHref(robot.slug, robot.route),
      title: relatedName,
      category: categoryLabels[robot.category] ?? 'Робот для мероприятий',
      price: robot.pricing.display,
      price_disclaimer: robot.pricing.disclaimer as RobotCardData['price_disclaimer'],
      description: relatedRobotDescriptionBySlug[robot.slug] ?? robot.seo.description.slice(0, 132),
      badge: relatedName === robotDisplayName ? 'Сейчас смотрим' : (index === 0 ? 'Похожий формат' : undefined),
      image: robot.media.hero,
      analytics: { event: 'robot_card_click' as const, placement: 'catalog' as const, position: index + 1 },
    };
  });

const priceStatusLabel = isContentPilot ? 'итоговая стоимость зависит от состава заказа' : template.robot.priceStatus === 'request'
  ? 'стоимость подтверждает менеджер'
  : 'стоимость требует ручной проверки';
const serviceFacts = [
  { label: 'Модель', value: robotDisplayName },
  { label: 'Тип робота', value: robotTypeAccusative.replace('робота-', '').replace('робота ', '') },
  { label: 'Формат', value: 'аренда робота для мероприятия' },
  { label: 'Сервис', value: isContentPilot ? 'состав услуги и сопровождение согласуются в предложении' : 'оператор, настройка и сценарий под площадку' },
  { label: 'География', value: 'Москва и выездные мероприятия по РФ после согласования' },
  { label: 'Цена', value: `${template.robot.priceDisplay}; ${priceStatusLabel}` },
];
const hiddenMachineFacts = {
  pageType: 'robot_card',
  robot: robotDisplayName,
  category: template.robot.category,
  price: template.robot.priceDisplay,
  priceStatus: template.robot.priceStatus,
  facts: serviceFacts,
};
const seoIntent = template.seoIntent ?? {
  pageIntent: 'commercial_robot_rental',
  primaryKeyword: template.seo.primaryKeyword,
  secondaryKeywords: template.seo.secondaryKeywords,
  modelNameVariants: [robotDisplayName, template.robot.model ?? template.robot.name],
  entitySynonyms: [template.robot.category ?? 'robot_card'],
  aiAgentHints: ['Страница аренды конкретной модели робота', 'Стоимость и доступность уточняются менеджером'],
};

const includedServiceTitleBySlug: Record<string, string> = {
  'arenda-robot-barmen': 'Что входит в аренду Робобара',
  'arenda-robo-kofeyni': 'Что входит в аренду Robo-Кофейни',
  'arenda-mini-robo-kofeyni': 'Что входит в аренду мини Robo-Кофейни',
  'arenda-glambot': 'Что входит в аренду GlamBot',
  'arenda-sketchbot': 'Что входит в аренду Sketchbot',
  'arenda-robota-hudozhnika-a4': 'Что входит в аренду робота-художника A4',
};
const scenariosTitleBySlug: Record<string, string> = {
  'arenda-robot-barmen': 'Где Робобар уместен на мероприятии',
  'arenda-robo-kofeyni': 'Где Robo-Кофейня работает лучше всего',
  'arenda-mini-robo-kofeyni': 'Где мини Robo-Кофейня закрывает задачу без большой зоны',
  'arenda-glambot': 'Где GlamBot даёт сильный видеоконтент',
  'arenda-sketchbot': 'Где Sketchbot собирает очередь за портретами',
  'arenda-robota-hudozhnika-a4': 'Где робот-художник A4 подходит по темпу и формату',
};
const includedServiceTitle = includedServiceTitleBySlug[robotSlug] ?? 'Что входит в аренду робота';
const scenariosTitle = scenariosTitleBySlug[robotSlug] ?? `Где использовать ${robotDisplayName}`;
const includedServiceLead = isContentPilot ? 'Состав аренды фиксируется в предложении: оборудование, подготовка игровой зоны, доставка и сопровождение обсуждаются под ваше событие. Перед бронированием проверьте, какие услуги и мебель включены в расчёт.' : 'В аренду входит не только сам робот, но и подготовка сценария под мероприятие, доставка, настройка и сопровождение оператором. Мы заранее проверяем площадку, тайминг, маршрут движения, паузы и требования к питанию, чтобы робот стал понятной частью программы без лишней технической нагрузки на клиента.';
const includedService = isContentPilot ? ['Подберём формат: короткая демонстрация, свободная игра или турнир по согласованным правилам.', 'Уточним стол, место игрока, доступ к питанию и расположение очереди.', 'Согласуем доставку, время установки и человека, который объяснит гостям порядок игры.', 'Зафиксируем продолжительность работы, технические паузы и состав услуг в расчёте.'] : [
  'подберём сценарий использования робота под событие, аудиторию, площадку и нужный темп программы',
  'привезём робота, подготовим площадку, проверим покрытие, проходы и технические ограничения',
  'оператор КИБЕР ПОРТАЛА сопровождает программу на мероприятии и помогает роботу работать безопасно',
  'заранее согласуем длительность, выходы робота, паузы, подзарядку и роль в сценарии события',
];
const orderFlowLead = isContentPilot ? 'Начните с даты и задачи игровой зоны. Для расчёта важно знать аудиторию, продолжительность участия и условия площадки — после этого можно подтвердить оборудование и состав услуги.' : 'После заявки команда КИБЕР ПОРТАЛ быстро переводит запрос в понятный план: проверяет дату, город, площадку, аудиторию и формат выхода робота, затем уточняет технические условия, логистику и стоимость. Так вы заранее понимаете, кто привезёт робота, как он будет работать в программе и что нужно подготовить на площадке.';
const orderFlow = isContentPilot ? ['Пришлите дату, город, адрес площадки и выбранного робота.', 'Расскажите, кто будет играть и нужен ли турнир или короткое знакомство.', 'Получите подтверждение доступности, расчёт и требования к месту установки.', 'Согласуйте время заезда, контакт на площадке и порядок запуска игровой зоны.'] : [
  'Вы пишете нам, называете робота, дату, город, площадку и формат будущего мероприятия для расчёта.',
  'Менеджер уточняет площадку, аудиторию, сценарий, тайминг, ограничения и условия заезда для расчёта.',
  'Мы подтверждаем доступность, считаем стоимость и предлагаем безопасный формат работы робота.',
  'В день события привозим, настраиваем и сопровождаем робота на площадке до окончания программы.',
];

const aiSummary = template.aiSummary;
const robotQuickCtaImage = {
  src: '/images/kiber-94-preview/gosha-ushanka-cta1-smiling-wave.webp',
  alt: (isContentPilot || isHumanoidPair) ? 'Кибер Гоша в красной ушанке машет рукой' : 'Кибер Гоша в красной ушанке машет и приглашает арендовать Unitree G1',
};
const robotQuickCta = {
  ...homeFinalCta,
  title: displayQuickCtaTitle,
  titleNoWrap: quickCtaNoWrap,
  description: '',
  image: robotQuickCtaImage,
  primaryCta: { label: 'Написать нам', href: '/contacts/' },
  secondaryCta: { label: 'Оставить заявку', href: leadHref },
};
const robotQuickCtaForRender = robotSlug === 'arenda-kettybot'
  ? { ...robotQuickCta, image: { ...robotQuickCtaImage, alt: `Кибер Гоша в красной ушанке машет и приглашает арендовать ${robotDisplayName}` } }
  : robotQuickCta;

const robotFinalCta = {
  ...homeRobotCardFinalCta,
  title: 'Остались вопросы?',
  description: `Кибер Гоша и команда КИБЕР ПОРТАЛ помогут понять, подойдёт ли ${robotDisplayName} под вашу площадку, аудиторию и тайминг.`,
  primaryCta: { label: 'Написать нам', href: '/contacts/' },
  secondaryCta: { label: 'Оставить заявку', href: leadHref },
};
const robotGosha = {
  ...homeGosha,
  text: template.goshaQuote,
};
const robotFaq = {
  title: 'Вопросы и ответы (FAQ)',
  items: template.faq.map(({ question, answer }) => ({ question, answer })),
};
const ownerArticleBlockBySlug: Record<string, { title: string; description: string }> = {
  'arenda-robot-barmen': {
    title: 'Как спланировать роботизированный бар на мероприятии',
    description: 'Разбираем, как спланировать барную зону с Робобаром: меню, очередь, расходники, правила площадки и роль оператора, чтобы робот стал шоу-точкой, а не узким местом у стойки.',
  },
  'arenda-robo-kofeyni': {
    title: 'Как поставить Robo-Кофейню на стенд или форум',
    description: 'Материалы о том, как превратить кофе-паузу в технологичный контакт с гостем: где поставить Robo-Кофейню, как считать поток, меню, расходники и требования к зоне.',
  },
  'arenda-mini-robo-kofeyni': {
    title: 'Когда нужна компактная робо-кофейня',
    description: 'Пишем о небольших кофейных роботизированных точках: когда важны размер зоны, скорость напитков, понятное меню, электропитание и аккуратная работа без большой застройки.',
  },
  'arenda-glambot': {
    title: 'Как подготовить GlamBot-зону для гостей',
    description: 'Разбираем съёмочную зону под эффектные slow-motion ролики: фон, свет, траекторию камеры, очередь гостей, брендинг видео и выдачу готового контента после съёмки.',
  },
  'arenda-sketchbot': {
    title: 'Как организовать портретную зону со Sketchbot',
    description: 'Материалы о роботизированных портретах: как выбрать стиль рисунка, организовать очередь, брендировать листы и сделать так, чтобы гости уносили не буклет, а личный сувенир.',
  },
  'arenda-robota-hudozhnika-a4': {
    title: 'Как организовать зону с роботом-художником A4',
    description: 'Разбираем портреты на бумаге A4: детализацию, время ожидания, качество фотографии, расходники, брендинг листа и организацию спокойной творческой зоны на мероприятии.',
  },
};
const articleHrefsByRobotSlug: Record<string, string[]> = {
  'arenda-robot-barmen': ['/robot-ofitsiant-na-meropriyatii', '/arenda-robotov-na-meropriyatie'],
  'arenda-robo-kofeyni': ['/robot-ofitsiant-na-meropriyatii', '/arenda-robotov-na-meropriyatie'],
  'arenda-mini-robo-kofeyni': ['/robot-ofitsiant-na-meropriyatii', '/arenda-robotov-na-meropriyatie'],
  'arenda-glambot': ['/arenda-robotov-na-meropriyatie'],
  'arenda-sketchbot': ['/arenda-robotov-na-meropriyatie'],
  'arenda-robota-hudozhnika-a4': ['/arenda-robotov-na-meropriyatie'],
  // Batch 4 has no approved relevant article-detail set yet; hide the block instead of showing homepage filler.
  'arenda-inchbot-l1-w-edu': [],
  'arenda-klipmeiker': [],
  'arenda-roboshashki': [],
  'arenda-senserobot': [],
  'arenda-uv-box': [],
};
const ownerArticleBlock = ownerArticleBlockBySlug[robotSlug];
const articleHrefs = articleHrefsByRobotSlug[robotSlug];
const robotArticles = {
  ...homeArticles,
  title: ownerArticleBlock?.title ?? `Материалы по аренде ${robotDisplayName}`,
  description: ownerArticleBlock?.description ?? `Подбираем материалы о сценариях аренды, подготовке площадки и работе ${robotDisplayName} на мероприятии.`,
  cards: isHumanoidPair ? approvedHumanoidArticles.filter((_, i) => (robotSlug === 'arenda-unitree-g1' ? [0, 2, 5] : [0, 1, 3]).includes(i)).map(card => ({ ...card, href: card.canonicalHref })) : articleHrefs ? homeArticles.cards.filter((card) => articleHrefs.includes(card.href)) : homeArticles.cards.slice(0, homeArticles.cards.length >= 6 ? 6 : 3),
};
const robotCatalogTitle = 'Вас также могут заинтересовать';
const robotCatalogDescription = 'Похожие форматы помогают закрыть соседние задачи: сервисную зону, промо-интерактив, фото- или портретную активность. Подборка остаётся предварительной: менеджер сверит площадку, поток гостей и сценарий события.';
---

<article class="page-template page-template--robot" data-kiber-task="KIBER-94" data-page-type="robot_card" data-content-pilot={(isContentPilot || isHumanoidPair) ? 'true' : undefined}>
  <section class="template-live-hero template-live-hero--dark" data-block-id="hero" aria-labelledby="robot-card-hero-title">
    <div class="template-live-hero__content">
      <p class="template-live-hero__eyebrow">КИБЕР ПОРТАЛ · аренда роботов</p>
      <div class="template-live-hero__main-copy">
        <h1 id="robot-card-hero-title">{displayHeroTitle}</h1>
        <p>{template.robot.priceDisplay}</p>
      </div>
      <div class="template-live-hero__price-actions">
        <div class="template-live-hero__actions">
          <a class="template-hero-button template-hero-button--primary" href="#contact-messengers" data-contact-popup-trigger data-analytics-event="contact_click" data-analytics-source="robot_card_hero" data-analytics-placement="primary_cta" data-analytics-slug={robotSlug}>Написать нам</a>
          <a class="template-hero-button template-hero-button--light" href={leadHref}>Оставить заявку</a>
        </div>
      </div>
    </div>
    {heroImage && (
      <figure class="template-live-hero__media">
        <img {...robotImageDimensions(heroImage.src)} src={heroImage.src} alt={heroImage.alt} loading="eager" decoding="async" />
      </figure>
    )}
  </section>

  <script type="application/json" data-block-id="seoIntent" data-ai-agent-readable="true" set:html={JSON.stringify(seoIntent)} />

  <section class="template-ai-summary" data-block-id="aiSummary" aria-label="Краткое описание страницы для гостей, поисковиков и AI-агентов">
    <p><strong>{aiSummary}</strong></p>
  </section>

  <section id="robot-card-gallery" class="template-live-gallery" data-block-id="gallery" aria-labelledby="robot-card-gallery-title">
    <div class="template-gallery-head">
      <div class="template-section-copy template-section-copy--gallery">
        <p>Галерея</p>
        <h2 id="robot-card-gallery-title">Посмотрите, как выглядит {robotDisplayName}</h2>
      </div>
      <div class="template-gallery-nav" aria-label="Навигация по галерее">
        <button class="template-gallery-nav__button" type="button" data-slider-prev="[data-drag-slider='robot-gallery']" aria-label="Предыдущие фото галереи">‹</button>
        <button class="template-gallery-nav__button" type="button" data-slider-next="[data-drag-slider='robot-gallery']" aria-label="Следующие фото галереи">›</button>
      </div>
    </div>
    <div class="template-drag-gallery template-live-gallery__strip" data-drag-slider="robot-gallery" aria-label={`Галерея ${robotDisplayName}: горизонтальный слайдер`}>
      {primaryGallery.map((image, index) => (
        <figure class="template-live-gallery__item">
          <img {...robotImageDimensions(image.src)} src={image.src} alt={image.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
        </figure>
      ))}
    </div>
  </section>

  <section id="robot-card-included" class="template-section template-included-service" data-block-id="includedService" aria-labelledby="robot-card-included-title">
    <div class="template-section-copy">
      <p class="template-section__number">01 — что входит</p>
      <h2 id="robot-card-included-title">{includedServiceTitle}</h2>
      <span>{includedServiceLead}</span>
    </div>
    <ul class="template-check-list template-check-list--reference">
      {includedService.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="template-section" data-block-id="capabilities" aria-labelledby="robot-card-capabilities-title">
    <p class="template-section__number">02 — ключевые возможности</p>
    <h2 id="robot-card-capabilities-title">{`Что умеет ${robotDisplayName}`}</h2>
    <p class="template-section__lead">{capabilitiesLead}</p>
    <div class="template-feature-grid">
      {capabilityItems.map((item, index) => (
        <article>
          {capabilityImages[index] && <img {...robotImageDimensions(capabilityImages[index].publicSrc)} src={capabilityImages[index].publicSrc} alt={capabilityImages[index].seoAlt} loading="lazy" decoding="async" />}
          <h3>{item.title ?? item.text}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="template-section" data-block-id="scenarios" aria-labelledby="robot-card-scenarios-title">
    <p class="template-section__number">03 — сценарии использования</p>
    <h2 id="robot-card-scenarios-title">{scenariosTitle}</h2>
    <p class="template-section__lead">{scenariosLead}</p>
    <div class="template-scenario-grid">
      {scenarioItems.map((item) => <article><h3>{item.title ?? item.text}</h3><p>{item.text}</p></article>)}
    </div>
  </section>

  <section class="template-reused-block template-reused-block--cta template-reused-block--quick-cta" id="robot-card-pricing" data-block-id="pricing">
    <HomeFinalCta {...robotQuickCtaForRender} />
  </section>

  <section class="template-section template-action-gallery" data-block-id="robotInAction" aria-labelledby="robot-card-action-title">
    <div class="template-gallery-head">
      <div class="template-section-copy template-section-copy--gallery">
        <p>04 — робот в действии</p>
        <h2 id="robot-card-action-title">Покажите гостям движение, общение и фото-контент</h2>
      </div>
      <div class="template-gallery-nav" aria-label="Навигация по галерее робота в действии">
        <button class="template-gallery-nav__button" type="button" data-slider-prev="[data-drag-slider='robot-action-gallery']" aria-label="Предыдущие фото робота в действии">‹</button>
        <button class="template-gallery-nav__button" type="button" data-slider-next="[data-drag-slider='robot-action-gallery']" aria-label="Следующие фото робота в действии">›</button>
      </div>
    </div>
    <div class="template-drag-gallery template-action-gallery__strip" data-drag-slider="robot-action-gallery" aria-label={`${robotDisplayName} в действии: горизонтальный слайдер`}>
      {actionGallery.map((image) => (
        <figure>
          <img {...robotImageDimensions(image.src)} src={image.src} alt={image.alt} loading="lazy" decoding="async" draggable="false" />
        </figure>
      ))}
    </div>
  </section>

  <section class="template-reused-block template-reused-block--gosha-quote" data-block-id="goshaCta">
    <HomeGoshaQuote {...robotGosha} />
  </section>

  <script is:inline type="application/json" data-block-id="hiddenMachineFacts" set:html={JSON.stringify(hiddenMachineFacts)} />

  <section class="template-section template-order-flow" data-block-id="orderFlow" aria-labelledby="robot-card-order-flow-title">
    <div class="template-section-copy">
      <p class="template-section__number">05 — как заказать</p>
      <h2 id="robot-card-order-flow-title">Что произойдёт после заявки</h2>
      <span>{orderFlowLead}</span>
    </div>
    <ol class="template-order-list template-order-list--reference">
      {orderFlow.map((item) => <li>{item}</li>)}
    </ol>
  </section>

  <section class="template-reused-block" data-block-id="faq">
    <HomeFaqBlock {...robotFaq} />
  </section>

  <section class="template-reused-block template-reused-block--cta" data-block-id="finalQuestionsCta">
    <HomeFinalCta {...robotFinalCta} id="social-final" />
  </section>

  {robotArticles.cards.length > 0 && (
    <section class="template-reused-block" data-block-id="articles">
      <HomeImageCards id="articles" eyebrow="Блог Кибер Гоши" variant="article" {...robotArticles} />
    </section>
  )}

  <section id="robot-card-related-catalog" class="template-related-catalog" aria-labelledby="robot-card-related-catalog-title" data-block-id="relatedCatalog">
    <div class="template-section-copy">
      <p>Каталог роботов</p>
      <h2 id="robot-card-related-catalog-title">{robotCatalogTitle}</h2>
      <span>{robotCatalogDescription}</span>
    </div>
    <div class="template-related-catalog__grid">
      {relatedRobots.map((robot) => <RobotCard {...robot} hideDisclaimer={true} hideLink={true} imageLoading="eager" />)}
    </div>
  </section>
</article>

<script is:inline src="/scripts/robot-card-gallery.js" defer></script>

<style>
  .page-template--robot {
    --robot-card-gallery-height: clamp(29.12rem, 47.6vw, 35.49rem);
    --robot-card-page-gap: clamp(3.5rem, 6vw, 6rem);
    display: grid;
    gap: var(--robot-card-page-gap);
    padding-block: clamp(1.25rem, 2.4vw, 2rem) 4.5rem;
    background: var(--kp-reference-sky);
  }

  .template-live-hero {
    display: grid;
    --robot-card-hero-title-scale: .9;
    --robot-card-hero-media-height: 95%;
    --robot-card-hero-media-bleed: clamp(2.6rem, 3.2vw, 3.2rem);
    --robot-card-hero-block-inset: clamp(1rem, 1.6vw, 1.45rem);
    --robot-card-hero-inline-inset: clamp(1.5rem, 3.2vw, 3.35rem);
    --robot-card-hero-media-edge-inset: calc(var(--robot-card-hero-block-inset) * .65);
    grid-template-columns: minmax(0, .84fr) minmax(27rem, .96fr);
    gap: var(--robot-card-hero-inline-inset);
    align-items: stretch;
    overflow: hidden;
    border-radius: 1.625rem;
    padding: var(--robot-card-hero-block-inset) var(--robot-card-hero-media-edge-inset) var(--robot-card-hero-block-inset) var(--robot-card-hero-inline-inset);
    background: var(--kp-reference-ink-dark);
    box-shadow: none;
    color: var(--kp-reference-white);
  }

  .template-live-hero--dark {
    background: linear-gradient(135deg, var(--kp-reference-ink-dark) 0%, color-mix(in srgb, var(--kp-reference-ink-dark) 82%, var(--kp-reference-white)) 100%);
  }

  .template-live-hero__content {
    display: grid;
    grid-template-rows: 1fr auto auto 1fr;
    justify-items: start;
    align-content: stretch;
    gap: clamp(1rem, 2vw, 1.35rem);
    max-width: 46rem;
    min-height: 100%;
    text-align: left;
  }

  .template-live-hero__main-copy {
    display: grid;
    gap: 1.35rem;
    justify-self: start;
  }

  .template-live-hero__media {
    display: grid;
    align-self: center;
    height: calc(var(--robot-card-hero-media-height) + var(--robot-card-hero-media-bleed));
    min-height: 0;
    place-items: center;
    margin: 0;
    overflow: hidden;
    border-radius: 1.45rem;
    background: var(--kp-reference-white);
  }

  .template-live-hero__media img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: clamp(24rem, 38vw, 34rem);
    aspect-ratio: 1 / 1;
    object-fit: contain;
    object-position: center;
  }

  .template-live-hero__eyebrow,
  .template-live-hero h1,
  .template-live-hero p,
  .template-ai-summary p,
  .template-section h2,
  .template-section h3,
  .template-section p,
  .template-section__number,
  .template-section-copy p,
  .template-section-copy h2,
  .template-section-copy span,
  .template-check-list,
  .template-order-list {
    margin: 0;
  }

  .template-live-hero h1 {
    color: var(--kp-reference-white);
    font-family: var(--kp-font-heading);
    font-size: clamp(calc(2.9rem * var(--robot-card-hero-title-scale)), calc(6.1vw * var(--robot-card-hero-title-scale)), calc(4.65rem * var(--robot-card-hero-title-scale)));
    font-weight: 700;
    line-height: .98;
  }

  .template-live-hero p:not(.template-live-hero__eyebrow) {
    max-width: 38rem;
    color: color-mix(in srgb, var(--kp-reference-white) 90%, transparent);
    font-family: var(--kp-font-heading);
    font-size: clamp(1.35rem, 2.1vw, 1.85rem);
    font-weight: 700;
    line-height: 1.15;
  }

  .template-live-hero__eyebrow,
  .template-section__number,
  .template-section-copy p:first-child {
    color: var(--kp-reference-blue);
    font-size: var(--kp-reference-label-size);
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .template-live-hero__eyebrow {
    align-self: center;
    justify-self: start;
    color: var(--kp-reference-white);
    text-align: left;
  }

  .template-live-hero__price-actions {
    display: grid;
    align-self: center;
    justify-items: start;
    width: 100%;
    margin-top: clamp(2.2rem, 3vw, 3rem);
  }

  .template-live-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: flex-start;
  }

  .template-hero-button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: .0625rem solid transparent;
    border-radius: 999rem;
    padding: .875rem 1.65rem;
    font-family: var(--kp-font-heading);
    font-size: .875rem;
    font-weight: 700;
    text-decoration: none;
  }

  .template-hero-button--primary {
    background: var(--kp-reference-white);
    color: var(--kp-reference-blue);
  }

  .template-hero-button--light {
    border-color: var(--kp-reference-blue);
    background: var(--kp-reference-blue);
    color: var(--kp-reference-white);
  }

  .template-section,
  .template-live-gallery,
  .template-related-catalog,
  .template-reused-block,
  .template-ai-summary {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  .template-ai-summary {
    max-width: 72rem;
  }

  .template-ai-summary {
    gap: .65rem;
    border-radius: 1.15rem;
    padding: .35rem 0;
    background: transparent;
    color: var(--kp-reference-ink);
  }

  .template-ai-summary p {
    margin: 0;
    color: var(--kp-reference-ink);
    font-size: clamp(1.18rem, 1.65vw, 1.38rem);
    font-weight: 700;
    line-height: 1.45;
  }

  .template-ai-summary strong {
    font: inherit;
  }

  .template-gallery-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .template-gallery-nav {
    display: flex;
    flex-shrink: 0;
    gap: .75rem;
  }

  .template-gallery-nav__button {
    display: inline-flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 999rem;
    background: var(--kp-reference-blue);
    color: var(--kp-reference-white);
    cursor: pointer;
    font-family: var(--kp-font-heading);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    transition: transform .18s ease, background .18s ease;
  }

  .template-gallery-nav__button:hover {
    transform: translateY(-.08rem);
    background: color-mix(in srgb, var(--kp-reference-blue) 88%, var(--kp-reference-ink));
  }

  .template-gallery-nav__button:focus-visible {
    outline: .1875rem solid var(--kp-reference-ink);
    outline-offset: .2rem;
  }

  .template-drag-gallery {
    display: flex;
    gap: clamp(.85rem, 1.5vw, 1.15rem);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: none;
    cursor: grab;
    user-select: none;
    touch-action: pan-y;
    scrollbar-width: none;
  }

  .template-drag-gallery::-webkit-scrollbar {
    display: none;
  }

  .template-drag-gallery.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  .template-live-gallery__item,
  .template-action-gallery figure {
    position: relative;
    flex: 0 0 auto;
    width: fit-content;
    min-width: 0;
    height: var(--robot-card-gallery-height);
    margin: 0;
    overflow: hidden;
    border-radius: 1.35rem;
    background: transparent;
    scroll-snap-align: start;
    -webkit-user-drag: none;
  }

  .template-live-gallery__item img,
  .template-action-gallery img {
    display: block;
    width: auto;
    height: 100%;
    max-width: none;
    border-radius: inherit;
    object-fit: contain;
    object-position: center;
    -webkit-user-drag: none;
    user-select: none;
  }

  .template-section > .template-section__number,
  .template-section > h2,
  .template-section > .template-section__lead {
    max-width: 56rem;
    margin-left: var(--kp-home-large-offset, clamp(1.5rem, 7vw, 8rem));
    margin-right: var(--kp-home-large-offset, clamp(1.5rem, 7vw, 8rem));
  }

  .template-section h2,
  .template-section-copy h2 {
    color: var(--kp-reference-ink);
    font-family: var(--kp-font-heading);
    font-size: clamp(2.4rem, 5vw, var(--kp-reference-heading-lg));
    font-weight: 700;
    line-height: 1;
  }

  .template-section__lead,
  .template-feature-grid p,
  .template-scenario-grid p,
  .template-section-copy span,
  .template-check-list,
  .template-order-list {
    color: var(--kp-reference-muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .template-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
  }

  .template-feature-grid article,
  .template-scenario-grid article {
    display: grid;
    align-content: start;
    gap: 1rem;
    min-width: 0;
  }

  .template-scenario-grid article {
    border-radius: 1.35rem;
    padding: clamp(1.15rem, 2vw, 1.65rem);
    background: var(--kp-reference-white);
    transition: transform var(--kp-robot-card-image-hover-duration) var(--kp-robot-card-image-hover-easing);
  }

  .template-scenario-grid article:hover {
    transform: scale(var(--kp-robot-card-image-hover-scale));
  }

  .template-feature-grid img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: .45rem;
    background: var(--kp-reference-white);
    object-fit: cover;
    object-position: center top;
    transition: transform var(--kp-robot-card-image-hover-duration) var(--kp-robot-card-image-hover-easing);
  }

  .template-feature-grid article:hover img {
    transform: scale(var(--kp-robot-card-image-hover-scale));
  }

  .template-feature-grid h3,
  .template-scenario-grid h3 {
    color: var(--kp-reference-ink);
    font-family: var(--kp-font-heading);
    font-size: clamp(1.25rem, 2vw, 1.62rem);
    font-weight: 700;
    line-height: 1.08;
  }

  .template-scenario-grid h3 {
    font-size: clamp(1.05rem, 1.55vw, 1.28rem);
  }

  .template-scenario-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2.5rem, 4vw, 4rem) clamp(1.5rem, 4vw, 4rem);
  }

  .template-section-copy {
    display: grid;
    gap: .55rem;
    max-width: 56rem;
    margin-left: var(--kp-home-large-offset, clamp(1.5rem, 7vw, 8rem));
    margin-right: var(--kp-home-large-offset, clamp(1.5rem, 7vw, 8rem));
  }

  .template-check-list,
  .template-order-list {
    display: grid;
    gap: .8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .template-check-list--reference {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.4rem, 4.4vw, 4.9rem) clamp(3rem, 7vw, 7rem);
  }

  .template-check-list--reference,
  .template-order-list--reference {
    margin-left: var(--kp-home-large-offset, clamp(1.5rem, 7vw, 8rem));
    margin-right: var(--kp-home-large-offset, clamp(1.5rem, 7vw, 8rem));
  }

  .template-check-list li,
  .template-order-list li {
    border-radius: 1.15rem;
    color: var(--kp-reference-ink);
    font-weight: 700;
  }

  .template-check-list--reference li {
    position: relative;
    min-height: 3.4rem;
    padding: .05rem 0 .05rem 4.3rem;
