---
import type { RobotCardTemplateData } from '../../lib/page-type-templates';
import RobotCard from '../blocks/RobotCard.astro';
import HomeGoshaQuote from '../blocks/HomeGoshaQuote.astro';
import HomeImageCards from '../blocks/HomeImageCards.astro';
import HomeFaqBlock from '../blocks/HomeFaqBlock.astro';
import HomeFinalCta from '../blocks/HomeFinalCta.astro';
import { getRobotPages } from '../../lib/robot-pages';
import { homeArticles, homeFinalCta, homeGosha } from '../../data/home-live';
import type { RobotCardData } from '../../../design-system/schemas/fixture.schema';

const { template } = Astro.props as { template: RobotCardTemplateData };
const gallery = template.robot.gallery.length > 0 ? template.robot.gallery : [];
const heroImage = gallery[0];
const primaryGallery = gallery.slice(0, 5);
const actionGallery = (gallery.length > 1 ? gallery.slice(1, 6) : gallery).slice(0, 5);
const descriptionBlocks = template.bodyBlocks.filter((block) => block.text);
const introText = descriptionBlocks[0]?.text;
const followupText = descriptionBlocks[1]?.text;
const capabilityItems = template.robot.capabilities.slice(0, 6);
const scenarioItems = template.robot.scenarios.slice(0, 6);

const categoryLabels: Record<string, string> = {
  humanoid: 'Робот-гуманоид',
  robot_dog: 'Робот-собака',
  service_robot: 'Робот-официант',
  media_robot: 'Робот для съёмки',
  coffee_robot: 'Робо-кофейня',
};
const featuredSlugs = ['arenda-unitree-g1', 'arenda-agibot-x2', 'arenda-xiaomi-cyberdog-2', 'arenda-bellabot'];
const relatedRobots = getRobotPages()
  .filter((robot) => featuredSlugs.includes(robot.slug))
  .sort((a, b) => featuredSlugs.indexOf(a.slug) - featuredSlugs.indexOf(b.slug))
  .slice(0, 4)
  .map((robot, index) => ({
    slug: robot.slug,
    href: robot.route,
    title: robot.identity.name,
    category: categoryLabels[robot.category] ?? 'Робот для мероприятий',
    price: robot.pricing.display,
    price_disclaimer: robot.pricing.disclaimer as RobotCardData['price_disclaimer'],
    description: robot.seo.description.slice(0, 132),
    badge: robot.identity.name === template.robot.name ? 'Сейчас смотрим' : (index === 0 ? 'Популярный выбор' : undefined),
    image: robot.media.hero,
    analytics: { event: 'robot_card_click' as const, placement: 'catalog' as const, position: index + 1 },
  }));

const priceStatusLabel = template.robot.priceStatus === 'request'
  ? 'стоимость подтверждает менеджер'
  : 'стоимость требует ручной проверки';
const serviceFacts = [
  { label: 'Модель', value: template.robot.model ?? template.robot.name },
  { label: 'Формат', value: 'аренда робота для мероприятия' },
  { label: 'Сервис', value: 'оператор, настройка и сценарий под площадку' },
  { label: 'География', value: 'Москва и выездные мероприятия по РФ после согласования' },
  { label: 'Цена', value: `${template.robot.priceDisplay}; ${priceStatusLabel}` },
  { label: 'Уточняем', value: 'дату, площадку, длительность, сценарий и требования к движению' },
];
const includedService = [
  'подберём сценарий использования робота под событие и аудиторию',
  'привезём робота, подготовим площадку и проверим технические ограничения',
  'оператор КИБЕР ПОРТАЛА сопровождает программу на мероприятии',
  'заранее согласуем длительность, выходы робота, паузы и подзарядку',
];
const orderFlow = [
  'Вы пишете нам и называете робота, дату, город и формат мероприятия.',
  'Менеджер уточняет площадку, аудиторию, сценарий, тайминг и ограничения.',
  'Мы подтверждаем доступность, считаем стоимость и предлагаем безопасный формат.',
  'В день события привозим, настраиваем и сопровождаем робота на площадке.',
];

const aiSummary = `${template.hero.text} ${template.aiSummary}`;
const robotQuickCta = {
  title: `Хотите ${template.robot.name} на мероприятие?`,
  description: `${template.robot.priceDisplay}. Напишите нам — подскажем сценарий, проверим дату и рассчитаем безопасный формат под площадку.`,
  primaryCta: { label: 'Написать нам', href: '/contacts/' },
  secondaryCta: { label: 'Что входит', href: '#robot-card-included' },
};
const robotFinalCta = {
  ...homeFinalCta,
  title: 'Остались вопросы?',
  description: `Кибер Гоша и команда КИБЕР ПОРТАЛ помогут понять, подойдёт ли ${template.robot.name} под вашу площадку, аудиторию и тайминг.`,
  primaryCta: { label: 'Задать вопрос', href: '/contacts/' },
  secondaryCta: { label: 'Смотреть блог', href: '#articles' },
};
const robotGosha = {
  ...homeGosha,
  text: `— Подскажу честно, как робот человеку.\n\n${template.robot.name} стоит выбирать не только по внешнему виду, а по сценарию: где он будет двигаться, кто будет рядом, сколько длится программа и какой вау-эффект нужен гостям. Менеджеры КИБЕР ПОРТАЛ заранее проверят площадку, рассчитают стоимость и подскажут безопасный формат.`
};
const robotFaq = {
  title: 'Вопросы и ответы (FAQ)',
  items: template.faq.map(({ question, answer }) => ({ question, answer })),
};
---

<article class="page-template page-template--robot" data-kiber-task="KIBER-94" data-page-type="robot_card">
  <section class="template-live-hero" data-block-id="hero" aria-labelledby="robot-card-hero-title">
    <div class="template-live-hero__content">
      <p class="template-live-hero__eyebrow">КИБЕР ПОРТАЛ · аренда роботов</p>
      <h1 id="robot-card-hero-title">{template.seo.h1}</h1>
      <p>{template.robot.priceDisplay}. Робот приезжает с оператором, сценарием и подготовкой под площадку.</p>
      <div class="template-live-hero__actions">
        <a class="template-hero-button template-hero-button--primary" href="/contacts/">Написать нам</a>
        <a class="template-hero-button template-hero-button--light" href="#robot-card-gallery">Смотреть фото</a>
      </div>
    </div>
    {heroImage && (
      <figure class="template-live-hero__media">
        <img src={heroImage.src} alt={heroImage.alt} loading="eager" decoding="async" />
      </figure>
    )}
  </section>

  <section class="template-ai-summary" data-block-id="aiSummary" aria-label="Краткое описание страницы для гостей, поисковиков и AI-агентов">
    <strong>Коротко для гостей, поисковиков и AI-агентов:</strong>
    <p>{aiSummary}</p>
  </section>

  <section id="robot-card-gallery" class="template-live-gallery" data-block-id="gallery" aria-labelledby="robot-card-gallery-title">
    <div class="template-section-copy template-section-copy--gallery">
      <p>Галерея</p>
      <h2 id="robot-card-gallery-title">Посмотрите, как выглядит {template.robot.name}</h2>
      <span>Сначала показываем самого робота крупно — это первый вау-крючок страницы и proof, что модель реальная.</span>
    </div>
    <div class:list={['template-live-gallery__grid', primaryGallery.length === 1 && 'template-live-gallery__grid--single']}>
      {primaryGallery.map((image, index) => (
        <figure class:list={['template-live-gallery__item', index === 0 && 'template-live-gallery__item--featured', primaryGallery.length === 1 && 'template-live-gallery__item--solo']}>
          <img src={image.src} alt={image.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
          <figcaption>{index + 1} из {primaryGallery.length}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="template-live-intro" data-block-id="description" aria-labelledby="robot-card-text-title">
    <h2 id="robot-card-text-title">{template.robot.name} на мероприятии</h2>
    {introText && <p>{introText}</p>}
    {followupText && <p>{followupText}</p>}
    <p>{template.cta.note}</p>
  </section>

  <section class="template-section" data-block-id="capabilities" aria-labelledby="robot-card-capabilities-title">
    <p class="template-section__number">01 — ключевые возможности</p>
    <h2 id="robot-card-capabilities-title">{`Что умеет ${template.robot.name}`}</h2>
    <p class="template-section__lead">Возможности показываем как продающие сценарные преимущества, но без неподтверждённых обещаний: факты идут из текущей карточки робота.</p>
    <div class="template-feature-grid">
      {capabilityItems.map((item, index) => (
        <article>
          {gallery[index % Math.max(gallery.length, 1)] && <img src={gallery[index % gallery.length].src} alt="" loading="lazy" decoding="async" />}
          <h3>{item.title ?? item.text}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="template-section" data-block-id="scenarios" aria-labelledby="robot-card-scenarios-title">
    <p class="template-section__number">02 — сценарии использования</p>
    <h2 id="robot-card-scenarios-title">{`Где ${template.robot.name} произведёт «вау-эффект»?`}</h2>
    <p class="template-section__lead">Сценарии помогают посетителю быстро понять, подойдёт ли робот под его событие, а AI-агенту — связать модель с реальными event-задачами.</p>
    <div class="template-scenario-grid">
      {scenarioItems.map((item) => <article><h3>{item.title ?? item.text}</h3><p>{item.text}</p></article>)}
    </div>
  </section>

  <section class="template-section template-action-gallery" data-block-id="robotInAction" aria-labelledby="robot-card-action-title">
    <div class="template-section-copy template-section-copy--gallery">
      <p>03 — робот в действии</p>
      <h2 id="robot-card-action-title">Покажите гостям движение, общение и фото-контент</h2>
      <span>Media-зона напоминает, зачем робот нужен на мероприятии: фото, видео, поток гостей и запоминаемый брендовый эффект.</span>
    </div>
    <div class="template-action-gallery__strip">
      {actionGallery.map((image, index) => (
        <figure>
          <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
          <figcaption>{index + 1} / {actionGallery.length}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="template-reused-block" data-block-id="goshaCta">
    <HomeGoshaQuote {...robotGosha} />
  </section>

  <section class="template-inline-cta" id="robot-card-pricing" data-block-id="pricing" aria-labelledby="robot-card-cta-title">
    <div>
      <p class="template-section__number">CTA №1</p>
      <h2 id="robot-card-cta-title">{robotQuickCta.title}</h2>
      <p>{robotQuickCta.description}</p>
    </div>
    <div class="template-live-hero__actions">
      <a class="template-hero-button template-hero-button--primary" href={robotQuickCta.primaryCta.href}>{robotQuickCta.primaryCta.label}</a>
      <a class="template-hero-button template-hero-button--light" href={robotQuickCta.secondaryCta.href}>{robotQuickCta.secondaryCta.label}</a>
    </div>
  </section>

  <section id="robot-card-included" class="template-section template-two-column" data-block-id="includedService" aria-labelledby="robot-card-included-title">
    <div>
      <p class="template-section__number">04 — что входит</p>
      <h2 id="robot-card-included-title">Не просто робот, а готовый event-сервис</h2>
      <p class="template-section__lead">Клиенту не нужно самостоятельно программировать или запускать робота: задача КИБЕР ПОРТАЛА — превратить модель в понятный сценарий для события.</p>
    </div>
    <ul class="template-check-list">
      {includedService.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="template-section template-commercial-brief" data-block-id="structuredFacts" aria-labelledby="robot-card-facts-title">
    <p class="template-section__number">05 — факты для выбора</p>
    <h2 id="robot-card-facts-title">Что важно знать перед арендой</h2>
    <p class="template-section__lead">Коммерческие и AI-readable факты в одном месте: модель, формат услуги, цена, логистика и ограничения без спорных обещаний.</p>
    <dl class="template-facts-grid">
      {serviceFacts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="template-section template-two-column" data-block-id="orderFlow" aria-labelledby="robot-card-order-flow-title">
    <div>
      <p class="template-section__number">06 — как заказать</p>
      <h2 id="robot-card-order-flow-title">Что произойдёт после заявки</h2>
      <p class="template-section__lead">Показываем прозрачный процесс, чтобы убрать тревогу перед обращением и объяснить, почему финальная стоимость подтверждается менеджером.</p>
    </div>
    <ol class="template-order-list">
      {orderFlow.map((item) => <li>{item}</li>)}
    </ol>
  </section>

  <section class="template-reused-block" data-block-id="faq">
    <HomeFaqBlock {...robotFaq} />
  </section>

  <section class="template-reused-block template-reused-block--cta" data-block-id="finalQuestionsCta">
    <HomeFinalCta {...robotFinalCta} />
  </section>

  <section class="template-reused-block" data-block-id="articles">
    <HomeImageCards id="articles" eyebrow="Блог Кибер Гоши" variant="article" {...homeArticles} />
  </section>

  <section id="robot-card-related-catalog" class="template-related-catalog" aria-labelledby="robot-card-related-catalog-title" data-block-id="relatedCatalog">
    <div class="template-section-copy">
      <p>Каталог роботов</p>
      <h2 id="robot-card-related-catalog-title">Популярные модели для мероприятий</h2>
      <span>Этот блок переиспользует готовые карточки каталога с главной страницы, чтобы посетитель мог сравнить модели после чтения страницы.</span>
    </div>
    <div class="template-related-catalog__grid">
      {relatedRobots.map((robot) => <RobotCard {...robot} hideDisclaimer={true} hideLink={true} imageLoading="eager" />)}
    </div>
  </section>
</article>

<style>
  .page-template--robot {
    display: grid;
    gap: clamp(3.5rem, 6vw, 6rem);
    padding-block: clamp(1.25rem, 2.4vw, 2rem) 4.5rem;
    background: var(--kp-reference-sky);
  }

  .template-live-hero {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(18rem, .72fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    overflow: hidden;
    border-radius: 1.625rem;
    padding: clamp(1.5rem, 4vw, 4rem);
    background: linear-gradient(135deg, var(--kp-reference-blue-deep), var(--kp-reference-blue));
    box-shadow: none;
    color: var(--kp-reference-white);
  }

  .template-live-hero__content {
    display: grid;
    justify-items: start;
    gap: 1.35rem;
    max-width: 46rem;
    text-align: left;
  }

  .template-live-hero__media {
    display: grid;
    place-items: center;
    margin: 0;
    overflow: hidden;
    border-radius: 1.45rem;
    background: var(--kp-reference-white);
  }

  .template-live-hero__media img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    object-position: center;
  }

  .template-live-hero__eyebrow,
  .template-live-hero h1,
  .template-live-hero p,
  .template-live-intro h2,
  .template-live-intro p,
  .template-ai-summary p,
  .template-section h2,
  .template-section h3,
  .template-section p,
  .template-section__number,
  .template-section-copy p,
  .template-section-copy h2,
  .template-section-copy span,
  .template-facts-grid,
  .template-facts-grid dd,
  .template-facts-grid dt,
  .template-inline-cta h2,
  .template-inline-cta p {
    margin: 0;
  }

  .template-live-hero h1 {
    color: var(--kp-reference-white);
    font-family: var(--kp-font-heading);
    font-size: clamp(3rem, 6.6vw, 4.75rem);
    font-weight: 700;
    line-height: .98;
  }

  .template-live-hero p:not(.template-live-hero__eyebrow) {
    max-width: 38rem;
    color: color-mix(in srgb, var(--kp-reference-white) 88%, transparent);
    font-size: clamp(1rem, 1.7vw, 1.2rem);
    line-height: 1.55;
  }

  .template-live-hero__eyebrow,
  .template-section__number,
  .template-section-copy p:first-child {
    color: var(--kp-reference-blue);
    font-size: var(--kp-reference-label-size);
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .template-live-hero__eyebrow {
    color: color-mix(in srgb, var(--kp-reference-white) 86%, var(--kp-reference-blue));
  }

  .template-live-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: flex-start;
  }

  .template-hero-button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: .0625rem solid transparent;
    border-radius: 999rem;
    padding: .875rem 1.65rem;
    font-family: var(--kp-font-heading);
    font-size: .875rem;
    font-weight: 700;
    text-decoration: none;
  }

  .template-hero-button--primary {
    background: var(--kp-reference-white);
    color: var(--kp-reference-blue);
  }

  .template-hero-button--light {
    border-color: color-mix(in srgb, var(--kp-reference-white) 45%, transparent);
    background: color-mix(in srgb, var(--kp-reference-white) 12%, transparent);
    color: var(--kp-reference-white);
  }

  .template-inline-cta .template-hero-button--primary {
    background: var(--kp-reference-blue);
    color: var(--kp-reference-white);
  }

  .template-inline-cta .template-hero-button--light {
    border-color: color-mix(in srgb, var(--kp-reference-blue) 18%, transparent);
    background: var(--kp-reference-white);
    color: var(--kp-reference-ink);
  }

  .template-live-intro,
  .template-section,
  .template-live-gallery,
  .template-related-catalog,
  .template-reused-block,
  .template-ai-summary,
  .template-inline-cta {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  .template-ai-summary,
  .template-live-intro {
    max-width: 72rem;
  }

  .template-ai-summary {
    gap: .65rem;
    border-left: .32rem solid var(--kp-reference-blue);
    border-radius: 1.15rem;
    padding: 1.15rem 1.35rem;
    background: color-mix(in srgb, var(--kp-reference-white) 78%, transparent);
    color: var(--kp-reference-ink);
  }

  .template-ai-summary strong {
    font-family: var(--kp-font-heading);
    font-size: .98rem;
  }

  .template-live-gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(.75rem, 1.4vw, 1rem);
  }

  .template-live-gallery__grid--single {
    grid-template-columns: minmax(16rem, 34rem);
  }

  .template-live-gallery__item {
    position: relative;
    display: grid;
    min-width: 0;
    overflow: hidden;
    border-radius: 1.35rem;
    background: var(--kp-reference-white);
  }

  .template-live-gallery__item--featured {
    grid-column: span 2;
    grid-row: span 2;
  }

  .template-live-gallery__item--solo {
    grid-column: auto;
    grid-row: auto;
  }

  .template-live-gallery__item img,
  .template-action-gallery img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center top;
  }

  .template-live-gallery__item--featured img {
    min-height: 100%;
  }

  .template-live-gallery figcaption,
  .template-action-gallery figcaption {
    position: absolute;
    right: .8rem;
    bottom: .8rem;
    border-radius: 999rem;
    padding: .35rem .65rem;
    background: color-mix(in srgb, var(--kp-reference-ink) 70%, transparent);
    color: var(--kp-reference-white);
    font-size: .78rem;
    font-weight: 700;
  }

  .template-live-intro h2,
  .template-section h2,
  .template-section-copy h2,
  .template-inline-cta h2 {
    color: var(--kp-reference-ink);
    font-family: var(--kp-font-heading);
    font-size: clamp(2.4rem, 5vw, var(--kp-reference-heading-lg));
    font-weight: 700;
    line-height: 1;
  }

  .template-live-intro p,
  .template-section__lead,
  .template-feature-grid p,
  .template-scenario-grid p,
  .template-section-copy span,
  .template-check-list,
  .template-order-list,
  .template-facts-grid dd,
  .template-inline-cta p,
  .template-ai-summary p {
    color: var(--kp-reference-muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .template-facts-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .9rem;
  }

  .template-facts-grid div,
  .template-check-list li,
  .template-order-list li,
  .template-inline-cta {
    border-radius: 1.15rem;
    background: color-mix(in srgb, var(--kp-reference-white) 84%, transparent);
  }

  .template-facts-grid div {
    display: grid;
    gap: .4rem;
    padding: 1.1rem;
  }

  .template-inline-cta {
    grid-template-columns: minmax(0, .7fr) auto;
