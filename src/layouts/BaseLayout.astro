---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/typography.css';
import SeoHead from '../components/layout/SeoHead.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, canonical, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <SeoHead {title} {description} {canonical} {noindex} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
