    "massPageGeneration": false,
    "claudeMayChangeDesign": false,
    "hermesMapsFieldsWithoutReinterpretingDesign": true,
    "reviewOnlyUntilOwnerApproval": true,
    "noHiddenCrawlerOnlySeoText": true
