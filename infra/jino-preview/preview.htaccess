RewriteEngine On
RewriteRule ^api/leads(?:/status|/)?$ bridge.php [END]
RewriteRule ^sitemap-index\.xml$ sitemap.xml [END]
RewriteRule ^test-blok/?$ / [R=302,END]
RewriteRule ^ - [END]
Options -Indexes
ErrorDocument 404 /404.html
<FilesMatch "(?i)\.(zip|bak|log)$">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, nofollow"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Cache-Control "no-store"
Header always set Content-Security-Policy "default-src 'self'; frame-src https://kinescope.io; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
</IfModule>
