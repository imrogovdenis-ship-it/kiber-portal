---
import type { RobotRecord } from '../../lib/robots';
import { getGalleryImages } from '../../lib/robots';
interface Props { robot: RobotRecord }
const { robot } = Astro.props;
const images = getGalleryImages(robot)
  .filter((image) => image.src && (image.alt || image.caption))
  .slice(0, 10);
const modelName = robot.modelName || robot.name;
---
{images.length > 0 && (
  <section class="section robot-live-gallery" id="gallery">
    <div class="container">
      <div class="robot-live-gallery__topline">
        <h2>Робот {modelName} в действии</h2>
      </div>
      <div class="robot-live-gallery__rail" aria-label={`Фото ${modelName}`}>
        {images.map((image) => (
          <figure class="robot-live-gallery__item">
            <img src={image.src} alt={image.alt} loading="lazy" />
            {image.caption && <figcaption>{image.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
