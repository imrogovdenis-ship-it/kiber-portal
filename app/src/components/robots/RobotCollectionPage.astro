---
import type { RobotRecord } from '../../lib/robots';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RobotCard from '../robots/RobotCard.astro';
import CtaLink from '../site/CtaLink.astro';
interface Props {
  title: string;
  description: string;
  h1: string;
  sourceUrl: string;
  robots: RobotRecord[];
  intro?: string;
  primaryKeyword?: string;
}
const { title, description, h1, sourceUrl, robots, intro = description, primaryKeyword = '' } = Astro.props;
const heroImage = robots[0]?.seo.ogImage || '/images/tild3761-3963-4036-b934-653463666435__photo.jpg';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: h1,
    description,
    url: sourceUrl,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: robots.length,
      itemListElement: robots.map((robot, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'Service',
          name: robot.page.h1,
          url: robot.page.url,
          image: robot.seo.ogImage,
        },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: '/' },
      { '@type': 'ListItem', position: 2, name: h1, item: sourceUrl },
    ],
  },
];
---
<BaseLayout title={title} description={description} sourceUrl={sourceUrl} ogTitle={title} ogDescription={description} ogImage={heroImage} jsonLd={jsonLd}>
  <main>
    <section class="collection-live-hero" style={`--collection-hero-image:url('${heroImage}')`}>
      <div class="container collection-live-hero__inner">
        <span>Подборка роботов</span>
        <h1>{h1}</h1>
        <p>{intro}</p>
        <div class="hero-actions">
          <CtaLink href="#collection-catalog" event="collection_catalog_click" source="collection_hero" pageType="collection" placement="hero">Смотреть роботов</CtaLink>
          <CtaLink class="btn btn-secondary" href="#social" event="collection_question_click" source="collection_hero" pageType="collection" placement="hero">Задать вопрос</CtaLink>
        </div>
      </div>
    </section>
    <section class="section collection-live-intro">
      <div class="container collection-live-intro__grid">
        <div>
          <span class="robot-live-section__number">01 — ПОДБОРКА</span>
          <h2>Какие роботы подходят под задачу?</h2>
        </div>
        <p>{primaryKeyword ? `Страница собрана под запрос «${primaryKeyword}»: показываем подходящие модели, сценарии применения и быстрый переход к заявке.` : 'Страница помогает быстро сравнить подходящие модели и перейти к конкретной карточке робота.'}</p>
      </div>
    </section>
    <section class="section collection-live-catalog" id="collection-catalog">
      <div class="container">
        <div class="robot-live-heading collection-live-catalog__heading">
          <span>02 — КАТАЛОГ</span>
          <h2>{robots.length} моделей в подборке</h2>
          <p>Карточки собраны из единого robot/product source-of-truth: медиа, цены, SEO и связи берутся из одной модели.</p>
        </div>
        <div class="grid robot-card-grid collection-live-catalog__grid">
          {robots.map((robot) => <RobotCard robot={robot} />)}
        </div>
      </div>
    </section>
    <section class="robot-live-cta-strip collection-live-cta">
      <div class="container robot-live-cta-strip__inner">
        <h2>Подберём робота под формат мероприятия</h2>
        <div class="robot-live-cta-strip__actions">
          <p>Расскажите дату, площадку и сценарий — менеджер предложит подходящие модели.</p>
          <CtaLink href="#social" event="collection_cta_click" source="collection_footer_cta" pageType="collection" placement="footer">Написать нам</CtaLink>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
