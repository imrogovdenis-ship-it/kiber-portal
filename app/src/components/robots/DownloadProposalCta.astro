---
import type { RobotRecord } from '../../lib/robots';
import CtaLink from '../site/CtaLink.astro';
interface Props { robot: RobotRecord }
const { robot } = Astro.props;
const facts = (robot.contentFacts ?? {}) as { venueRequirements?: Array<{ text: string }> };
const goshaText = facts.venueRequirements?.[3]?.text
  || `Выбрать дату, состыковать её с площадкой и придумать программу под ваш формат помогут менеджеры КИБЕР ПОРТАЛ. Напишите нам — и ${robot.modelName || robot.name} приедет к вам во всеоружии.`;
---
<section class="section robot-live-gosha">
  <div class="container home-gosha__wrap">
    <div class="home-gosha__bubble robot-live-gosha__bubble">
      <img class="home-gosha__avatar" src="/images/tild3632-3236-4238-b335-623531393036__hi.png" alt="Кибер Гоша — цифровой помощник КИБЕР ПОРТАЛ" loading="lazy" />
      <div class="home-gosha__copy">
        <p class="home-gosha__text">Скажу честно, как робот человеку: {goshaText}</p>
        <div class="home-gosha__meta">
          <strong>Кибер Гоша</strong>
          <span>Ваш цифровой помощник</span>
        </div>
      </div>
      <CtaLink class="btn robot-live-gosha__cta" href="#social" event="proposal_cta_click" source="robot_gosha" pageType="robot" robotSlug={robot.slug} robotName={robot.name} placement="gosha">Написать менеджеру</CtaLink>
    </div>
  </div>
</section>
