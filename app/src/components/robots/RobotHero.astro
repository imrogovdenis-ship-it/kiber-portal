---
import type { RobotRecord } from '../../lib/robots';
import { getHeroImage } from '../../lib/robots';
import CtaLink from '../site/CtaLink.astro';
interface Props { robot: RobotRecord }
const { robot } = Astro.props;
const hero = getHeroImage(robot);
---
<section class="robot-hero robot-hero--live" style={hero ? `--robot-hero-image: url('${hero.src}')` : undefined}>
  <div class="container robot-hero__grid">
    <div class="robot-hero__copy">
      <h1>{robot.page.h1}</h1>
      <div class="hero-actions">
        <CtaLink href="#lead" event="cta_click_quote" source="robot_hero" pageType="robot" robotSlug={robot.slug} robotName={robot.name} placement="hero">Оставить заявку</CtaLink>
        <CtaLink class="btn btn-secondary" href="#social" event="cta_click_question" source="robot_hero" pageType="robot" robotSlug={robot.slug} robotName={robot.name} placement="hero">Задать вопрос</CtaLink>
      </div>
    </div>
  </div>
</section>
