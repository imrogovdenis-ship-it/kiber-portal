---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaLink from '../../components/site/CtaLink.astro';

const articles = (await getCollection('blog')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'ru'));
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Блог Кибер Гоши',
    description: 'Статьи про роботов для мероприятий, сценарии аренды и идеи интерактива.',
    url: '/articles',
    blogPost: articles.map((article) => ({
      '@type': 'BlogPosting',
      headline: article.data.h1 || article.data.title,
      description: article.data.description,
      url: article.data.sourceUrl,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: '/' },
      { '@type': 'ListItem', position: 2, name: 'Блог Кибер Гоши', item: '/articles' },
    ],
  },
];
---
<BaseLayout title="Блог Кибер Гоши | КИБЕР ПОРТАЛ" description="Статьи Кибер Гоши про роботов для мероприятий: сценарии, идеи, сравнения моделей и практические подборки." sourceUrl="/articles" ogImage="/images/kiber-gosha-yoga-red-ushanka.jpg" jsonLd={jsonLd}>
  <main>
    <section class="content-live-hero content-live-hero--gosha">
      <div class="container content-live-hero__inner">
        <span>Блог Кибер Гоши</span>
        <h1>Идеи, сценарии и сравнения роботов</h1>
        <p>Практические материалы: где робот создаёт вау-эффект, какую модель выбрать и как встроить интерактив в мероприятие.</p>
        <div class="hero-actions">
          <CtaLink href="#article-feed" event="articles_feed_click" source="articles_hero" pageType="article_index" placement="hero">Смотреть статьи</CtaLink>
          <CtaLink class="btn btn-secondary" href="#social" event="articles_question_click" source="articles_hero" pageType="article_index" placement="hero">Задать вопрос</CtaLink>
        </div>
      </div>
    </section>
    <section class="section content-live-feed" id="article-feed">
      <div class="container">
        <div class="robot-live-heading">
          <span>01 — СТАТЬИ</span>
          <h2>{articles.length} материалов в блоге</h2>
          <p>Каждая статья сохраняет исходный URL и ведёт к коммерческим страницам: карточкам роботов, подборкам и заявке.</p>
        </div>
        <div class="content-live-card-grid">
          {articles.map((article) => (
            <article class="content-live-card">
              <span>{article.data.sourceUrl}</span>
              <h3><a href={article.data.sourceUrl}>{article.data.h1 || article.data.title}</a></h3>
              <p>{article.data.description}</p>
              <a class="btn btn-secondary" href={article.data.sourceUrl}>Читать</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
