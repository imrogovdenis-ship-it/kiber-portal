---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaLink from '../../components/site/CtaLink.astro';

type NewsEntry = Awaited<ReturnType<typeof getCollection<'news'>>>[number];

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news
    .filter((entry) => !entry.data.draft && ['editor-approved', 'published-preview', 'published-production'].includes(entry.data.status))
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: NewsEntry };
const { Content } = await render(entry);
const title = entry.data.title;
const description = entry.data.description;
const h1 = entry.data.h1 || title;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: h1,
    description,
    datePublished: entry.data.publishedAt,
    dateModified: entry.data.updatedAt || entry.data.publishedAt,
    url: entry.data.sourceUrl,
    author: { '@type': 'Organization', name: 'КИБЕР ПОРТАЛ' },
    publisher: { '@type': 'Organization', name: 'КИБЕР ПОРТАЛ' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: '/' },
      { '@type': 'ListItem', position: 2, name: 'Новости', item: '/news' },
      { '@type': 'ListItem', position: 3, name: h1, item: entry.data.sourceUrl },
    ],
  },
];
---
<BaseLayout title={title} description={description} sourceUrl={entry.data.sourceUrl} ogImage="/images/kiber-gosha-yoga-red-ushanka.jpg" jsonLd={jsonLd}>
  <main>
    <section class="article-live-hero article-live-hero--news">
      <div class="container article-live-hero__inner">
        <span>Новости · {entry.data.publishedAt}</span>
        <h1>{h1}</h1>
        {description && <p>{description}</p>}
        <div class="hero-actions">
          <CtaLink href="#article-body" event="news_read_click" source="news_detail_hero" pageType="news" placement="hero">Читать новость</CtaLink>
          <CtaLink class="btn btn-secondary" href="#social" event="news_question_click" source="news_detail_hero" pageType="news" placement="hero">Обсудить робота</CtaLink>
        </div>
      </div>
    </section>
    <section class="section article-live" id="article-body">
      <div class="container article-live__layout">
        <article class="article-live__body">
          <Content />
          <div class="article-live__note">
            <strong>Редакционный статус:</strong> {entry.data.status}<br />
            <strong>Основной SEO-запрос:</strong> {entry.data.seo.primaryQuery}<br />
            <span>Источники хранятся во внутреннем редакционном логе и frontmatter.</span>
          </div>
        </article>
        <aside class="article-live__aside">
          <strong>Новости</strong>
          <a href="/news">Все новости</a>
          <a href="/articles">Блог Кибер Гоши</a>
          <a href="/compilations">Подборки</a>
          <a href="/roboty-gumanoidy">Гуманоиды</a>
          <p>Новость должна вести к роботу, подборке или заявке — не оставляем пользователя в тупике.</p>
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>
