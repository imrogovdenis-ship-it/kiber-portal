---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import CtaLink from '../../components/site/CtaLink.astro';

const news = (await getCollection('news'))
  .filter((item) => !item.data.draft && ['editor-approved', 'published-preview', 'published-production'].includes(item.data.status))
  .sort((a, b) => (b.data.publishedAt || '').localeCompare(a.data.publishedAt || ''));
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Новости про роботов',
    description: 'Новости про роботов, гуманоидов, робособак, сервисных роботов, искусственный интеллект и обучение роботов.',
    url: '/news',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: news.length,
      itemListElement: news.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'NewsArticle',
          headline: item.data.h1 || item.data.title,
          description: item.data.description,
          datePublished: item.data.publishedAt,
          url: item.data.sourceUrl,
        },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: '/' },
      { '@type': 'ListItem', position: 2, name: 'Новости', item: '/news' },
    ],
  },
];
---
<BaseLayout title="Новости про роботов | КИБЕР ПОРТАЛ" description="Новости про роботов, гуманоидов, робособак, сервисных роботов, искусственный интеллект и обучение роботов." sourceUrl="/news" ogImage="/images/kiber-gosha-yoga-red-ushanka.jpg" jsonLd={jsonLd}>
  <main>
    <section class="content-live-hero content-live-hero--news">
      <div class="container content-live-hero__inner">
        <span>Новости</span>
        <h1>Роботы, AI и события индустрии</h1>
        <p>Редакционная лента для инфотрафика и узнаваемости: новости связываются с роботами, статьями и коммерческими подборками.</p>
        <div class="hero-actions">
          <CtaLink href="#news-feed" event="news_feed_click" source="news_hero" pageType="news_index" placement="hero">Смотреть новости</CtaLink>
          <CtaLink class="btn btn-secondary" href="#social" event="news_question_click" source="news_hero" pageType="news_index" placement="hero">Предложить тему</CtaLink>
        </div>
      </div>
    </section>
    <section class="section content-live-feed" id="news-feed">
      <div class="container">
        <div class="robot-live-heading">
          <span>01 — ЛЕНТА</span>
          <h2>{news.length > 0 ? `${news.length} новостей` : 'Новости готовятся к публикации'}</h2>
          <p>Раздел готов к публикации проверенных материалов: у новости есть источник, дата, SEO-запросы и переходы к коммерческим страницам.</p>
        </div>
        {news.length === 0 ? (
          <div class="content-live-card content-live-card--empty">
            <span>preview</span>
            <h3>Пока нет опубликованных preview-новостей</h3>
            <p>Черновики проходят редакторскую проверку. После статуса `editor-approved` материал появится здесь автоматически.</p>
          </div>
        ) : (
          <div class="content-live-card-grid">
            {news.map((item) => (
              <article class="content-live-card">
                <span>{item.data.publishedAt} · {item.data.seo.intent}</span>
                <h3><a href={item.data.sourceUrl}>{item.data.h1 || item.data.title}</a></h3>
                <p>{item.data.description}</p>
                {item.data.robotTopics?.length > 0 && <p class="source-note">Темы: {item.data.robotTopics.join(', ')}</p>}
                <a class="btn btn-secondary" href={item.data.sourceUrl}>Открыть</a>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
  </main>
</BaseLayout>
