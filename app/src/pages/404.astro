---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaLink from '../components/site/CtaLink.astro';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Страница не найдена',
  url: 'https://www.kiber-portal.ru/404',
  isPartOf: {
    '@type': 'WebSite',
    name: 'КИБЕР ПОРТАЛ',
    url: 'https://www.kiber-portal.ru/',
  },
};
---
<BaseLayout title="Страница не найдена | КИБЕР ПОРТАЛ" description="Страница не найдена. Вернитесь в каталог роботов, подборки или свяжитесь с КИБЕР ПОРТАЛОМ." sourceUrl="/404" robots="noindex,nofollow" ogImage="/images/kiber-gosha-yoga-red-ushanka.jpg" jsonLd={jsonLd}>
  <main>
    <section class="content-live-hero not-found-live-hero">
      <div class="container content-live-hero__inner">
        <span>404</span>
        <h1>Такой страницы нет</h1>
        <p>Кибер Гоша не нашёл этот маршрут. Можно вернуться в каталог, посмотреть подборки или написать нам — подберём робота под задачу.</p>
        <div class="hero-actions">
          <CtaLink href="/" event="not_found_home_click" source="404" pageType="system" placement="hero">На главную</CtaLink>
          <CtaLink class="btn btn-secondary" href="/arenda-robotov-na-meropriyatie" event="not_found_catalog_click" source="404" pageType="system" placement="hero">К подборкам</CtaLink>
        </div>
      </div>
    </section>
    <section class="section content-live-section">
      <div class="container content-live-cta">
        <div>
          <span class="content-live-eyebrow">НУЖНА ПОМОЩЬ?</span>
          <h2>Напишите нам — найдём нужного робота</h2>
          <p>Если страница потерялась после переноса сайта, мы сохраним нужный сценарий и подскажем актуальную карточку.</p>
        </div>
        <CtaLink href="#social" event="not_found_contact_click" source="404" pageType="system" placement="body">Написать нам</CtaLink>
      </div>
    </section>
  </main>
</BaseLayout>
