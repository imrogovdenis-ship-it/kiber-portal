---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RobotCard from '../../components/robots/RobotCard.astro';
import CtaLink from '../../components/site/CtaLink.astro';
import { getRobots } from '../../lib/robots';

const robots = getRobots();
const groups = [
  {
    title: 'Роботы-гуманоиды',
    href: '/roboty-gumanoidy',
    anchor: 'roboty-gumanoidy',
    description: 'Гуманоиды для сцены, стенда, приветствия гостей и вау-эффекта.',
    robots: robots.filter((robot) => robot.related?.collections?.includes('roboty-gumanoidy')).slice(0, 4),
  },
  {
    title: 'Роботы-собаки',
    href: '/compilations#roboty-sobaki',
    anchor: 'roboty-sobaki',
    description: 'Робособаки для демонстраций, промо-зон и интерактива с гостями.',
    robots: robots.filter((robot) => robot.related?.collections?.includes('roboty-sobaki')).slice(0, 4),
  },
  {
    title: 'Сервисные роботы',
    href: '/compilations#servisnye-roboty',
    anchor: 'servisnye-roboty',
    description: 'Официанты, бармены, кофейни, промо-роботы и интерактивные ассистенты.',
    robots: robots.filter((robot) => robot.related?.collections?.includes('servisnye-roboty')).slice(0, 4),
  },
  {
    title: 'Интерактив и медиа',
    href: '/compilations#roboty-dlya-interaktiva',
    anchor: 'roboty-dlya-interaktiva',
    description: 'Роботы для рисования, фото/видео, игр и вовлекающих зон.',
    robots: robots.filter((robot) => robot.related?.collections?.includes('roboty-dlya-interaktiva')).slice(0, 4),
  },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Подборки роботов для мероприятий',
    description: 'Подборки роботов по сценариям: гуманоиды, роботы-собаки, сервисные роботы, медиа- и интерактивные решения.',
    url: '/compilations',
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: groups.map((group, index) => ({ '@type': 'ListItem', position: index + 1, name: group.title, url: group.href })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: '/' },
      { '@type': 'ListItem', position: 2, name: 'Подборки', item: '/compilations' },
    ],
  },
];
---
<BaseLayout title="Подборки роботов для мероприятий | КИБЕР ПОРТАЛ" description="Подборки роботов по сценариям: гуманоиды, роботы-собаки, сервисные роботы, медиа- и интерактивные решения." sourceUrl="/compilations" ogImage={robots[0]?.seo.ogImage} jsonLd={jsonLd}>
  <main>
    <section class="content-live-hero content-live-hero--compilations">
      <div class="container content-live-hero__inner">
        <span>Подборки</span>
        <h1>Роботы под сценарий мероприятия</h1>
        <p>Готовые группы моделей для выставок, промо-зон, welcome-зон, презентаций, корпоративов и интерактивных площадок.</p>
        <div class="hero-actions">
          <CtaLink href="#compilation-groups" event="compilations_feed_click" source="compilations_hero" pageType="compilations" placement="hero">Смотреть подборки</CtaLink>
          <CtaLink class="btn btn-secondary" href="#social" event="compilations_question_click" source="compilations_hero" pageType="compilations" placement="hero">Задать вопрос</CtaLink>
        </div>
      </div>
    </section>
    <section class="section content-live-feed" id="compilation-groups">
      <div class="container">
        <div class="robot-live-heading">
          <span>01 — ПОДБОРКИ</span>
          <h2>Сценарные группы роботов</h2>
          <p>Каждая подборка ведёт к карточкам роботов и помогает выбрать формат под задачу, а не просто посмотреть каталог.</p>
        </div>
        <div class="content-live-stack">
          {groups.map((group, index) => (
            <section class="content-live-group" id={group.anchor}>
              <div class="content-live-group__heading">
                <span>{String(index + 2).padStart(2, '0')} — {group.robots.length} МОДЕЛЕЙ</span>
                <h3><a href={group.href}>{group.title}</a></h3>
                <p>{group.description}</p>
              </div>
              <div class="grid robot-card-grid">
                {group.robots.map((robot) => <RobotCard robot={robot} />)}
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
