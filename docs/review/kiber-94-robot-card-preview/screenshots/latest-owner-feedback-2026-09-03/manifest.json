        "includedLengths": [
          {
            "length": 95,
            "text": "подберём сценарий использования робота под событие, аудиторию, площадку и нужный темп программы"
          },
          {
            "length": 90,
            "text": "привезём робота, подготовим площадку, проверим покрытие, проходы и технические ограничения"
          },
          {
            "length": 97,
            "text": "оператор КИБЕР ПОРТАЛА сопровождает программу на мероприятии и помогает роботу работать безопасно"
          },
          {
            "length": 90,
            "text": "заранее согласуем длительность, выходы робота, паузы, подзарядку и роль в сценарии события"
          }
        ],
        "orderLengths": [
          {
            "length": 97,
            "text": "Вы пишете нам, называете робота, дату, город, площадку и формат будущего мероприятия для расчёта."
          },
          {
            "length": 99,
            "text": "Менеджер уточняет площадку, аудиторию, сценарий, тайминг, ограничения и условия заезда для расчёта."
          },
          {
            "length": 92,
            "text": "Мы подтверждаем доступность, считаем стоимость и предлагаем безопасный формат работы робота."
          },
          {
            "length": 94,
            "text": "В день события привозим, настраиваем и сопровождаем робота на площадке до окончания программы."
          }
        ]
      }
